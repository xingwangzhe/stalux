{
    "installCommand": "bunx --bun bun@1.4.4 install --frozen-lockfile",
    "buildCommand": "bunx --bun bun@1.4.4 run build && bunx --bun bun@1.4.4 scripts/write-edgeone-routes.ts",
    "rewrites": [
        {
            "source": "/about/",
            "destination": "/about/index.html"
        },
        {
            "source": "/archives/",
            "destination": "/archives/index.html"
        },
        {
            "source": "/categories/",
            "destination": "/categories/index.html"
        },
        {
            "source": "/links/",
            "destination": "/links/index.html"
        },
        {
            "source": "/tags/",
            "destination": "/tags/index.html"
        },
        {
            "source": "/words/",
            "destination": "/words/index.html"
        },
        {
            "source": "/:path/",
            "destination": "/:path/index.html"
        },
        {
            "source": "/:path/:child/",
            "destination": "/:path/:child/index.html"
        }
    ]
}
