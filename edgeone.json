{
    "rewrites": [
        {
            "source": "/404",
            "destination": "/404.html"
        },
        {
            "source": "/404/",
            "destination": "/404.html"
        },
        {
            "source": "/categories/node.js/",
            "destination": "/categories/node.js/index.html"
        },
        {
            "source": "/categories/node.js",
            "destination": "/categories/node.js/index.html"
        },
        {
            "source": "/tags/node.js/",
            "destination": "/tags/node.js/index.html"
        },
        {
            "source": "/tags/node.js",
            "destination": "/tags/node.js/index.html"
        },
        {
            "source": "/tags/Three.js/",
            "destination": "/tags/Three.js/index.html"
        },
        {
            "source": "/tags/Three.js",
            "destination": "/tags/Three.js/index.html"
        },
        {
            "source": "/tags/d3.js/",
            "destination": "/tags/d3.js/index.html"
        },
        {
            "source": "/tags/d3.js",
            "destination": "/tags/d3.js/index.html"
        },
        {
            "source": "/archives",
            "destination": "/archives/index.html"
        },
        {
            "source": "/archives/",
            "destination": "/archives/index.html"
        },
        {
            "source": "/about",
            "destination": "/about/index.html"
        },
        {
            "source": "/links",
            "destination": "/links/index.html"
        },
        {
            "source": "/words",
            "destination": "/words/index.html"
        },
        {
            "source": "/tags",
            "destination": "/tags/index.html"
        },
        {
            "source": "/categories",
            "destination": "/categories/index.html"
        },
        {
            "source": "/posts/*.md",
            "destination": "/posts/:splat.md?raw=1"
        },
        {
            "source": "/tags/*.md",
            "destination": "/tags/:splat.md?raw=1"
        },
        {
            "source": "/categories/*.md",
            "destination": "/categories/:splat.md?raw=1"
        },
        {
            "source": "/posts/*",
            "destination": "/posts/:splat/index.html"
        },
        {
            "source": "/tags/*",
            "destination": "/tags/:splat/index.html"
        },
        {
            "source": "/categories/*",
            "destination": "/categories/:splat/index.html"
        }
    ],
    "installCommand": "bunx --bun bun@1.4.4 install --frozen-lockfile",
    "buildCommand": "bunx --bun bun@1.4.4 run build"
}
