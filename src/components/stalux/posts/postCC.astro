---
import "../../../styles/generated-article.css";
import { getCollection } from "astro:content";
import ccIcon from "@assets/cc-icon.svg?raw";

import { buildCCLink, buildCCName } from "@utils/cc";
import { createTranslator } from "@utils/i18n";

interface Props {
    title: string;
    author: string;
    url: string;
    cc?: string;
}

const configEntries = await getCollection("config");
const siteConfig = (configEntries.find((e) => e.id === "site")?.data ?? {}) as Record<
    string,
    unknown
>;
const { t } = createTranslator((siteConfig.lang as string) || "zh-CN");
const { title, author, url, cc = "CC-BY-NC-SA-4.0" } = Astro.props;

const licenseLink = buildCCLink(cc);
const licenseName = buildCCName(cc, t);
---

<div class="stalux-license-box">
    <div class="stalux-license-content">
        <p class="stalux-license-title">{title}</p>
        <p class="stalux-license-author">{t("post.author")}{author}</p>
        {url && (
            <p class="stalux-license-url">
                {t("post.articleLink")}
                <a href={url} target="_blank" rel="noopener noreferrer">
                    {url}
                </a>
            </p>
        )}
        <p class="stalux-license-license">
            {t("post.licensedUnder")}
            <a href={licenseLink} target="_blank" rel="noopener noreferrer">
                {licenseName}
            </a>{t("post.licenseSuffix")}
        </p>
    </div>

    <div class="stalux-license-watermark">
        <div class="stalux-license-icon" set:html={ccIcon} />
    </div>
</div>
