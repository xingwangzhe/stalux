---
import { type CollectionEntry, getCollection } from "astro:content";
import PostCard from "@components/stalux/posts/postCard.astro";

interface Props {
    posts?: CollectionEntry<"posts">[];
}

const props = Astro.props as Props;
// Allow callers to pass filtered posts to avoid re-fetching the full list.
const posts = props.posts ?? (await getCollection("posts", ({ data }) => !data.draft));
---

<!-- Modern Web Guidance (html): 文章列表是内容分组 => <section> + <ul>/<li>。 -->
<section
    data-stalux="postlist"
    class="stalux-post-list-container"
    data-stalux-motion-content
    data-stalux-motion-stage
>
    <ul class="post-list" data-stalux-reveal>
        {posts.map((post, index) => (
            <li data-stalux-reveal-item>
                <PostCard post={post} priority={index === 0} />
            </li>
        ))}
    </ul>
</section>
