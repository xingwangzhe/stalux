---
import { type CollectionEntry, getCollection } from "astro:content";
import PostCard from "@components/stalux/posts/postCard.astro";

interface Props {
    posts?: CollectionEntry<"posts">[];
}

const props = Astro.props as Props;
// Allow callers to pass filtered posts to avoid re-fetching the full list.
const posts = props.posts ?? (await getCollection("posts", ({ data }) => !data.draft));
---

<div data-stalux="postlist" class="stalux-post-list-container">
    <ul class="post-list">
        {posts.map((post, index) => (
            <li>
                <PostCard post={post} priority={index === 0} />
            </li>
        ))}
    </ul>
</div>
