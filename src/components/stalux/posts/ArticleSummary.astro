---
interface Props {
    description?: string;
    label: string;
}
const { description, label } = Astro.props;
const summary = description?.trim();
---

{summary && (
    <aside class="stalux-article-summary" aria-label={label}>
        <p class="stalux-article-summary-label">{label}</p>
        <p class="stalux-article-summary-text">{summary}</p>
    </aside>
)}

<style>
.stalux-article-summary {
    box-sizing: border-box;
    width: min(840px, 100%);
    margin: 0 auto 2rem;
    padding: 1.25rem 1.5rem;
    border: 1px solid var(--accent-30p);
    border-radius: 14px;
    background: var(--surface-glass);
    box-shadow: 0 4px 20px #0002;
    overflow-wrap: anywhere;
}
.stalux-article-summary-label {
    margin: 0 0 0.6rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--accent-90p);
    letter-spacing: 0.08em;
}
.stalux-article-summary-text {
    margin: 0;
    color: var(--white-85p);
    font-size: 1rem;
    line-height: 1.8;
}
@media (max-width: 480px) {
    .stalux-article-summary {
        padding: 1rem;
    }
}
</style>
