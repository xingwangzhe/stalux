---
import { getCollection } from "astro:content";
import Author from "@components/stalux/common/author.astro";
import style from "@styles/components/posts/postAuthor.module.css";
import { getAuthorData } from "@utils/config-utils";

const configEntries = await getCollection("config");
const authorConfig = getAuthorData(configEntries);

// 判断是否为文章页面
const isPostPage = Astro.url.pathname.includes("/posts/");
---

<aside class={style.sidebarContainer} style={isPostPage ? "margin-top: -3em;" : ""}>
    <div class={style.authorSection}>
        <div class={style.authorCard}>
            <Author iscolum />
            <p class={style.authorBio}>{authorConfig.bio}</p>
        </div>
    </div>
</aside>
