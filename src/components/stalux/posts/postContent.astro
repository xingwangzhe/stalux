---
import "../../../styles/generated-article.css";
import "../../../styles/generated-prose.css";
import "photoswipe/dist/photoswipe.css";

import { getCollection } from "astro:content";
import { getPromoteData, getSiteData } from "@utils/config-utils";
import { createTranslator } from "@utils/i18n";
import { toMachineDateTime } from "@utils/semantic-time";
import ArticleSummary from "./ArticleSummary.astro";

interface Props {
    postId?: string | number;
    title: string;
    description?: string;
    searchKeywords?: string[];
    transitionName?: string;
    titleTransitionName?: string;
    transitionScope?: "article" | "about";
    date?: string;
    updated?: string;
    readingMinutes?: number;
    wordCount?: number;
    hasImage?: boolean;
}

const props = Astro.props as Props;
const transitionPrefix = props.transitionScope === "about" ? "stalux-about" : "stalux-article";
const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const promoteConfig = getPromoteData(configEntries);
const { t } = createTranslator(siteConfig.lang || "zh-CN");
const timezone = siteConfig.timezone;

// 仅当开启 export_md 时，才展示“查看 Markdown 原文”按钮，并推导对应 .md 路径
// /about 等非文章页面固定不显示 Markdown 原文按钮
const isAboutPage = Astro.url.pathname.startsWith("/about");
const exportMd = Boolean(promoteConfig?.export_md) && !isAboutPage;
const mdSourceUrl = exportMd ? `${Astro.url.pathname.replace(/\/$/, "")}.md` : "";
---

<article
    class="stalux-article"
    data-stalux-motion-stage
    data-stalux-gallery={props.hasImage ? "true" : undefined}
>
    <!-- Article Header -->
    <header class="stalux-post-article-header" data-stalux-motion-region>
        <h1
            class="stalux-post-title"
            data-stalux-motion-focus
            data-pagefind-body
            data-pagefind-meta="title"
        >
            {props.title}
        </h1>
        <div class="stalux-post-metadata">
            {props.date && (
                <time
                    class="stalux-post-meta-item"
                    datetime={timezone ? toMachineDateTime(props.date, timezone) : props.date}
                >
                    {t("post.publishTime")}
                    {props.date}
                </time>
            )}

            {props.updated && (
                <time
                    class="stalux-post-meta-item"
                    datetime={timezone ? toMachineDateTime(props.updated, timezone) : props.updated}
                >
                    {t("post.updateTime")}
                    {props.updated}
                </time>
            )}
        </div>
        <div class="stalux-post-page-stats">
            {(props.readingMinutes ?? 0) > 0 && (
                <span class="stalux-post-reading-time">
                    {t("post.readingTime")}
                    {props.readingMinutes && props.readingMinutes > 0
                        ? props.readingMinutes < 1
                            ? t("common.lessThanOneMinute")
                            : t("common.minute", { n: props.readingMinutes })
                        : ""}
                </span>
            )}
            {(props.wordCount ?? 0) > 0 && (
                <span class="wordCount">
                    {t("post.wordCount")}
                    {props.wordCount}
                </span>
            )}
            <span id="vercount_container_page_pv">
                {t("post.viewCount")}
                <span id="vercount_value_page_pv">Loading...</span>
            </span>
        </div>
        {exportMd && (
            <div class="stalux-post-source-link-row">
                <a
                    class="stalux-post-source-link"
                    href={mdSourceUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                >
                    {t("post.viewSource")}
                </a>
            </div>
        )}
    </header>

    <ArticleSummary
        description={props.description}
        label={t("post.summary")}
        transitionName={`${transitionPrefix}-summary`}
    />

    <span
        hidden
        data-pagefind-body
        data-stalux-search-keywords
        data-pagefind-index-attrs="data-search-keywords"
        data-search-keywords={(props.searchKeywords ?? []).join(" ")}
    ></span>

    <!-- Article Body -->
    <section
        class="stalux-post-body stalux-prose"
        data-stalux-motion-content
        data-pagefind-body
        data-stalux-post-id={props.postId === undefined ? undefined : String(props.postId)}
        data-pagefind-filter={props.postId === undefined ? undefined : "post[data-stalux-post-id]"}
    >
        <slot />
    </section>
</article>

<script>
import "../../../scripts/photoswipe";
import { mountCodeAccessibility } from "../../../scripts/code-accessibility";
import { registerPageLifecycle } from "../../../scripts/page-runtime";

registerPageLifecycle("code-accessibility", mountCodeAccessibility);
</script>
