---
import { fade } from "astro:transitions";
import style from "@styles/components/posts/postTaxonomy.module.css";

interface Props {
    categories?: string[];
    title?: string;
}

const { categories = [], title = "分类" } = Astro.props;

// 定义分类内容的过渡动画 - 平滑褶皱效果
const categoryContentAnimation = {
    old: {
        name: "fadeScale",
        duration: "0.3s",
        easing: "ease-out",
    },
    new: {
        name: "fadeScale",
        duration: "0.3s",
        easing: "ease-out",
    },
};
---

<div class={style.container} transition:name="categories-container">
    {categories.length > 0 && <h3 class={style.title}>{title}</h3>}
    {
        categories.length > 0 ? (
            <div
                class={style.listColumn}
                transition:name="categories-content"
                transition:animate={fade({ duration: "0.3s" })}
            >
                {categories.map((category) => (
                    <a
                        href={`/categories/${category}/`}
                        class={`${style.itemColumn} a-none`}
                    >
                        {category}
                    </a>
                ))}
            </div>
        ) : (
            <div class={style.empty}>暂无分类</div>
        )
    }
</div>

<style is:global>
    @keyframes fadeScale {
        from { opacity: 0; transform: scale(0.95); }
        to   { opacity: 1; transform: scale(1); }
    }
</style>
