---
import "../../../styles/generated-article.css";
import { getCollection } from "astro:content";

import { createTranslator } from "@utils/i18n";

interface Props {
    prev?: { url: string; title: string };
    next?: { url: string; title: string };
}

const props = Astro.props as Props;
const configEntries = await getCollection("config");
const siteConfig = (configEntries.find((e) => e.id === "site")?.data ?? {}) as Record<
    string,
    unknown
>;
const { t } = createTranslator((siteConfig.lang as string) || "zh-CN");
---

{(props.prev || props.next) && (
    <nav
        data-stalux-module="post-navigation"
        class="stalux-pagination"
        aria-label={t("post.navigation")}
    >
        <!-- Modern Web Guidance (html): 上一篇/下一篇是一组导航条目 => <ul>/<li>；
             方向标签与标题是成对文字 => <p> 承载，不再用无语义 <div> 包裹。 -->
        <ul class="stalux-pagination-inner">
            <li class="stalux-pagination-item">
                {props.prev ? (
                    <a
                        href={props.prev.url}
                        data-stalux-motion="previous"
                        class="stalux-pagination-link stalux-pagination-prev-post"
                        rel="prev"
                        data-astro-prefetch
                    >
                        <span class="stalux-pagination-arrow">
                            <svg
                                aria-hidden="true"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                width="24"
                                height="24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M19 12H5M12 19l-7-7 7-7" />
                            </svg>
                        </span>
                        <p class="stalux-pagination-content">
                            <span class="stalux-pagination-label">{t("post.prevPost")}</span>
                            <span class="stalux-pagination-title">{props.prev.title}</span>
                        </p>
                    </a>
                ) : (
                    <span class="stalux-pagination-link stalux-pagination-prev-post stalux-pagination-disabled">
                        <span class="stalux-pagination-arrow">
                            <svg
                                aria-hidden="true"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                width="24"
                                height="24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M19 12H5M12 19l-7-7 7-7" />
                            </svg>
                        </span>
                        <p class="stalux-pagination-content">
                            <span class="stalux-pagination-label">{t("post.prevPost")}</span>
                            <span class="stalux-pagination-title">{t("post.noPrev")}</span>
                        </p>
                    </span>
                )}
            </li>

            <li class="stalux-pagination-item">
                {props.next ? (
                    <a
                        href={props.next.url}
                        data-stalux-motion="next"
                        class="stalux-pagination-link stalux-pagination-next-post"
                        rel="next"
                        data-astro-prefetch
                    >
                        <p class="stalux-pagination-content">
                            <span class="stalux-pagination-label">{t("post.nextPost")}</span>
                            <span class="stalux-pagination-title">{props.next.title}</span>
                        </p>
                        <span class="stalux-pagination-arrow">
                            <svg
                                aria-hidden="true"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                width="24"
                                height="24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M5 12h14M12 5l7 7-7 7" />
                            </svg>
                        </span>
                    </a>
                ) : (
                    <span class="stalux-pagination-link stalux-pagination-next-post stalux-pagination-disabled">
                        <p class="stalux-pagination-content">
                            <span class="stalux-pagination-label">{t("post.nextPost")}</span>
                            <span class="stalux-pagination-title">{t("post.noNext")}</span>
                        </p>
                        <span class="stalux-pagination-arrow">
                            <svg
                                aria-hidden="true"
                                xmlns="http://www.w3.org/2000/svg"
                                viewBox="0 0 24 24"
                                width="24"
                                height="24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M5 12h14M12 5l7 7-7 7" />
                            </svg>
                        </span>
                    </span>
                )}
            </li>
        </ul>
    </nav>
)}
