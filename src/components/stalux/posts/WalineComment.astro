---
import { getCollection } from "astro:content";
import { getSiteData } from "@utils/config-utils";
import { createTranslator } from "@utils/i18n";
import type { WalineComponentProps } from "@utils/waline";

interface Props extends WalineComponentProps {
    path?: string;
    title?: string;
}

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const { t } = createTranslator(siteConfig.lang || "zh-CN");

// 为客户端脚本准备配置对象：先给默认配置，再用实际传入的 props 覆盖。
// 这样避免把同一组字段在 Props 接口、解构默认值、init 调用里各写一遍。
const walineConfig = {
    path: typeof window !== "undefined" ? window.location.pathname : "",
    title: "",
    serverURL: "",
    lang: (siteConfig.lang as string) || "zh-CN",
    locale: undefined,
    emoji: false,
    requiredMeta: [] as string[],
    reaction: true,
    meta: ["nick", "mail", "link"] as string[],
    wordLimit: 200,
    pageSize: 10,
    login: "enable",
    recaptchaV3Key: "",
    turnstileKey: "",
    dark: true,
    noCopyright: false,
    commentSorting: "latest",
    imageUploader: undefined,
    highlighter: undefined,
    texRenderer: undefined,
    search: undefined,
    ...Astro.props,
};
---

{walineConfig.serverURL && (
    <section
        id="waline-container"
        class="waline-comment-container"
        aria-label={t("comment.title")}
        data-waline-config={
            // base64 可逆混淆（非加密，仅避免 SSR 注入/转义问题）
            btoa(
                Array.from(new TextEncoder().encode(JSON.stringify(walineConfig)), (byte) =>
                    String.fromCharCode(byte),
                ).join(""),
            )
        }
    >
        <h2 class="waline-comment-title">{t("comment.title")}</h2>
        <div id="waline-comment" class="waline-comment" data-nosnippet />
        <div class="comments-seo-notice" style="display:none">
            {t("comment.disclaimer")}
        </div>
    </section>
)}

<script src="../../../scripts/waline.ts"></script>
