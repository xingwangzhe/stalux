---
import style from "@styles/components/posts/postCard.module.css";
import { toMachineDateTime } from "@utils/semantic-time";
import { getCollection } from "astro:content";

import type { CollectionEntry } from "astro:content";
import { getSiteData, getAuthorData, getHeadData, getNavsData, getLinksData, getCommentData, getFooterData, getPromoteData, getTypetextsData, getMediaLinksData } from "@utils/config-utils";

interface Props {
    post: CollectionEntry<"posts">;
}

const post = Astro.props.post;
const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const timezone = siteConfig.timezone;

// 描述：使用文章自身的 desc
const description = post.data.desc || "";
---

<a href={`/posts/${post.data.abbrlink}/`} class={style.post + " a-none"} data-astro-prefetch="viewport">
    <div class={style.postContainer}>
        {
            post.data.cover && (
                <div class={style.postCover}>
                    <img src={post.data.cover} alt={post.data.title} loading="lazy" />
                </div>
            )
        }
        <h2 class={style.postTitle}>{post.data.title}</h2>
        <div class={style.time}>
            {
                post.data.date && (
                    <time
                        class={style.postDate}
                        datetime={timezone ? toMachineDateTime(post.data.date, timezone) : post.data.date}
                    >
                        {post.data.date}
                    </time>
                )
            }
            {
                post.data.updated && (
                    <time
                        class={style.postUpdated}
                        datetime={timezone ? toMachineDateTime(post.data.updated, timezone) : post.data.updated}
                    >
                        {post.data.updated}
                    </time>
                )
            }
        </div>
        <div class={style.postDescription}>{description}</div>
        <div class={style.postMeta}>
            <div class={style.postTags}>
                {
                    post.data.tags?.map((tag) => (
                        <a class="a-none" href={`/tags/${tag}`} data-astro-prefetch>
                            <div class={style.postTag}>{tag}</div>
                        </a>
                    ))
                }
            </div>
            <div class={style.postCategories}>
                {
                    post.data.categories?.map((category) => (
                        <a class="a-none" href={`/categories/${category}`} data-astro-prefetch>
                            <div class={style.postCategory}>{category}</div>
                        </a>
                    ))
                }
            </div>
        </div>
        <a
            href={`/posts/${post.data.abbrlink}`}
            class={style.readMore + " a-none"}
            data-astro-prefetch
        >
            Read More
        </a>
    </div>
</a>
