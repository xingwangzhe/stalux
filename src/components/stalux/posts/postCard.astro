---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";

import { getSiteData } from "@utils/config-utils";
import { toMachineDateTime } from "@utils/semantic-time";
import { getPostTitleTransitionName } from "@utils/view-transitions";

interface Props {
    post: CollectionEntry<"posts">;
    priority?: boolean;
}

const { post, priority = false } = Astro.props;
const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const timezone = siteConfig.timezone;

// 描述：使用文章自身的 desc
const description = post.data.desc || "";
---

<article class="block h-full text-inherit no-underline">
    <div class="stalux-post-card">
        {post.data.cover && (
    <a
        href={`/posts/${post.data.abbrlink}/`}
        class="a-none"
        data-astro-prefetch="viewport"
        aria-label={post.data.title}
    >
        <div class="stalux-card-post-cover">
            <img
                src={post.data.cover}
                alt={post.data.title}
                loading={priority ? "eager" : "lazy"}
                decoding="async"
                fetchpriority={priority ? "high" : "auto"}
                width="640"
                height="360"
            />
        </div>
    </a>
)}
        <h2
            class="stalux-card-post-title"
            transition:name={priority ? getPostTitleTransitionName(post.data.abbrlink) : undefined}
        >
            <a href={`/posts/${post.data.abbrlink}/`} class="a-none" data-astro-prefetch="viewport">
                {post.data.title}
            </a>
        </h2>
        <div class="stalux-card-time">
            {post.data.date && (
    <time
        class="stalux-card-post-date"
        datetime={timezone ? toMachineDateTime(post.data.date, timezone) : post.data.date}
    >
        {post.data.date}
    </time>
)}
            {post.data.updated && (
    <time
        class="stalux-card-post-updated"
        datetime={timezone ? toMachineDateTime(post.data.updated, timezone) : post.data.updated}
    >
        {post.data.updated}
    </time>
)}
        </div>
        <div class="stalux-card-post-description">{description}</div>
        <div class="stalux-card-post-meta">
            <div class="stalux-card-post-tags">
                {post.data.tags?.map((tag) => (
    <a class="a-none" href={`/tags/${tag}`} data-astro-prefetch>
        <span class="stalux-card-post-tag">{tag}</span>
    </a>
))}
            </div>
            <div class="stalux-card-post-categories">
                {post.data.categories?.map((category) => (
    <a class="a-none" href={`/categories/${category}`} data-astro-prefetch>
        <span class="stalux-card-post-category">{category}</span>
    </a>
))}
            </div>
        </div>
        <a
            href={`/posts/${post.data.abbrlink}/`}
            class="stalux-card-read-more a-none"
            data-astro-prefetch
        >
            Read More
        </a>
    </div>
</article>
