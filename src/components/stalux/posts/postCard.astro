---
import "../../../styles/generated-cards.css";
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";

import { getSiteData } from "@utils/config-utils";
import { toMachineDateTime } from "@utils/semantic-time";

interface Props {
    post: CollectionEntry<"posts">;
    priority?: boolean;
}

const { post, priority = false } = Astro.props;
const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const timezone = siteConfig.timezone;

// 描述：使用文章自身的 desc
const description = post.data.desc || "";
---

<!-- Modern Web Guidance (html): 卡片本身即 <article>；日期/描述是 <p>，标签与分类是 <ul>/<li>，
     尾部元数据用 <footer>。合并了旧的 shell>card 双层 div。 -->
<article
    data-stalux-control="post-card"
    class="stalux-post-card-shell stalux-post-card h-full text-inherit no-underline stalux-u-flex stalux-u-flex-col stalux-u-w-full stalux-u-min-w-0"
>
    {post.data.cover && (
        <a href={`/posts/${post.data.abbrlink}`} class="a-none" aria-label={post.data.title}>
            <span class="stalux-card-post-cover stalux-u-w-full stalux-u-min-w-0">
                <img
                    src={post.data.cover}
                    alt={post.data.title}
                    loading={priority ? "eager" : "lazy"}
                    decoding="async"
                    fetchpriority={priority ? "high" : "auto"}
                    width="640"
                    height="360"
                    data-stalux-cover
                />
            </span>
        </a>
    )}
    <h2 class="stalux-card-post-title">
        <a href={`/posts/${post.data.abbrlink}`} class="a-none">
            {post.data.title}
        </a>
    </h2>
    <p class="stalux-card-time stalux-u-items-center stalux-u-flex-wrap">
        {post.data.date && (
            <time
                class="stalux-card-post-date"
                datetime={timezone ? toMachineDateTime(post.data.date, timezone) : post.data.date}
            >
                {post.data.date}
            </time>
        )}
        {post.data.updated && (
            <time
                class="stalux-card-post-updated"
                datetime={
                    timezone ? toMachineDateTime(post.data.updated, timezone) : post.data.updated
                }
            >
                {post.data.updated}
            </time>
        )}
    </p>
    <p class="stalux-card-post-description stalux-u-min-w-0">{description}</p>
    <footer class="stalux-card-post-meta stalux-u-flex stalux-u-flex-col">
        <ul class="stalux-card-post-tags stalux-u-flex stalux-u-items-center stalux-u-flex-wrap">
            {post.data.tags?.map((tag) => (
                <li>
                    <a class="a-none" href={`/tags/${tag}`}>
                        <span class="stalux-card-post-tag">{tag}</span>
                    </a>
                </li>
            ))}
        </ul>
        <ul
            class="stalux-card-post-categories stalux-u-flex stalux-u-items-center stalux-u-flex-wrap"
        >
            {post.data.categories?.map((category) => (
                <li>
                    <a class="a-none" href={`/categories/${category}`}>
                        <span class="stalux-card-post-category">{category}</span>
                    </a>
                </li>
            ))}
        </ul>
    </footer>
    <a href={`/posts/${post.data.abbrlink}`} class="stalux-card-read-more a-none"> Read More </a>
</article>
