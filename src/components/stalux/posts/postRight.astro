---
import style from "@styles/components/posts/postSidebar.module.css";
import Date from "@components/stalux/common/date.astro";
import PostToc from "@components/stalux/posts/postToc.astro";
import PostTaxonomy from "@components/stalux/posts/PostTaxonomy.astro";
import { fade } from "astro:transitions";
interface Props {
    headings?: Array<{ depth: number; slug: string; text: string }>;
    tags?: string[];
    categories?: string[];
}

const { headings = [], tags = [], categories = [] } = Astro.props;
---

<aside
    class={style.sidebarRight}
    transition:name="right-sidebar"
    transition:animate={fade({ duration: "0.3s" })}
>
    <div class={style.sidebarContainer}>
        <Date />
    </div>
    <div class={style.sidebarContainer}>
        <PostToc headings={headings} />
    </div>
    <div class={style.sidebarContainer}>
        <PostTaxonomy kind="tag" items={tags} />
    </div>
    <div class={style.sidebarContainer}>
        <PostTaxonomy kind="category" items={categories} />
    </div>
</aside>
