---
import "../../../styles/generated-article.css";
import PostDate from "@components/stalux/common/date.astro";
import Weather from "@components/stalux/common/Weather.astro";
import PostTaxonomy from "@components/stalux/posts/PostTaxonomy.astro";
import PostToc from "@components/stalux/posts/postToc.astro";

interface Props {
    headings?: Array<{ depth: number; slug: string; text: string }>;
    tags?: string[];
    categories?: string[];
}

const { headings = [], tags = [], categories = [] } = Astro.props;
---

<!--
    The right column is a shell. Between two articles it keeps its node, its
    scroll position and its frame; only the three article-specific lists inside
    the slots are refreshed (see scripts/shell-hydration.ts). Rebuilding the whole
    aside on every article change made the reader watch the sidebar disappear and
    reflow, and it cost a full layout of the new article to do it.
-->
<aside class="stalux-sidebar-right" data-stalux-scroll-pane data-swup-persist="post-sidebar-right">
    <div
        class="stalux-sidebar-container"
        data-stalux-module="sidebar"
        data-swup-persist="post-sidebar-clock"
    >
        <PostDate />
        <Weather />
    </div>
    <div class="stalux-sidebar-container" data-stalux-shell-slot="toc">
        <PostToc headings={headings} />
    </div>
    <div class="stalux-sidebar-container" data-stalux-shell-slot="tags">
        <PostTaxonomy kind="tag" items={tags} />
    </div>
    <div class="stalux-sidebar-container" data-stalux-shell-slot="categories">
        <PostTaxonomy kind="category" items={categories} />
    </div>
</aside>
