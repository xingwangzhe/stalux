---
import "../../../styles/generated-article.css";
import { getCollection } from "astro:content";

import { getSiteData } from "@utils/config-utils";
import { createTranslator } from "@utils/i18n";

interface TocHeading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    headings?: TocHeading[];
    title?: string;
}

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const { t } = createTranslator(siteConfig.lang || "zh-CN");
const { headings = [], title = t("taxonomy.toc") } = Astro.props;

const tocItems = headings
    .filter((item) => item?.slug && item.text)
    .map((item) => ({
        ...item,
        depth: Math.min(Math.max(item.depth ?? 1, 1), 6),
    }));
---

<nav
    transition:name="toc-container"
    data-toc-active-class="stalux-toc-active"
    aria-label={t("taxonomy.toc")}
>
    <h3 class="stalux-toc-title">{title}</h3>
    {tocItems.length > 0 ? (
    <ul class="stalux-toc-list" transition:name="toc-content">
        {tocItems.map((heading) => (
            <li>
                <a
                    class={`stalux-toc-item ${({ 1: "stalux-toc-depth-1", 2: "stalux-toc-depth-2", 3: "stalux-toc-depth-3", 4: "stalux-toc-depth-4", 5: "stalux-toc-depth-5", 6: "stalux-toc-depth-6" } as Record<number, string>)[heading.depth] || ""} a-none`}
                    href={`#${heading.slug}`}
                    data-toc-link
                >
                    {heading.text}
                </a>
            </li>
        ))}
    </ul>
) : (
    <div class="stalux-toc-empty">{t("taxonomy.noToc")}</div>
)}
</nav>

<script src="../../../scripts/toc-scrollspy.ts"></script>
