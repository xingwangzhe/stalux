---
import { fade } from "astro:transitions";
import style from "@styles/components/posts/postToc.module.css";
import { getCollection } from "astro:content";
import { createTranslator } from "@utils/i18n";
import { initTocScrollSpy } from "@utils/toc-scrollspy";

interface TocHeading {
    depth: number;
    slug: string;
    text: string;
}

interface Props {
    headings?: TocHeading[];
    title?: string;
}

const stalux = (await getCollection("config"))[0]?.data ?? {};
const { t } = createTranslator(stalux.lang || "zh-CN");
const { headings = [], title = t("taxonomy.toc") } = Astro.props;

const tocItems = headings
    .filter((item) => item && item.slug && item.text)
    .map((item) => ({
        ...item,
        depth: Math.min(Math.max(item.depth ?? 1, 1), 6),
    }));

// 定义目录内容的过渡动画 - 平滑褶皱效果
const tocContentAnimation = {
    old: {
        name: "fadeSlideDown",
        duration: "0.3s",
        easing: "ease-out",
    },
    new: {
        name: "fadeSlideDown",
        duration: "0.3s",
        easing: "ease-out",
    },
};
---

<div transition:name="toc-container" data-toc-active-class={style.active}>
    <h3 class={style.title}>{title}</h3>
    {
        tocItems.length > 0 ? (
            <ul
                class={style.list}
                transition:name="toc-content"
                transition:animate={fade({ duration: "0.3s" })}
            >
                {tocItems.map((heading) => (
                    <li>
                        <a
                            class={`${style.item} ${style[`depth-${heading.depth}`] || ""} a-none`}
                            href={`#${heading.slug}`}
                            data-toc-link
                        >
                            {heading.text}
                        </a>
                    </li>
                ))}
            </ul>
        ) : (
            <div class={style.empty}>{t("taxonomy.noToc")}</div>
        )
    }
</div>

<script>
    import { initTocScrollSpy } from "@utils/toc-scrollspy";

    document.addEventListener("astro:page-load", () => {
        const container = document.querySelector("[data-toc-active-class]");
        const activeClass = container?.getAttribute("data-toc-active-class");
        if (activeClass) initTocScrollSpy(activeClass);
    });
</script>

<style is:global>
    @keyframes fadeSlideDown {
        from { opacity: 0; transform: translateY(-8px); }
        to   { opacity: 1; transform: translateY(0); }
    }
</style>
