---
import "../../../styles/generated-article.css";
import SocialMedia from "@components/stalux/links/socialMedia.astro";
import PostAuthor from "@components/stalux/posts/postAuthor.astro";
import RandomPost from "@components/stalux/posts/randomPost.astro";
---

<aside class="stalux-sidebar" data-swup-persist="post-sidebar-left">
    <!-- Modern Web Guidance (html): 侧栏分块用 <section>，不再用通用 <div>。 -->
    <section class="stalux-sidebar-container" data-stalux-module="sidebar">
        <PostAuthor />
    </section>
    <section class="stalux-sidebar-container">
        <SocialMedia />
    </section>
    <section class="stalux-sidebar-container">
        <RandomPost />
    </section>
</aside>
