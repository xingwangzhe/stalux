---
import PostAuthor from "@components/stalux/posts/postAuthor.astro";
import style from "@styles/components/posts/postSidebar.module.css";
import SocialMedia from "@components/stalux/links/socialMedia.astro";
import RandomPost from "@components/stalux/posts/randomPost.astro";
import { getSidebarAnimation } from "@utils/view-transitions";
// 判断是否为文章页面
const isPostPage = Astro.url.pathname.includes("/posts/");
---

<aside
    class={style.sidebar}
    transition:name="left-sidebar"
    transition:animate={getSidebarAnimation("left")}
>
    <PostAuthor />
    <div class={style.sidebarContainer}>
        <SocialMedia />
    </div>
    <div class={style.sidebarContainer}>
        <RandomPost />
    </div>

    <style>
        :global(.stalux-root) {
            --sidebar-width: 280px;
        }

        @media (max-width: 1200px) {
            :global(.stalux-root) {
                --sidebar-width: 240px;
            }
        }

        @media (max-width: 768px) {
            :global(.stalux-root) {
                --sidebar-width: 0;
            }
        }
    </style>
</aside>
