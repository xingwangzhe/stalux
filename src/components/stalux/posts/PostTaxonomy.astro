---
import "../../../styles/generated-article.css";
import { getCollection } from "astro:content";

import { getSiteData } from "@utils/config-utils";
import { createTranslator } from "@utils/i18n";

type Kind = "tag" | "category";

interface Props {
    kind: Kind;
    items?: string[];
    title?: string;
}

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const { t } = createTranslator(siteConfig.lang || "zh-CN");

const { kind, items = [], title } = Astro.props;

// 根据 kind 选择文案、路由前缀与样式类名，
// 避免 tag / category 两套几乎相同的组件互相复制。
const cfg = {
    tag: {
        prefix: "/tags/",
        heading: t("taxonomy.tag"),
        empty: t("taxonomy.noTags"),
        containerName: "tags-container",
        contentName: "tags-content",
        listClass: "stalux-post-taxonomy-list-wrap",
        itemClass: "stalux-post-taxonomy-item-pill",
    },
    category: {
        prefix: "/categories/",
        heading: t("taxonomy.category"),
        empty: t("taxonomy.noCategories"),
        containerName: "categories-container",
        contentName: "categories-content",
        listClass: "stalux-post-taxonomy-list-column",
        itemClass: "stalux-post-taxonomy-item-column",
    },
}[kind];
---

<nav
    class="stalux-post-taxonomy-container"
    transition:name={cfg.containerName}
    aria-label={title ?? cfg.heading}
>
    {items.length > 0 && <h3 class="stalux-post-taxonomy-title">{title ?? cfg.heading}</h3>}
    {items.length > 0 ? (
        <div class={cfg.listClass} transition:name={cfg.contentName}>
            {items.map((item) => (
                <a
                    href={`${cfg.prefix}${item}/`}
                    class={`${cfg.itemClass} a-none`}
                    data-astro-prefetch
                >
                    {item}
                </a>
            ))}
        </div>
    ) : (
        <div class="stalux-post-taxonomy-empty">{cfg.empty}</div>
    )}
</nav>
