---
import { Font } from "astro:assets";
import { getCollection } from "astro:content";
import { ClientRouter } from "astro:transitions";
import BingClarity from "@components/stalux/analytics/clarity.astro";
import GoogleAnalytics from "@components/stalux/analytics/google.astro";
import VerCount from "@components/stalux/common/verCount.astro";
import { SEO } from "astro-seo";
import packageJson from "../../../../package.json";
import "@styles/base/init.css";
import Umami from "@components/stalux/analytics/umami.astro";
import {
    getAuthorData,
    getHeadData,
    getMediaLinksData,
    getPromoteData,
    getSiteData,
} from "@utils/config-utils";
import { buildSeoDocument, type SeoPageInput } from "@utils/seo-document";

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const authorConfig = getAuthorData(configEntries);
const headConfig = getHeadData(configEntries);
const promoteConfig = getPromoteData(configEntries);
const mediaLinksConfig = getMediaLinksData(configEntries);

const seo = buildSeoDocument({
    site: siteConfig,
    author: authorConfig,
    mediaLinks: mediaLinksConfig?.items.map((item) => item.link) ?? [],
    page: Astro.props as SeoPageInput,
    pathname: Astro.url.pathname,
    protocol: Astro.url.protocol,
    exportMarkdown: Boolean(promoteConfig?.export_md),
    version: packageJson.version,
});
const ldJson = JSON.stringify(seo.schema).replace(/<\//g, "<\\/");
---

<head>
    <meta charset="utf-8">
    <ClientRouter fallback="animate" />
    <SEO
        title={seo.title}
        description={seo.description}
        canonical={seo.canonical}
        nofollow={seo.nofollow}
        noindex={seo.noindex}
        openGraph={seo.openGraph}
        twitter={seo.twitter}
        extend={{
            link: seo.links,
            meta: seo.meta,
    }}
    />
    <!-- 字体：由 Astro Fonts API 注入（--font-body 分片 / --font-code 可变字体），
       <Font /> 输出 @font-face 样式；浏览器按 unicode-range 按需下载正文分片 -->
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-code" />
    {(headConfig?.anyhead) && (
      <Fragment set:html={headConfig.anyhead} />
    )}
    {headConfig?.googleAnalyticsId && <GoogleAnalytics />}
    {headConfig?.bingClarityId && <BingClarity />}
    {headConfig?.umami?.id && headConfig?.umami?.url && <Umami />}
    <script is:inline type="application/ld+json" set:html={ldJson} />
    <VerCount />
</head>
