---
import { SEO } from "astro-seo";
import { ClientRouter } from "astro:transitions";
import { getCollection } from "astro:content";
import { Font } from "astro:assets";
import VerCount from "@components/stalux/common/verCount.astro";
import GoogleAnalytics from "@components/stalux/analytics/google.astro";
import BingClarity from "@components/stalux/analytics/clarity.astro";
	import "@styles/base/init.css";
	import Umami from "@components/stalux/analytics/umami.astro";
	// vite-plugin-font: 子集化中文字体，按 unicode-range 分包 + 按需加载
	// ?subsets 导入会生成 @font-face CSS 并自动注入页面
	import "@assets/fonts/LXGWWenKai-Regular.ttf?subsets";
	import { css as bodyFontCss, fontFamilyFallback } from "@assets/fonts/LXGWWenKai-Regular.ttf?subsets";

import { langToOpenGraphLocale } from "@utils/i18n";

const staluxCollection = await getCollection("config");
const stalux = staluxCollection[0];

// Twitter 卡片类型定义
export type TwitterCardType = "summary" | "summary_large_image";

// 最小必要 SEO 配置
export interface Props {
  title: string;
  description: string;
  cover?: string;
  isArticle?: boolean;
  date?: string;
  updated?: string;
  tags?: string[];
  categories?: string[];
  author?: string;
}

const props = Astro.props as Props;
const effectiveTitle = props.title;
const effectiveDescription = props.description;
const isArticle = props.isArticle ?? false;

const canonicalBase = stalux.data.canonical || stalux.data.url;
const canonicalUrl = canonicalBase
  ? new URL(Astro.url.pathname, canonicalBase).href
  : Astro.url.href;
const faviconPath = stalux.data.favicon || "/favicon.ico";
// 社交分享图片 / JSON-LD image 必须用绝对 URL
const baseImgUrl = canonicalBase.replace(/\/$/, "");
const toAbsolute = (p: string) => !p || p.startsWith("http") ? p : baseImgUrl + (p.startsWith("/") ? p : "/" + p);
const ogImagePath = toAbsolute(props.cover || stalux.data.author.avatar || faviconPath);
const isNotFoundPage =
  Astro.url.pathname === "/404" || Astro.url.pathname === "/404/";
const resolvedNoindex = Boolean(stalux.data.noindex) || isNotFoundPage;
const resolvedNofollow = Boolean(stalux.data.nofollow) || isNotFoundPage;

const openGraphConfig: Record<string, unknown> = {
  basic: {
    title: effectiveTitle,
    type: isArticle ? "article" : "website",
    image: ogImagePath,
    url: canonicalUrl,
  },
  optional: {
    description: effectiveDescription,
    locale: langToOpenGraphLocale(stalux.data.lang || "zh-CN"),
  },
  image: {
    url: ogImagePath,
    alt: effectiveTitle,
  },
};

// 文章页：添加 article Open Graph 标签
if (isArticle) {
  const article: Record<string, unknown> = {};
  if (props.date) article.publishedTime = props.date;
  if (props.updated) article.modifiedTime = props.updated;
  if (props.author) article.authors = [props.author];
  if (props.categories?.length) article.section = props.categories[0];
  if (props.tags?.length) article.tags = props.tags;
  openGraphConfig.article = article;
}

const twitterConfig = {
  card: "summary_large_image" as TwitterCardType,
  title: effectiveTitle,
  description: effectiveDescription,
  image: ogImagePath,
  imageAlt: effectiveTitle,
  ...(stalux.data.twitterSite ? { site: stalux.data.twitterSite } : {}),
};

const extendedLink = [
  { rel: "icon", href: faviconPath },
  {
    rel: "alternate",
    type: "application/rss+xml",
    title: stalux.data.title || "RSS Feed",
    href: "/rss.xml",
  },
];

	// 文章页：向爬虫暴露 Markdown 原文链接
	// 仅 /posts/xxx 文章页导出，/about 等页面固定不导出
	const exportMd = Boolean(stalux?.data?.export_md);
	const isPostPage = Astro.url.pathname.startsWith("/posts/") && Astro.url.pathname !== "/posts/";
	const isAboutPage = Astro.url.pathname.startsWith("/about");
	if (exportMd && isPostPage && !isAboutPage) {
  const mdHref = Astro.url.pathname.replace(/\/$/, "") + ".md";
  extendedLink.push({
    rel: "alternate",
    type: "text/markdown",
    title: "Markdown source",
    href: mdHref,
  });
}
const extendedMeta = [
  { name: "viewport", content: "width=device-width, initial-scale=1" },
  { name: "color-scheme", content: "dark" },
];

let schema: Record<string, unknown>;
if (isArticle) {
  schema = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: effectiveTitle,
    description: effectiveDescription,
    url: canonicalUrl,
    image: ogImagePath,
    datePublished: props.date,
    dateModified: props.updated || props.date,
    keywords: props.tags?.join(", "),
    author: props.author
      ? {
          "@type": "Person",
          name: props.author,
        }
      : undefined,
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": canonicalUrl,
    },
  };
} else {
  schema = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    url: canonicalUrl,
    name: effectiveTitle,
    description: effectiveDescription,
  };
}
const ldJson = JSON.stringify(schema, null, 2);
---

<head transition:persist-props>
  <meta charset="utf-8" />
  <ClientRouter />
  <SEO
    title={effectiveTitle}
    description={effectiveDescription}
    canonical={canonicalUrl}
    nofollow={resolvedNofollow}
    noindex={resolvedNoindex}
    openGraph={openGraphConfig}
    twitter={twitterConfig}
    extend={{
      link: extendedLink,
      meta: extendedMeta,
    }}
  />
  <style set:html={`:root{--font-body:${[bodyFontCss.family, fontFamilyFallback].filter(Boolean).join(",")},sans-serif}`} />
  <Font cssVariable="--font-code" />
  {
    stalux.data.head?.anyhead && (
      <Fragment set:html={stalux.data.head.anyhead} />
    )
  }
  {stalux.data.head?.googleAnalyticsId && <GoogleAnalytics />}
  {stalux.data.head?.bingClarityId && <BingClarity />}
  {stalux.data.head?.umami?.id && stalux.data.head?.umami?.url && <Umami />}
  <script type="application/ld+json" set:html={ldJson} />
  <VerCount />
</head>
