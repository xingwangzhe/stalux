---
import { Font } from "astro:assets";
import { getCollection } from "astro:content";
// Emit a stable asset even while the search component JavaScript stays lazy.
// The closed search dialog does not need to block the page's first paint.
import pagefindStyles from "virtual:stalux-search-style";
import BingClarity from "@components/stalux/analytics/clarity.astro";
import GoogleAnalytics from "@components/stalux/analytics/google.astro";
import Umami from "@components/stalux/analytics/umami.astro";
import VerCount from "@components/stalux/common/verCount.astro";
import {
    getAuthorData,
    getHeadData,
    getMediaLinksData,
    getPromoteData,
    getSiteData,
} from "@utils/config-utils";
import { toMachineDateTime } from "@utils/semantic-time";
import { buildSeoDocument, type SeoPageInput } from "@utils/seo-document";
import { SEO } from "astro-seo";
import packageJson from "../../../../package.json" with { type: "json" };

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const authorConfig = getAuthorData(configEntries);
const headConfig = getHeadData(configEntries);
const promoteConfig = getPromoteData(configEntries);
const mediaLinksConfig = getMediaLinksData(configEntries);

// og:article:published_time 与 JSON-LD datePublished 必须带站点时区偏移。
// 裸的 frontmatter 串（"2026-10-24 12:55:00"）会被消费方按自己的时区解释，
// 统一在这里转换为带偏移的机器时间，与 RSS pubDate、页面 <time> 保持一致。
const seoTimezone = siteConfig.timezone || "Asia/Shanghai";
const rawPage = Astro.props as SeoPageInput;
const seo = buildSeoDocument({
    site: siteConfig,
    author: authorConfig,
    mediaLinks: mediaLinksConfig?.items.map((item) => item.link) ?? [],
    page: {
        ...rawPage,
        date: rawPage.date ? toMachineDateTime(rawPage.date, seoTimezone) : rawPage.date,
        updated: rawPage.updated
            ? toMachineDateTime(rawPage.updated, seoTimezone)
            : rawPage.updated,
    },
    pathname: Astro.url.pathname,
    protocol: Astro.url.protocol,
    exportMarkdown: Boolean(promoteConfig?.export_md),
    version: packageJson.version,
});
const ldJson = JSON.stringify(seo.schema).replace(/<\//g, "<\\/");
---

<head>
    <meta charset="utf-8">
    <SEO
        title={seo.title}
        description={seo.description}
        canonical={seo.canonical}
        nofollow={seo.nofollow}
        noindex={seo.noindex}
        openGraph={seo.openGraph}
        twitter={seo.twitter}
        extend={{
            link: seo.links,
            meta: seo.meta,
        }}
    />
    {seo.fallbackImage && (
        <>
            <meta property="og:image" content={seo.fallbackImage} />
            <meta property="og:image:type" content="image/png" />
            <meta property="og:image:width" content="1200" />
            <meta property="og:image:height" content="630" />
            <meta property="og:image:alt" content={seo.openGraph.basic.title} />
        </>
    )}
    <!-- 代码字体由 Astro Fonts API 注入；正文按页面生成 native CJK 子集。 -->
    <Font cssVariable="--font-code" />
    <link rel="prefetch" as="style" href={pagefindStyles} data-stalux-search-style>
    <noscript><link rel="stylesheet" href={pagefindStyles}></noscript>
    {headConfig?.anyhead && <Fragment set:html={headConfig.anyhead} />}
    {headConfig?.googleAnalyticsId && <GoogleAnalytics />}
    {headConfig?.bingClarityId && <BingClarity />}
    {headConfig?.umami?.id && headConfig?.umami?.url && <Umami />}
    <script is:inline type="application/ld+json" set:html={ldJson} />
    <VerCount />
</head>
