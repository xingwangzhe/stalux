---
import { getCollection } from "astro:content";
import Search from "@components/stalux/common/search.astro";
import { normalizeRouteHref } from "@internal/route-hrefs";

import { getNavsData, getSiteData } from "@utils/config-utils";
import { createTranslator } from "@utils/i18n";
import { getLucideIcon } from "@utils/lucide-icons";

const MenuIcon = getLucideIcon("menu", Astro.logger);
const SearchIcon = getLucideIcon("search", Astro.logger);
const CloseIcon = getLucideIcon("x", Astro.logger);
const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const navsConfig = getNavsData(configEntries);
const { t } = createTranslator(siteConfig.lang || "zh-CN");
const navs = navsConfig?.items ?? [];
---

<nav class="stalux-site-nav" data-ref="stalux-site-nav" aria-label={t("nav.main")}>
    <!-- 汉堡菜单按钮 (仅窄屏显示) -->
    <button
        type="button"
        data-ref="stalux-nav-toggle"
        class="stalux-nav-toggle"
        aria-label={t("nav.menu")}
        aria-expanded="false"
        aria-haspopup="dialog"
        aria-controls="stalux-mobile-navigation"
    >
        {MenuIcon && <MenuIcon size={20} stroke-width={2} class="nav-icon" />}
    </button>

    <!-- 导航列表 -->
    <div class="stalux-nav-container stalux-u-w-full stalux-u-min-w-0">
        <ul
            data-ref="stalux-nav-list"
            class="stalux-nav-list stalux-u-flex stalux-u-items-center stalux-u-w-full stalux-u-min-w-0"
        >
            {navs.map((item) => {
                const NavIcon = item.icon ? getLucideIcon(item.icon, Astro.logger) : null;
                return (
                    <li class="stalux-nav-item stalux-u-flex stalux-u-items-center">
                        <a
                            href={normalizeRouteHref(item.link, Astro.site?.origin)}
                            class="stalux-nav-link"
                            data-ref="stalux-nav-link"
                        >
                            {NavIcon && <NavIcon size={20} stroke-width={2} class="nav-icon" />}
                            <span class="stalux-nav-text">{item.title}</span>
                        </a>
                    </li>
                );
            })}
            {__STALUX_ORAMA_ENABLED__ && (
                <li class="stalux-nav-item stalux-u-flex stalux-u-items-center">
                    <!-- Modern Web Guidance (html): 页内交互一律用 <button>，<a> 只负责 URL 导航 -->
                    <button
                        type="button"
                        class="stalux-nav-link"
                        data-ref="stalux-search-btn"
                        aria-label={t("search.title")}
                    >
                        {SearchIcon && <SearchIcon size={20} stroke-width={2} class="nav-icon" />}
                        <span class="stalux-nav-text">{t("nav.search")}</span>
                    </button>
                </li>
            )}
        </ul>
    </div>
    <dialog id="stalux-mobile-navigation" aria-label={t("nav.main")}>
        <div class="stalux-mobile-nav-panel" data-ref="stalux-mobile-nav-panel">
            <form method="dialog">
                <button type="submit" class="stalux-nav-link" aria-label={t("nav.close")} autofocus>
                    {CloseIcon && <CloseIcon size={20} aria-hidden="true" />}
                </button>
            </form>
        </div>
    </dialog>
</nav>
{__STALUX_ORAMA_ENABLED__ && <Search />}

<style>
.stalux-site-nav {
    min-width: 0;
}
.stalux-nav-list {
    flex-wrap: wrap;
    justify-content: center;
    row-gap: 0;
    column-gap: clamp(0.25rem, 1.2vw, 1.25rem);
}
.stalux-nav-item {
    max-width: 100%;
}
.stalux-nav-text {
    white-space: normal;
    overflow-wrap: anywhere;
}
#stalux-mobile-navigation {
    position: fixed;
    inset: 0;
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    padding: 0;
    margin: 0;
    border: 0;
    background: transparent;
    color: inherit;
    overflow: hidden;
}
#stalux-mobile-navigation::backdrop {
    background: rgb(0 0 0 / 0.6);
}
.stalux-mobile-nav-panel {
    box-sizing: border-box;
    width: min(220px, calc(100% - 1rem));
    height: 100%;
    padding: 0.5rem 1rem 2rem;
    overflow-y: auto;
    background: rgb(24 24 24 / 0.84);
    backdrop-filter: blur(20px);
}
@media (prefers-reduced-motion: no-preference) {
    #stalux-mobile-navigation[open] .stalux-mobile-nav-panel {
        animation: stalux-nav-slide-in 160ms ease-out;
    }
}
@keyframes stalux-nav-slide-in {
    from {
        transform: translateX(-100%);
    }
}
@media (max-width: 600px) {
    .stalux-nav-container {
        display: none;
    }
    .stalux-nav-list {
        flex-flow: column nowrap;
        align-items: stretch;
        gap: 0;
    }
}
</style>
