---
import { Icon } from "@lucide/astro";
import { icons } from "lucide";
import { getCollection } from "astro:content";
import { createTranslator } from "@utils/i18n";
import styles from "@styles/components/layout/navs.module.css";
import Search from "@components/stalux/common/search.astro";
/** 将 lucide 官网的 kebab-case 名称转为 icons 对象的 PascalCase key */
function getIconNode(iconName: string) {
    if (!iconName) return null;
    const pascal = iconName
        .split("-")
        .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
        .join("");
    const node = icons[pascal];
    if (!node) console.error(`lucide 图标 '${iconName}' 未找到`);
    return node;
}
const stalux = (await getCollection("config"))[0]?.data ?? {};
const { t } = createTranslator(stalux.lang || "zh-CN");
---

<nav aria-label="Main navigation" transition:persist-props>
    <!-- 汉堡菜单按钮 (仅窄屏显示) -->
    <button
        data-ref="stalux-nav-toggle"
        class={styles.navToggle}
        aria-label={t("nav.menu")}
    >
        <Icon iconNode={getIconNode("menu")} size={20} stroke-width={2} class="nav-icon" />
    </button>

    <!-- 侧边栏遮罩 -->
    <div data-ref="stalux-nav-overlay" class={styles.navOverlay}></div>

    <!-- 导航列表 -->
    <div class={styles.navContainer}>
        <button
            data-ref="stalux-nav-scroll-left"
            class={styles.scrollBtn}
            data-side="left"
            aria-label={t("nav.scrollLeft")}
        >
            <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
        </button>

        <ul data-ref="stalux-nav-list" class={styles.navList}>
            {
                stalux.navs.map((item) => (
                    <li class={styles.navItem}>
                        <a
                            href={item.link}
                            class={styles.navLink}
                            data-ref="stalux-nav-link"
                        >
                            {item.icon && (
                                <Icon iconNode={getIconNode(item.icon)} size={20} stroke-width={2} class="nav-icon" />
                            )}
                            <span class={styles.navText}>{item.title}</span>
                        </a>
                    </li>
                ))
            }
            <li class={styles.navItem}>
                <a
                    href="javascript:void(0)"
                    class={styles.navLink}
                    data-ref="stalux-search-btn"
                    aria-label={t("search.title")}
                >
                    <Icon iconNode={getIconNode("search")} size={20} stroke-width={2} class="nav-icon" />
                    <span class={styles.navText}>{t("nav.search")}</span>
                </a>
            </li>
        </ul>

        <button
            data-ref="stalux-nav-scroll-right"
            class={styles.scrollBtn}
            data-side="right"
            aria-label={t("nav.scrollRight")}
        >
            <svg viewBox="0 0 24 24"><polyline points="9 18 15 12 9 6"/></svg>
        </button>
    </div>
</nav>
<Search />
<script>
    document.addEventListener("astro:page-load", () => {
        const searchBtn = document.querySelector(
            '[data-ref="stalux-search-btn"]',
        );
        searchBtn?.addEventListener("click", (e) => {
            e.preventDefault();
            closeNav();
            const event = new CustomEvent("openSearch");
            document.dispatchEvent(event);
        });

        // 汉堡菜单交互
        const navToggle = document.querySelector(
            '[data-ref="stalux-nav-toggle"]',
        );
        const navList = document.querySelector('[data-ref="stalux-nav-list"]');
        const navOverlay = document.querySelector(
            '[data-ref="stalux-nav-overlay"]',
        );

        function openNav() {
            navList?.setAttribute("data-state", "open");
            navOverlay?.setAttribute("data-state", "show");
            document.body.style.overflow = "hidden";
        }

        function closeNav() {
            navList?.removeAttribute("data-state");
            navOverlay?.removeAttribute("data-state");
            document.body.style.overflow = "";
        }

        navToggle?.addEventListener("click", openNav);
        navOverlay?.addEventListener("click", closeNav);

        // 点击导航链接后关闭侧边栏
        const navLinks = document.querySelectorAll(
            '[data-ref="stalux-nav-link"]',
        );
        navLinks?.forEach((link) => {
            link.addEventListener("click", closeNav);
        });

        // --- 动态导航滚动按钮 ---
        initNavScroll();
    });

    function initNavScroll() {
        const navList = document.querySelector('[data-ref="stalux-nav-list"]');
        const btnLeft = document.querySelector('[data-ref="stalux-nav-scroll-left"]');
        const btnRight = document.querySelector('[data-ref="stalux-nav-scroll-right"]');
        if (!navList || !btnLeft || !btnRight) return;

        function updateButtons() {
            const hasOverflow = navList.scrollWidth > navList.clientWidth;
            const atStart = navList.scrollLeft <= 4;
            const atEnd = navList.scrollLeft >= navList.scrollWidth - navList.clientWidth - 4;

            if (hasOverflow) {
                btnLeft.classList.toggle("visible", !atStart);
                btnRight.classList.toggle("visible", !atEnd);
            } else {
                btnLeft.classList.remove("visible");
                btnRight.classList.remove("visible");
            }
        }

        btnLeft.addEventListener("click", () => {
            navList.scrollBy({ left: -300, behavior: "smooth" });
        });

        btnRight.addEventListener("click", () => {
            navList.scrollBy({ left: 300, behavior: "smooth" });
        });

        // 监听滚动事件更新按钮状态
        navList.addEventListener("scroll", updateButtons);

        // 用 ResizeObserver 监听容器尺寸变化（窗口缩窄/变宽时重新判断）
        const ro = new ResizeObserver(updateButtons);
        ro.observe(navList);

        // 初始检测
        updateButtons();
    }
</script>
