---
import { getCollection } from "astro:content";
import Search from "@components/stalux/common/search.astro";

import { getNavsData, getSiteData } from "@utils/config-utils";
import { createTranslator } from "@utils/i18n";
import { getLucideIcon } from "@utils/lucide-icons";

const MenuIcon = getLucideIcon("menu", Astro.logger);
const SearchIcon = getLucideIcon("search", Astro.logger);
const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const navsConfig = getNavsData(configEntries);
const { t } = createTranslator(siteConfig.lang || "zh-CN");
const navs = navsConfig?.items ?? [];
---

<nav aria-label={t("nav.main")}>
    <!-- 汉堡菜单按钮 (仅窄屏显示) -->
    <button
        type="button"
        data-ref="stalux-nav-toggle"
        class="stalux-nav-toggle"
        aria-label={t("nav.menu")}
    >
        {MenuIcon && <MenuIcon size={20} stroke-width={2} class="nav-icon" />}
    </button>

    <!-- 侧边栏遮罩 -->
    <div data-ref="stalux-nav-overlay" class="stalux-nav-overlay stalux-u-w-full"></div>

    <!-- 导航列表 -->
    <div class="stalux-nav-container stalux-u-w-full stalux-u-min-w-0">
        <button
            type="button"
            data-ref="stalux-nav-scroll-left"
            class="stalux-nav-scroll-btn stalux-u-items-center stalux-u-justify-center"
            data-side="left"
            aria-label={t("nav.scrollLeft")}
        >
            <svg aria-hidden="true" viewBox="0 0 24 24">
                <polyline points="15 18 9 12 15 6" />
            </svg>
        </button>

        <ul
            data-ref="stalux-nav-list"
            class="stalux-nav-list stalux-u-flex stalux-u-items-center stalux-u-justify-center stalux-u-flex-wrap stalux-u-w-full stalux-u-min-w-0"
        >
            {navs.map((item) => {
                const NavIcon = item.icon ? getLucideIcon(item.icon, Astro.logger) : null;
                return (
                    <li class="stalux-nav-item stalux-u-flex stalux-u-items-center">
                        <a
                            href={item.link}
                            class="stalux-nav-link"
                            data-ref="stalux-nav-link"
                            data-astro-prefetch
                        >
                            {NavIcon && <NavIcon size={20} stroke-width={2} class="nav-icon" />}
                            <span class="stalux-nav-text">{item.title}</span>
                        </a>
                    </li>
                );
            })}
            <li class="stalux-nav-item stalux-u-flex stalux-u-items-center">
                <a
                    href="#search"
                    class="stalux-nav-link"
                    data-ref="stalux-search-btn"
                    aria-label={t("search.title")}
                >
                    {SearchIcon && <SearchIcon size={20} stroke-width={2} class="nav-icon" />}
                    <span class="stalux-nav-text">{t("nav.search")}</span>
                </a>
            </li>
        </ul>

        <button
            type="button"
            data-ref="stalux-nav-scroll-right"
            class="stalux-nav-scroll-btn stalux-u-items-center stalux-u-justify-center"
            data-side="right"
            aria-label={t("nav.scrollRight")}
        >
            <svg aria-hidden="true" viewBox="0 0 24 24">
                <polyline points="9 18 15 12 9 6" />
            </svg>
        </button>
    </div>
</nav>
<Search />
