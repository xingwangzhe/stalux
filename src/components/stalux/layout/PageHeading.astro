---
interface Props {
    heading: string;
    description?: string;
}

const { heading, description } = Astro.props;
---

<>
    <h1 class="stalux-page-title stalux-u-text-center" data-stalux-motion-focus>
        {heading}
    </h1>
    {description && (
        <div class="stalux-page-description stalux-u-text-center" data-stalux-motion-content>
            {description}
        </div>
    )}
</>
