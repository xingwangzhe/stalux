---
interface Props {
    heading: string;
    description?: string;
}

const { heading, description } = Astro.props;
---

<!-- Modern Web Guidance (html): 页面标题块是列表页的 header，描述是 <p>。 -->
<header data-stalux-motion-region>
    <h1 class="stalux-page-title stalux-u-text-center" data-stalux-motion-focus>
        {heading}
    </h1>
    {description && (
        <p class="stalux-page-description stalux-u-text-center" data-stalux-motion-content>
            {description}
        </p>
    )}
</header>
