---
interface Props {
    heading: string;
    description?: string;
}

const { heading, description } = Astro.props;
---

<>
    <h1
        class="stalux-page-title stalux-u-text-center"
        transition:name="stalux-page-title"
        transition:animate="none"
    >
        {heading}
    </h1>
    {description && (
        <div
            class="stalux-page-description stalux-u-text-center"
            transition:name="stalux-page-description"
            transition:animate="none"
        >
            {description}
        </div>
    )}
</>
