---
import { getCollection } from "astro:content";
import Stalux from "@layouts/Stalux.astro";
import { getSiteData } from "@utils/config-utils";
import PageHeading from "./PageHeading.astro";

interface Props {
    title: string;
    description: string;
    heading: string;
    subheading?: string;
}

const { title, description, heading, subheading } = Astro.props;
const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
---

<Stalux title={`${title} | ${siteConfig.title}`} description={description}>
    <PageHeading heading={heading} description={subheading} />
    <slot />
</Stalux>
