---
import Navs from "@components/stalux/layout/navs.astro";
import Stalux from "@layouts/Stalux.astro";
import { getCollection } from "astro:content";
import styles from "@styles/pages/listPage.module.css";

interface Props {
    title: string;
    description: string;
    heading: string;
    subheading?: string;
}

const { title, description, heading, subheading } = Astro.props;
const stalux = (await getCollection("config"))[0].data;
---

<Stalux title={title + " | " + stalux.title} description={description}>
    <div style="height: 3em;"></div>
    <Navs />
    <h1 class={styles.title}>{heading}</h1>
    {subheading && <div class={styles.description}>{subheading}</div>}
    <slot />
</Stalux>
