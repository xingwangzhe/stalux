---
import Navs from "@components/stalux/layout/navs.astro";
import Stalux from "@layouts/Stalux.astro";
import { getCollection } from "astro:content";
import { getSiteData } from "@utils/config-utils";
import styles from "@styles/pages/listPage.module.css";

interface Props {
    title: string;
    description: string;
    heading: string;
    subheading?: string;
    fontSubsetId?: string;
}

const { title, description, heading, subheading, fontSubsetId } = Astro.props;
const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
---

<Stalux title={title + " | " + siteConfig.title} description={description} fontSubsetId={fontSubsetId}>
    <div style="height: 3em;"></div>
    <Navs />
    <h1 class={styles.title}>{heading}</h1>
    {subheading && <div class={styles.description}>{subheading}</div>}
    <slot />
</Stalux>
