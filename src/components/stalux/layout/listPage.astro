---
import { getCollection } from "astro:content";
import Navs from "@components/stalux/layout/navs.astro";
import Stalux from "@layouts/Stalux.astro";

import { getSiteData } from "@utils/config-utils";

interface Props {
    title: string;
    description: string;
    heading: string;
    subheading?: string;
}

const { title, description, heading, subheading } = Astro.props;
const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
---

<Stalux title={`${title} | ${siteConfig.title}`} description={description}>
    <div style="height: 3em;"></div>
    <Navs />
    <h1 class="stalux-page-title">{heading}</h1>
    {subheading && <div class="stalux-page-description">{subheading}</div>}
    <slot />
</Stalux>
