---
import { getCollection } from "astro:content";
import LinkCard from "@components/stalux/links/linkCard.astro";
import styles from "@styles/components/links/linkList.module.css";
import { getLinksData } from "@utils/config-utils";

const configEntries = await getCollection("config");
const linksConfig = getLinksData(configEntries);
const links = linksConfig?.sites ?? [];
---

<ul class={`${styles.list} stagger-children`}>
    {links.map((link) => (
            <li class={styles.item}>
                <LinkCard link={link} />
            </li>
        ))}
</ul>
