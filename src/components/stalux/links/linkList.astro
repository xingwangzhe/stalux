---
import "../../../styles/generated-links.css";
import { getCollection } from "astro:content";
import LinkCard from "@components/stalux/links/linkCard.astro";

import { getLinksData } from "@utils/config-utils";

const configEntries = await getCollection("config");
const linksConfig = getLinksData(configEntries);
const links = linksConfig?.sites ?? [];
---

<ul class="stalux-links">
    {links.map((link) => (
        <li class="stalux-link-list-item">
            <LinkCard link={link} />
        </li>
    ))}
</ul>
