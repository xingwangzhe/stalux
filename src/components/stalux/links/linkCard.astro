---
import { getCollection } from "astro:content";
import styles from "@styles/components/links/linkCard.module.css";
import { getSiteData } from "@utils/config-utils";
import { createTranslator } from "@utils/i18n";

interface LinkItem {
    title?: string;
    name?: string;
    url?: string;
    link?: string;
    description?: string;
    icon?: string;
    avatar?: string;
}

interface Props {
    link: LinkItem;
}

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const { t } = createTranslator(siteConfig.lang || "zh-CN");
const link = Astro.props.link;
const href = link.url ?? link.link ?? "#";
const title = link.title ?? link.name ?? t("links.defaultTitle");
const desc = link.description ?? "";
const icon = link.icon ?? link.avatar ?? "/favicon.ico";
---

<a class={`${styles.card} a-none`} href={href} target="_blank" rel="noopener">
    <div class={styles.avatar}>
        <img
            src={icon}
            alt={t("links.iconAlt", { name: title })}
            loading="lazy"
            width="80"
            height="80"
        >
    </div>
    <div class={styles.content}>
        <h2 class={styles.title}>{title}</h2>
        {desc && <p class={styles.description}>{desc}</p>}
    </div>
</a>
