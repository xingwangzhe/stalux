---
import "../../../styles/generated-links.css";
import { getCollection } from "astro:content";

import { getSiteData } from "@utils/config-utils";
import { createTranslator } from "@utils/i18n";

interface LinkItem {
    title?: string;
    name?: string;
    url?: string;
    link?: string;
    description?: string;
    icon?: string;
    avatar?: string;
}

interface Props {
    link: LinkItem;
}

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const { t } = createTranslator(siteConfig.lang || "zh-CN");
const link = Astro.props.link;
const href = link.url ?? link.link ?? "#";
const title = link.title ?? link.name ?? t("links.defaultTitle");
const desc = link.description ?? "";
const icon = link.icon ?? link.avatar ?? "/favicon.ico";
---

<!-- Modern Web Guidance (html): 友链卡是自包含内容 => <article>；
     头像是 <figure>（无题注的独立图像），标题 + 描述是卡片 <header>。 -->
<a
    data-stalux-control="link-card"
    class="stalux-link-shell a-none"
    href={href}
    target="_blank"
    rel="noopener"
>
    <article class="stalux-link-card">
        <figure class="stalux-link-card-avatar">
            <img
                src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7"
                data-src={icon}
                data-stalux-link-icon
                alt={t("links.iconAlt", { name: title })}
                loading="lazy"
                decoding="async"
                fetchpriority="low"
                width="80"
                height="80"
            >
        </figure>
        <header class="stalux-link-card-content">
            <h2 class="stalux-link-card-title">{title}</h2>
            {desc && <p class="stalux-link-card-description">{desc}</p>}
        </header>
    </article>
</a>
