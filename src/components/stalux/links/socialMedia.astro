---
// 按需导入图标 — Vite tree-shake 只打包用到的图标

import { getCollection } from "astro:content";
import styles from "@styles/components/links/socialLinks.module.css";
import { getMediaLinksData } from "@utils/config-utils";
import {
    type SimpleIcon,
    siBilibili,
    siGithub,
    siJuejin,
    siMaildotru,
    siQq,
    siX,
} from "simple-icons";

const configEntries = await getCollection("config");
const mediaLinksSection = getMediaLinksData(configEntries);
const mediaLinks = mediaLinksSection?.items ?? [];
const isPostPage = Astro.url.pathname.startsWith("/posts/");

// 静态图标映射表：新增图标时只需添加对应的 simple-icons 导入和映射
const iconMap: Record<string, SimpleIcon> = {
    github: siGithub,
    bilibili: siBilibili,
    qq: siQq,
    maildotru: siMaildotru,
    juejin: siJuejin,
    x: siX,
};

function getIconByTitle(iconName: string): SimpleIcon | undefined {
    return iconMap[iconName];
}
---

<nav
    class={styles["social-links"]}
    transition:persist-props
    aria-label="Social media"
    data-stalux-social-animate={String(!isPostPage)}
>
    <ul>
        {mediaLinks.map((item) => {
                const icon = item.icon ? getIconByTitle(item.icon) : undefined;
                return (
                    <li class="social_icon">
                        <a
                            href={item.link}
                            target="_blank"
                            aria-label={item.icon}
                            rel="noopener noreferrer"
                            title={item.icon}
                            class="a-none"
                        >
                            {icon ? (
                                <div class="icon-container">
                                    <svg
                                        role="img"
                                        viewBox="0 0 24 24"
                                        xmlns="http://www.w3.org/2000/svg"
                                        width="24"
                                        height="24"
                                        fill="currentColor"
                                        aria-hidden="true"
                                    >
                                        <title>{icon.title}</title>
                                        <path d={icon.path} />
                                    </svg>
                                </div>
                            ) : (
                                <span class="custom-icon">
                                    {item.icon ? item.icon.charAt(0).toUpperCase() : ""}
                                </span>
                            )}
                        </a>
                    </li>
                );
            })}
    </ul>
</nav>
