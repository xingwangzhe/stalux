---
import { getCollection } from "astro:content";
import { getHeadData } from "@utils/config-utils";
const configEntries = await getCollection("config");
const headConfig = getHeadData(configEntries);
const gaID = headConfig?.googleAnalyticsId;
const gaBootstrap = gaID
    ? `window.dataLayer = window.dataLayer || [];
window.gtag = function gtag() { dataLayer.push(arguments); };
gtag("js", new Date());
gtag("config", ${JSON.stringify(gaID)}, { send_page_view: false });
gtag("event", "page_view", { page_title: document.title, page_location: location.href });`
    : "";
---

{
    gaID && (
        <>
            <script
                type="text/partytown"
                src={`https://www.googletagmanager.com/gtag/js?id=${gaID}`}></script>
            <script type="text/partytown" set:html={gaBootstrap}></script>
            <script is:inline>
                let lastPath = window.location.pathname;
                document.addEventListener("astro:page-load", () => {
                    const path = window.location.pathname;
                    if (path !== lastPath) {
                        lastPath = path;
                        window.gtag?.("event", "page_view", { page_path: path });
                    }
                });
            </script>
        </>
    )
}
