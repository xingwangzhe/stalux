---
import { getCollection } from "astro:content";
import { getHeadData } from "@utils/config-utils";
const configEntries = await getCollection("config");
const headConfig = getHeadData(configEntries);
const id = headConfig?.bingClarityId;
---

<script is:inline data-astro-rerun define:vars={{ id }}>
    // 防止重复初始化
    const load = () => {
        if (!id || document.getElementById("stalux-clarity-script") || window.clarity) return;
        (function (c, l, a, r, i, t, y) {
            c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
            t = l.createElement(r);
            t.id = "stalux-clarity-script";
            t.async = 1;
            t.src = "https://www.clarity.ms/tag/" + i;
            y = l.getElementsByTagName(r)[0];
            y.parentNode.insertBefore(t, y);
        })(window, document, "clarity", "script", id);
    };
    if ("requestIdleCallback" in window) requestIdleCallback(load, { timeout: 4000 });
    else window.addEventListener("load", () => setTimeout(load, 0), { once: true });
</script>
