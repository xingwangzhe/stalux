---
import { getCollection } from "astro:content";
import { getSiteData, getAuthorData, getHeadData, getNavsData, getLinksData, getCommentData, getFooterData, getPromoteData, getTypetextsData, getMediaLinksData } from "@utils/config-utils";
const configEntries = await getCollection("config");
const headConfig = getHeadData(configEntries);
const umamiConfig = headConfig?.umami;
const umamiID = umamiConfig?.id;
const umamiURL = umamiConfig?.url;
---

<script
    defer
    src={umamiURL}
    data-website-id={umamiID}
    type="text/javascript"
    data-astro-rerun></script>
