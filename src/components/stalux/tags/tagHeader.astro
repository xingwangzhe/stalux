---
interface Props {
    type: string;
    typeKey?: string;
    name: string;
    count: number;
}
const props = Astro.props as Props;
import { getCollection } from "astro:content";
import { createTranslator } from "@utils/i18n";
import styles from "@styles/components/tags/tagHeader.module.css";

const stalux = (await getCollection("config"))[0]?.data ?? {};
const { t } = createTranslator(stalux.lang || "zh-CN");

const typeKey = props.typeKey || props.type;
let typeUrl = "";
if (typeKey === "category" || typeKey === "categories" || typeKey === "分类") {
    typeUrl = "/categories/";
} else if (typeKey === "tag" || typeKey === "tags" || typeKey === "标签") {
    typeUrl = "/tags/";
}
---

<div class={styles.pageHeader}>
    <h1 class={styles.pageTitle}>
        <span class={styles.categoryIcon}>
            <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                width="28"
                height="28"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
            >
                <path
                    d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"
                ></path>
            </svg>
        </span>
        {props.type}: {props.name}
    </h1>
    <p class={styles.pageDescription}>{t("taxonomy.foundPosts", { count: props.count })}</p>
    <a href={typeUrl} class={styles.backLink}>{t("taxonomy.backToList", { type: props.type })}</a>
</div>
