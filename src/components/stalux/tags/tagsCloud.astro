---
import "../../../styles/generated-tags.css";
import { getCollection } from "astro:content";

import { getTagCountList } from "@utils/collections-stats";
import { getSiteData } from "@utils/config-utils";
import { createTranslator } from "@utils/i18n";

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const { t } = createTranslator(siteConfig.lang || "zh-CN");
const tagList = await getTagCountList(Astro.logger);
const tagGroups = Array.from({ length: Math.ceil(tagList.length / 32) }, (_, index) =>
    tagList.slice(index * 32, (index + 1) * 32),
);
const cloudDensity = Math.sqrt(Math.max(tagList.length, 100) / 100);
const tagLinks = tagList.map((t) => ({
    type: "link" as const,
    text: t.name,
    url: `/tags/${t.name}/`,
}));
---

<!-- 移动端：SSR 卡片 -->
<div class="stalux-cloud-cards" id="tags-cards">
    {tagList.length > 0 ? (
        tagGroups.map((group) => (
            <div class="stalux-cloud-tag-group">
                {group.map(({ name, count }) => (
                    <a
                        href={`/tags/${name}/`}
                        class="stalux-cloud-tag-card"
                        data-stalux-card
                        data-stalux-tag-card
                        data-count={count}
                        data-astro-prefetch
                    >
                        <span class="stalux-cloud-tag-name">{name}</span>
                        <span class="stalux-cloud-tag-count">{count}</span>
                    </a>
                ))}
            </div>
        ))
    ) : (
        <div class="stalux-cloud-no-tags">{t("tags.noTags")}</div>
    )}
</div>

<!-- 桌面端：Canvas 标签云 -->
<div class="stalux-cloud-canvas-frame" style={{ "--cloud-density": cloudDensity }}>
    <div class="stalux-cloud-canvas" id="tags-canvas" data-tags={JSON.stringify(tagLinks)}></div>
</div>

<script>
import "../../../scripts/tags-cloud";
</script>
