---
import { getCollection } from "astro:content";
import styles from "@styles/components/tags/tagsCloud.module.css";
import { getTagCountList } from "@utils/collections-stats";
import { getSiteData } from "@utils/config-utils";
import { createTranslator } from "@utils/i18n";

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const { t } = createTranslator(siteConfig.lang || "zh-CN");
const tagList = await getTagCountList();
const tagLinks = tagList.map((t) => ({
    type: "link" as const,
    text: t.name,
    url: `/tags/${t.name}/`,
}));
---

<!-- 移动端：SSR 卡片 -->
<div class={styles.cards} id="tags-cards">
    {tagList.length > 0 ? (
            tagList.map(({ name, count }) => (
                <a
                    href={`/tags/${name}/`}
                    class={styles.tagCard}
                    data-stalux-tag-card
                    data-count={count}
                    data-astro-prefetch
                >
                    <span class={styles.tagName}>{name}</span>
                    <span class={styles.tagCount}>{count}</span>
                </a>
            ))
        ) : (
            <div class={styles.noTags}>{t("tags.noTags")}</div>
        )}
</div>

<!-- 桌面端：Canvas 标签云 -->
<div class={styles.canvas} id="tags-canvas" data-tags={JSON.stringify(tagLinks)}></div>

<script>
import "../../../scripts/tags-cloud";
</script>
