---
import "../../../styles/generated-tags.css";
import { getCollection } from "astro:content";

import { getTagCountList } from "@utils/collections-stats";
import { getSiteData } from "@utils/config-utils";
import { createTranslator } from "@utils/i18n";

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const { t } = createTranslator(siteConfig.lang || "zh-CN");
const tagList = await getTagCountList(Astro.logger);
const tagGroups = Array.from({ length: Math.ceil(tagList.length / 32) }, (_, index) =>
    tagList.slice(index * 32, (index + 1) * 32),
);
const cloudDensity = Math.sqrt(Math.max(tagList.length, 100) / 100);
const tagLinks = tagList.map((t) => ({
    type: "link" as const,
    text: t.name,
    url: `/tags/${t.name}/`,
}));
---

<!-- 移动端：SSR 卡片 -->
<!-- Modern Web Guidance (html): 标签是一组条目 => <ul>/<li>；空态是纯文字 => <p>。 -->
<section
    class="stalux-cloud-cards"
    id="tags-cards"
    data-stalux-tag-cards
    data-stalux-motion-content
    aria-label={t("tags.title")}
>
    {tagList.length > 0 ? (
        tagGroups.map((group) => (
            <ul class="stalux-cloud-tag-group" data-stalux-reveal>
                {group.map(({ name, count }) => (
                    <li data-stalux-reveal-item>
                        <a
                            href={`/tags/${name}/`}
                            class="stalux-cloud-tag-card"
                            data-stalux-card
                            data-stalux-tag-card
                            data-stalux-control="tag-card"
                            data-count={count}
                            data-astro-prefetch
                        >
                            <span class="stalux-cloud-tag-name">{name}</span>
                            <span class="stalux-cloud-tag-count">{count}</span>
                        </a>
                    </li>
                ))}
            </ul>
        ))
    ) : (
        <p class="stalux-cloud-no-tags">{t("tags.noTags")}</p>
    )}
</section>

<!-- 桌面端：Canvas 标签云（可视化整体，用 <figure> 承载；内部节点是脚本挂载点） -->
<figure
    class="stalux-cloud-canvas-frame"
    data-stalux-tag-canvas
    style={{ "--cloud-density": cloudDensity }}
    data-stalux-motion-content
>
    <div class="stalux-cloud-canvas" id="tags-canvas" data-tags={JSON.stringify(tagLinks)}></div>
</figure>

<script>
import "../../../scripts/tags-cloud";
</script>
