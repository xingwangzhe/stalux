---
import "../../../styles/generated-categories.css";
import CategoriesCard from "@components/stalux/categories/categoriesCard.astro";

import { getCategoryCountList } from "@utils/collections-stats";

const categoryList = await getCategoryCountList(Astro.logger);
---

<ul
    class="stalux-categories"
    data-stalux-motion-content
    data-stalux-motion-stage
    data-stalux-reveal
>
    {categoryList.map((category) => (
        <li data-stalux-reveal-item>
            <CategoriesCard category={category} />
        </li>
    ))}
</ul>
