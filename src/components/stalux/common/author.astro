---
import { Image } from "astro:assets";
import { getCollection } from "astro:content";

import { getAuthorData } from "@utils/config-utils";

const configEntries = await getCollection("config");
const authorConfig = getAuthorData(configEntries);
interface Props {
    showBio?: boolean | false;
    iscolum?: boolean | false;
}
const props = Astro.props as Props;

// 判断当前页面是否是首页，如果是则跳转到about，否则跳转到首页
const isHomePage = Astro.url.pathname === "/";
const navigationHref = isHomePage ? "/about" : "/";
---

<article class="stalux-author" transition:persist-props>
    <figure class={`stalux-author-figure ${props.iscolum ? "stalux-author-figure-column" : ""}`}>
        <a href={navigationHref} class="a-none" data-astro-prefetch>
            <Image src={authorConfig.avatar} alt={authorConfig.name} width={100} height={100} />
        </a>
        <figcaption>{authorConfig.name}</figcaption>
        {props.showBio && <p>{authorConfig.bio}</p>}
    </figure>
</article>
