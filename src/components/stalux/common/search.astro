---
import { getCollection } from "astro:content";
import { Clock } from "@lucide/astro";
import { getSiteData } from "@utils/config-utils";
import { createTranslator } from "@utils/i18n";

const { lang } = getSiteData(await getCollection("config"));
const { t } = createTranslator(lang);
const dictionary = {
    searchPlaceholder: t("search.placeholder"),
    noResultsFound: t("search.noResults"),
    noResultsFoundFor: t("search.noResultsFor"),
    startYourSearch: t("search.start"),
    errorMessage: t("search.error"),
};
---

<template data-stalux-search data-search-dictionary={JSON.stringify(dictionary)}>
    <orama-search-box data-stalux-search></orama-search-box>
    <Clock data-search-clock aria-hidden="true" size="1em" style="flex:none" />
</template>
