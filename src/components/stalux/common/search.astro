---
import { getCollection } from "astro:content";
import { createTranslator } from "@utils/i18n";
import { getLucideIcon } from "@utils/lucide-icons";
import "@styles/components/search.css";

const CloseIcon = getLucideIcon("x");
const stalux = (await getCollection("config"))[0]?.data ?? {};
const { t, lang } = createTranslator(stalux.lang || "zh-CN");
---

<div
    id="search-container"
    class="search-container"
    inert
    data-search-labels={JSON.stringify({
        typePost: t("search.typePost"),
        typeAbout: t("search.typeAbout"),
        typeWord: t("search.typeWord"),
    })}
>
    <div class="search-backdrop"></div>
    <div class="search-box">
        <div class="search-header">
            <h2>{t("search.title")}</h2>
            <button
                id="search-close"
                class="search-close"
                aria-label={t("search.close")}
            >
                {CloseIcon && <CloseIcon size={24} />}
            </button>
        </div>
        <div class="search-input-area">
            <input
                id="search-input"
                class="search-input"
                type="text"
                placeholder={t("search.placeholder")}
                autocomplete="off"
                aria-label={t("search.inputLabel")}
            />
        </div>
        <div id="search-results" class="search-results">
            <div id="search-results-list" class="search-results-list"></div>
            <div id="search-empty" class="search-empty" style="display:none">
                {t("search.noResults")}
            </div>
        </div>
    </div>
</div>

<script>
    import { create, load, search } from "@orama/orama";
    import { createTokenizer } from "@orama/tokenizers/mandarin";
    import { stopwords as mandarinStopwords } from "@orama/stopwords/mandarin";
    import { Highlight, highlightStrategy } from "@orama/highlight";
    import { searchSchema, type SearchDoc, type SearchSchema } from "@utils/search-schema";

    let searchLabels = {
        typePost: "",
        typeAbout: "",
        typeWord: "",
    };

    let db: Awaited<ReturnType<typeof create<SearchSchema>>> | null = null;
    let indexLoading = false;

    // 复用的高亮器实例：highlight() 每次调用会重置 positions，
    // 单个实例即可服务所有结果，无需每条结果都 new 一个。
    const highlighter = new Highlight({
        HTMLTag: "mark",
        strategy: highlightStrategy.PARTIAL_MATCH,
    });

    async function initOrama() {
        if (db) return db;
        if (indexLoading) {
            while (!db) await new Promise((r) => setTimeout(r, 50));
            return db;
        }
        indexLoading = true;
        try {
            const response = await fetch("/search-index.json");
            if (!response.ok) throw new Error("Failed to load search index");
            const data = await response.json();
            const instance = await create({
                schema: searchSchema,
                components: {
                    tokenizer: createTokenizer({
                        stopWords: mandarinStopwords,
                    }),
                },
            });
            await load(instance, data);
            db = instance;
            return db;
        } finally {
            indexLoading = false;
        }
    }

    function formatResultMeta(type: string, date: string) {
        if (type === "post" && date) return `${searchLabels.typePost} · ${date}`;
        if (type === "post") return searchLabels.typePost;
        if (type === "about") return searchLabels.typeAbout;
        if (type === "word") return searchLabels.typeWord;
        return "";
    }

    function renderResults(
        hits: Array<{ document: SearchDoc; score: number }>,
        query: string,
    ) {
        const list = document.getElementById("search-results-list");
        const empty = document.getElementById("search-empty");
        if (!list || !empty) return;

        list.innerHTML = "";

        if (hits.length === 0) {
            empty.style.display = "block";
            return;
        }
        empty.style.display = "none";

        for (const hit of hits) {
            const doc = hit.document;

            // 先取标题高亮 HTML（下一步会复用同一实例高亮正文，覆盖 .HTML）
            const titleHTML = highlighter.highlight(doc.title, query).HTML;

            const text = [doc.description, doc.content]
                .filter(Boolean)
                .join(" ")
                .replace(/\n/g, " ");
            highlighter.highlight(text, query);
            const snippetHTML = highlighter.positions.length > 0
                ? highlighter.trim(200)
                : highlighter.HTML.slice(0, 200);

            const item = document.createElement("a");
            item.className = "search-result-item";
            item.href = doc.url;
            item.dataset.resultLink = "true";

            item.replaceChildren(
                Object.assign(document.createElement("div"), {
                    className: "search-result-title",
                    innerHTML: titleHTML,
                }),
                Object.assign(document.createElement("div"), {
                    className: "search-result-meta",
                    textContent: formatResultMeta(doc.type, doc.date),
                }),
                Object.assign(document.createElement("div"), {
                    className: "search-result-desc",
                    innerHTML: snippetHTML,
                }),
            );
            list.append(item);
        }
    }

    function clearResults() {
        const list = document.getElementById("search-results-list");
        const empty = document.getElementById("search-empty");
        if (list) list.innerHTML = "";
        if (empty) empty.style.display = "none";
    }

    let searchTimeout: ReturnType<typeof setTimeout> | null = null;

    async function performSearch(query: string) {
        const term = query.trim();
        if (!term) {
            clearResults();
            return;
        }

        const instance = await initOrama();
        const results = await search(instance, {
            term,
            limit: 20,
            threshold: 0,
            properties: ["title", "description", "content", "tags"],
            boost: {
                title: 2,
                tags: 1.5,
                description: 1.2,
                content: 1,
            },
        });

        renderResults(
            results.hits as Array<{ document: SearchDoc; score: number }>,
            term,
        );
    }

    // —— 视图切换时的引用刷新 ——
    // search 容器在每次视图切换时会被重建，因此 container/input 等 DOM 引用
    // 需在 astro:page-load 里重新获取；document 级监听只需注册一次。
    let searchContainer: HTMLElement | null = null;
    let searchInput: HTMLInputElement | null = null;

    function closeSearch() {
        searchContainer?.classList.remove("active");
        searchContainer?.setAttribute("inert", "");
        if (searchInput) searchInput.value = "";
        clearResults();
    }

    // 文档级监听只注册一次，避免视图切换时累加，
    // 否则每次按键会执行 O(导航次数) 个处理器。
    document.addEventListener("openSearch", () => {
        searchContainer?.removeAttribute("inert");
        searchContainer?.classList.add("active");
        const isMobile = window.matchMedia("(max-width: 768px)").matches;
        if (!isMobile && searchInput) {
            setTimeout(() => searchInput?.focus(), 150);
        }
        initOrama().catch(() => {});
    });

    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && searchContainer?.classList.contains("active")) {
            closeSearch();
        }
    });

    document.addEventListener("astro:page-load", () => {
        searchContainer = document.getElementById("search-container");
        if (searchContainer?.dataset.searchLabels) {
            try {
                searchLabels = JSON.parse(searchContainer.dataset.searchLabels);
            } catch {
                /* 保留默认空标签 */
            }
        }
        const closeBtn = document.getElementById("search-close");
        const backdrop = document.querySelector(".search-backdrop");
        searchInput = document.getElementById("search-input") as HTMLInputElement | null;

        closeBtn?.addEventListener("click", closeSearch);
        backdrop?.addEventListener("click", closeSearch);

        searchContainer?.addEventListener("click", (e) => {
            const target = e.target as HTMLElement;
            if (target.closest('[data-result-link="true"]')) {
                setTimeout(closeSearch, 100);
            }
        });

        searchInput?.addEventListener("input", (e) => {
            const value = (e.target as HTMLInputElement).value;
            if (searchTimeout) clearTimeout(searchTimeout);
            if (!value.trim()) {
                clearResults();
                return;
            }
            searchTimeout = setTimeout(() => {
                performSearch(value).catch((err) => {
                    console.error("Search error:", err);
                });
            }, 150);
        });
    });
</script>
