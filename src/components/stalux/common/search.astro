---
import PagefindConfig from "astro-pagefind/components/PagefindConfig.astro";
import "@styles/components/search.css";
//@ts-ignore
import * as feather from "feather-icons";
---

<div id="search-container" class="search-container" data-pf-theme="dark" inert>
    <div class="search-backdrop"></div>
    <div class="search-box">
        <div class="search-header">
            <h2>搜索</h2>
            <button
                id="search-close"
                class="search-close"
                aria-label="关闭搜索"
            >
                <Fragment
                    set:html={feather.icons["x"].toSvg({
                        width: 24,
                        height: 24,
                    })}
                />
            </button>
        </div>
        <PagefindConfig instance="search" lang="zh-cn" />
        <div class="search-input-area">
            <pagefind-input
                instance="search"
                placeholder="输入关键词搜索..."
            ></pagefind-input>
        </div>
        <div class="search-results">
            <pagefind-results
                instance="search"
                show-sub-results
                max-sub-results="3"
            ></pagefind-results>
        </div>
    </div>
</div>

<script>
    document.addEventListener("astro:page-load", () => {
        const container = document.getElementById("search-container");
        const closeBtn = document.getElementById("search-close");
        const backdrop = document.querySelector(".search-backdrop");

        const closeSearch = () => {
            container?.classList.remove("active");
            container?.setAttribute("inert", "");
        };

        document.addEventListener("openSearch", () => {
            container?.removeAttribute("inert");
            container?.classList.add("active");
            // 延迟聚焦，避免移动端侧边栏点击时立即弹出键盘
            // 只在桌面端主动聚焦；移动端用户手动点击输入框时再聚焦
            const isMobile = window.matchMedia("(max-width: 768px)").matches;
            if (!isMobile) {
                const input = container?.querySelector(
                    "pagefind-input",
                ) as HTMLElement & { focus?: () => void };
                setTimeout(() => input?.focus?.(), 150);
            }
        });

        closeBtn?.addEventListener("click", closeSearch);
        backdrop?.addEventListener("click", closeSearch);

        document.addEventListener("keydown", (e) => {
            if (
                e.key === "Escape" &&
                container?.classList.contains("active")
            ) {
                closeSearch();
            }
        });

        container?.addEventListener("click", (e) => {
            const target = e.target as HTMLElement;
            if (target.closest("pagefind-results a[href]")) {
                setTimeout(() => closeSearch(), 100);
            }
        });
    });
</script>
