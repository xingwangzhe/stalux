---
// Pagefind component-ui search modal.
// CSS/JS loaded from pagefind build output (copied by pagefind integration).
// Triggered by nav search button or Cmd+K shortcut.
---

{
  import.meta.env.PROD && (
    <>
      <link rel="stylesheet" href="/pagefind/pagefind-component-ui.css" />
      <script src="/pagefind/pagefind-component-ui.js" type="module"></script>
      <pagefind-modal id="search"></pagefind-modal>
    </>
  )
}

<style is:global>
  /* Force dark theme — all:initial prevents CSS variable inheritance,
     so we target pagefind elements directly with high-specificity selectors. */
  [data-pf-theme="dark"] .pf-modal,
  [data-pf-theme="dark"] .pf-modal-body,
  [data-pf-theme="dark"] .pf-modal-footer,
  [data-pf-theme="dark"] .pf-modal-header,
  [data-pf-theme="dark"] .pf-input,
  [data-pf-theme="dark"] .pf-result-card,
  [data-pf-theme="dark"] .pf-result-title,
  [data-pf-theme="dark"] .pf-excerpt {
    background-color: #1a1a2e !important;
    color: #e4e2de !important;
  }
  [data-pf-theme="dark"] .pf-modal {
    background: #1a1a2e !important;
    border: 1px solid #2a2a30 !important;
  }
  [data-pf-theme="dark"] .pf-input {
    background: #252528 !important;
    border-color: #2a2a30 !important;
    color: #e4e2de !important;
  }
  [data-pf-theme="dark"] .pf-result-card:hover {
    background: #252528 !important;
  }
  [data-pf-theme="dark"] ::backdrop {
    background: rgba(0, 0, 0, 0.7) !important;
  }
</style>

<script is:inline>
  (() => {
    const html = document.documentElement;
    const syncTheme = () => html.toggleAttribute("data-pf-theme", html.classList.contains("dark"));
    syncTheme();
    new MutationObserver(syncTheme).observe(html, { attributes: true, attributeFilter: ["class"] });
    document.addEventListener("astro:after-swap", syncTheme);
  })();
</script>
