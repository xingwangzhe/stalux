---
// Pagefind search — uses pagefind JS API directly for a modal search UI.
// Triggered by the nav search button via window.__pagefindSearch().
---

<script>
    window.__pagefindSearch = () => {
        const container = document.getElementById("pagefind-search");
        if (container) {
            container.hidden = false;
            const input = container.querySelector("input");
            if (input) setTimeout(() => input.focus(), 100);
            return;
        }

        fetch("/pagefind/pagefind.js", { method: "HEAD" })
            .then((res) => {
                if (!res.ok) throw new Error("Not found");
                createOverlay();
            })
            .catch(() => {
                const div = document.createElement("div");
                div.id = "pagefind-search";
                div.style.cssText = "position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.7);display:flex;align-items:center;justify-content:center";
                div.innerHTML =
                    '<div style="background:#1a1a2e;padding:2rem;border-radius:1rem;text-align:center;color:#888;max-width:400px">' +
                    "<p style='font-size:1.2rem;margin:0 0 0.5rem;color:#e4e2de'>🔍 Search</p>" +
                    "<p style='margin:0;font-size:0.9rem'>Search index not available in dev mode.<br>Run <code>astro build</code> first.</p>" +
                    "</div>";
                div.onclick = () => div.remove();
                document.body.appendChild(div);
            });
    };

    function createOverlay() {
        const link = document.createElement("link");
        link.rel = "stylesheet";
        link.href = "/pagefind/pagefind-ui.css";
        document.head.appendChild(link);

        const script = document.createElement("script");
        script.src = "/pagefind/pagefind.js";
        script.onload = () => buildUI(window.pagefind);
        document.head.appendChild(script);
    }

    async function buildUI(pagefind) {
        const overlay = document.createElement("div");
        overlay.id = "pagefind-search";
        overlay.style.cssText =
            "position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.7);display:flex;align-items:flex-start;justify-content:center;padding-top:10vh";
        overlay.onclick = () => { overlay.hidden = true; };

        overlay.innerHTML =
            '<div style="width:min(640px,90vw);max-height:70vh;background:#1a1a2e;border-radius:1rem;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.5);display:flex;flex-direction:column">' +
            '<div style="padding:1rem 1rem 0">' +
            '<input id="pf-input" type="search" placeholder="Search..." autofocus style="width:100%;padding:0.75rem 1rem;font-size:1rem;border:1px solid #2a2a30;border-radius:0.5rem;background:#252528;color:#e4e2de;outline:none;box-sizing:border-box">' +
            "</div>" +
            '<div id="pf-results" style="flex:1;overflow-y:auto;padding:0.5rem 1rem 1rem;color:#a0a0a0;font-size:0.9rem"></div>' +
            "</div>";

        document.body.appendChild(overlay);

        const input = document.getElementById("pf-input");
        const results = document.getElementById("pf-results");
        let currentSearch = null;

        input.addEventListener("input", () => {
            const q = input.value.trim();
            if (!q) { results.innerHTML = ""; return; }

            currentSearch = q;
            pagefind.search(q).then((search) => {
                if (currentSearch !== q) return;
                if (!search.results.length) {
                    results.innerHTML = "<p style='padding:1rem;text-align:center;color:#666'>No results</p>";
                    return;
                }
                let items = "";
                search.results.slice(0, 20).forEach((r) => {
                    r.data().then((data) => {
                        items += "<a href='" + data.url + "' style='display:block;padding:0.5rem;text-decoration:none;border-radius:0.5rem;color:#e4e2de' onmouseover='this.style.background=\"#252528\"' onmouseout='this.style.background=\"\"'>" +
                            "<div style='font-size:0.95rem;font-weight:500'>" + data.meta.title + "</div>" +
                            (data.meta.description ? "<div style='font-size:0.8rem;color:#888;margin-top:2px'>" + data.meta.description + "</div>" : "") +
                            "</a>";
                        results.innerHTML = items;
                    });
                });
            });
        });

        input.focus();

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                overlay.hidden = true;
            }
        });
    }

    document.addEventListener("openSearch", () => window.__pagefindSearch?.());

    document.addEventListener("astro:before-swap", () => {
        const overlay = document.getElementById("pagefind-search");
        if (overlay) overlay.remove();
    });
</script>
