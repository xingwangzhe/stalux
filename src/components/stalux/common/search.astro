---
// Pagefind component-ui search modal.
// Docs: https://pagefind.app/llms-component-ui.txt
// data-pf-theme must be on a DIRECT parent wrapper of the component.
import { sitePath } from "../../../utils/site-path";
---

<!-- Modern Web Guidance (html): <search> 包裹搜索与过滤机制，自带 search 地标。 -->
<search data-pf-theme="dark">
    <pagefind-config bundle-path={sitePath("pagefind-enhanced/")}></pagefind-config>
    <pagefind-modal id="search"></pagefind-modal>
</search>
