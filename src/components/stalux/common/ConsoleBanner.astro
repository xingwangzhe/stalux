---
// Console Banner - 控制台横幅组件
import { getCollection } from "astro:content";
import { createTranslator } from "@utils/i18n";

const stalux = (await getCollection("config"))[0]?.data ?? {};
const { t } = createTranslator(stalux.lang || "zh-CN");
---

<script define:vars={{
    info: {
        theme: t("console.name"),
        version: "V1.1.0",
        author: t("console.author"),
        repository: "https://github.com/xingwangzhe/stalux",
        copyright: t("console.copyright"),
        copyrightRegNumber: "2025SR2258474",
        license: t("console.certNumber"),
        licensePdf: t("console.certUrl"),
        openSourceLicense: "MIT License",
        licenseUrl: "https://github.com/xingwangzhe/stalux/blob/master/LICENSE",
        registrationDate: t("console.regDate"),
        website: "https://stalux.needhelp.icu",
    },
    labels: {
        version: t("console.labelVersion"),
        author: t("console.labelAuthor"),
        repo: t("console.labelRepo"),
        website: t("console.labelWebsite"),
        cert: t("console.labelCert"),
        certNumber: t("console.labelCertNumber"),
        regDate: t("console.labelRegDate"),
        license: t("console.labelLicense"),
        authNote: t("console.labelAuthNote"),
        tip: t("console.labelTip"),
        feedback: t("console.labelFeedback"),
    },
    authNoteText: t("console.authNote"),
    tipText: t("console.tip"),
    feedbackUrl: t("console.feedback"),
}} defer>
    (function () {
        // ASCII Art Banner
        const banner = `
  ███████╗████████╗ █████╗ ██╗     ██╗   ██╗██╗  ██╗
  ██╔════╝╚══██╔══╝██╔══██╗██║     ██║   ██║╚██╗██╔╝
  ███████╗   ██║   ███████║██║     ██║   ██║ ╚███╔╝ 
  ╚════██║   ██║   ██╔══██║██║     ██║   ██║ ██╔██╗ 
  ███████║   ██║   ██║  ██║███████╗╚██████╔╝██╔╝ ██╗
  ╚══════╝   ╚═╝   ╚═╝  ╚═╝╚══════╝ ╚═════╝ ╚═╝  ╚═╝
    `;

        // 样式定义
        const styles = {
            banner: "color: #a855f7; font-weight: bold; font-size: 14px; line-height: 1.2;",
            title: "color: #fbbf24; font-size: 18px; font-weight: bold; text-shadow: 2px 2px 4px rgba(251, 191, 36, 0.3);",
            key: "color: #06b6d4; font-weight: bold;",
            value: "color: #f472b6;",
            link: "color: #10b981; text-decoration: underline;",
            copyright: "color: #a78bfa; font-style: italic;",
            separator: "color: #6366f1; font-weight: bold;",
        };

        // 打印函数
        function printBanner() {
            const separator = "═".repeat(60);
            const mitLicenseStyle = "color: #34d399; font-weight: bold;";
            const authStyle = "color: #60a5fa;";
            const tipStyle = "color: #fbbf24;";

            // 使用一个 console.log 打印所有内容
            console.log(
                `%c${banner}` +
                    `%c\n✨ ${info.theme} ✨\n` +
                    `%c${separator}\n` +
                    `%c${labels.version}%c${info.version}\n` +
                    `%c${labels.author}%c${info.author}\n` +
                    `%c${labels.repo}%c${info.repository}\n` +
                    `%c${labels.website}%c${info.website}\n` +
                    `%c${labels.cert}%c${info.license} %c→ ${info.licensePdf}\n` +
                    `%c${labels.certNumber}%c${info.copyrightRegNumber}\n` +
                    `%c${labels.regDate}%c${info.registrationDate}\n` +
                    `%c${separator}\n` +
                    `%c${labels.license}%c${info.openSourceLicense} %c→ ${info.licenseUrl}\n` +
                    `%c${labels.authNote}%c${authNoteText}\n` +
                    `%c${separator}\n` +
                    `%c${labels.tip}%c${tipText}\n` +
                    `%c${labels.feedback}%c${feedbackUrl}`,
                // 所有样式参数
                styles.banner,
                styles.title,
                styles.separator,
                styles.key, styles.value,
                styles.key, styles.value,
                styles.key, styles.link,
                styles.key, styles.link,
                styles.key, styles.value, styles.link,
                styles.key, styles.value,
                styles.key, styles.value,
                styles.separator,
                styles.key, mitLicenseStyle, styles.link,
                styles.key, authStyle,
                styles.separator,
                styles.key, tipStyle,
                styles.key, styles.link,
            );
        }

        // 在页面加载完成后打印
        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", printBanner, {
                once: true,
            });
        } else {
            printBanner();
        }
    })();
</script>
