<p id={"stalux-date-date-time"} class="date-time">
    <time id={"stalux-date-date"} data-ref="date" datetime=""></time>
    <time id={"stalux-date-time"} data-ref="time" datetime=""></time>
</p>

<script is:inline>
(() => {
    const dateElement = document.querySelector('[data-ref="date"]');
    const timeElement = document.querySelector('[data-ref="time"]');
    if (!(dateElement && timeElement)) return;
    const now = new Date();
    const pad = (value) => String(value).padStart(2, "0");
    const lang = document.documentElement.lang || "zh-CN";
    const zh = lang.toLowerCase().startsWith("zh");
    // Modern Web Guidance (javascript): 本地化文案交给 Intl.DateTimeFormat，
    // 不再按语言手写拼接年月日；只有机器可读的 datetime 值仍按本地日历拼装。
    dateElement.textContent = new Intl.DateTimeFormat(lang, {
        year: "numeric",
        month: zh ? "long" : "short",
        day: "2-digit",
    }).format(now);
    // datetime 必须是访客本地日历值：toISOString() 给的是 UTC，跨时区会差一天。
    const machineDate = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
    dateElement.dateTime = machineDate;
    const machineTime = `${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
    timeElement.textContent = machineTime;
    timeElement.dateTime = machineTime;
})();
</script>

<script>
import "../../../scripts/date-time";
</script>
