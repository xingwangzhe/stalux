---
import styles from "@styles/components/common/date.module.css";
---

<div id={styles["date-time"]} class="date-time" transition:persist-props>
    <time id={styles["date"]} data-ref="date" datetime=""></time>
    <time id={styles["time"]} data-ref="time" datetime=""></time>
</div>

<script>
    import { format } from "date-fns";
    import { zhCN } from "date-fns/locale/zh-CN";
    import { enUS } from "date-fns/locale/en-US";

    const localeMap: Record<string, Locale> = {
        "zh-CN": zhCN,
        en: enUS,
        "en-US": enUS,
    };

    function updateDateTime() {
        const now = new Date();
        const dateEl = document.querySelector('[data-ref="date"]');
        const timeEl = document.querySelector('[data-ref="time"]');
        const lang = document.documentElement.lang || "zh-CN";
        const locale = localeMap[lang] || zhCN;
        const dateFormat = lang.startsWith("zh") ? "yyyy年MM月dd日" : "MMM dd, yyyy";
        if (dateEl) {
            dateEl.textContent = format(now, dateFormat, { locale });
            dateEl.setAttribute("datetime", format(now, "yyyy-MM-dd"));
        }
        if (timeEl) {
            timeEl.textContent = format(now, "HH:mm:ss");
            timeEl.setAttribute("datetime", format(now, "HH:mm:ss"));
        }
    }
    // 全局只保留一个 1Hz 定时器：用单例守卫避免视图切换时累加定时器。
    let timerId: ReturnType<typeof setInterval> | null = null;

    document.addEventListener("astro:page-load", () => {
        updateDateTime();
        if (timerId === null) {
            timerId = setInterval(updateDateTime, 1000);
        }
    });
</script>
