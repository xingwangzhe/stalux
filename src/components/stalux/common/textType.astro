---
import { getCollection } from "astro:content";

import { getTypetextsData } from "@utils/config-utils";
import Typewriter from "./Typewriter.astro";

const configEntries = await getCollection("config");
const typetextsConfig = getTypetextsData(configEntries);
---

{typetextsConfig?.items && (
    <Typewriter
        class="stalux-typewriter stalux-u-flex stalux-u-justify-center stalux-u-w-full stalux-u-text-center"
        messages={typetextsConfig?.items}
    />
)}
