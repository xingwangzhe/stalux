---
// @ts-expect-error
import Typewriter from "astro-typewriter";
import { getCollection } from "astro:content";
import styles from "@styles/components/common/textType.module.css";
import { getSiteData, getAuthorData, getHeadData, getNavsData, getLinksData, getCommentData, getFooterData, getPromoteData, getTypetextsData, getMediaLinksData } from "@utils/config-utils";
const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const typetextsConfig = getTypetextsData(configEntries);
---

{
    typetextsConfig?.items && (
        <Typewriter class={styles.typeWriter} messages={typetextsConfig?.items} />
    )
}
