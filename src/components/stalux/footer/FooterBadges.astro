---
import { getCollection } from "astro:content";
import type { BadgeItem, BadgeOptions } from "@utils/badge-generator";
import { generateBadge, isBadgeGroup, svgToDataUrl } from "@utils/badge-generator";
import { getSiteData } from "@utils/config-utils";
import { createTranslator } from "@utils/i18n";

interface Props {
    badges?: BadgeItem[];
}

const { badges } = Astro.props;
const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const { t } = createTranslator(siteConfig.lang || "zh-CN");

function badgeImg(opts: BadgeOptions) {
    const src = svgToDataUrl(generateBadge(opts, Astro.logger));
    const alt = opts.alt || `${opts.label}: ${opts.message}`;
    if (opts.href) {
        return `<a href="${opts.href}" target="_blank" rel="${opts.rel ?? "noopener"}"><img src="${src}" alt="${alt}" class="badge" /></a>`;
    }
    return `<img src="${src}" alt="${alt}" class="badge" />`;
}
---

{badges && badges.length > 0 && (
        <div class="badges-wrapper">
            {badges.map((item: BadgeItem, idx: number) => {
                if (isBadgeGroup(item)) {
                    const groupId = `badge-group-${idx}`;
                    return (
                        <details class="badge-group" id={groupId}>
                            <summary class="badge-group-summary">
                                <span class="badge-group-arrow">&#9654;</span>
                                <span class="badge-group-title">{item.title}</span>
                                <span class="badge-group-hint" data-hint="expanded">{t("footer.collapse")}</span>
                                <span class="badge-group-hint" data-hint="collapsed">{t("footer.expand")}</span>
                            </summary>
                            <div class="badge-group-items badges">
                                {item.items.map((b) => (
                                    <Fragment set:html={badgeImg(b)} />
                                ))}
                            </div>
                        </details>
                    );
                }
                return <Fragment set:html={badgeImg(item)} />;
            })}
        </div>
    )}

<style>
.badges-wrapper {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
}

.badge-group {
    width: 100%;
    border: none;
}

.badge-group-summary {
    cursor: pointer;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.4rem;
    padding: 0.2rem 0;
    color: var(--white-70p);
    font-size: 0.85rem;
    user-select: none;
    list-style: none;
    transition: color 0.2s;
}
.badge-group-summary:hover {
    color: var(--white-70p);
}
.badge-group-summary::-webkit-details-marker {
    display: none;
}

.badge-group-arrow {
    font-size: 0.65rem;
    transition: transform 0.2s;
    display: inline-block;
}
.badge-group[open] .badge-group-arrow {
    transform: rotate(90deg);
}

.badge-group-title {
    color: var(--white-80p);
}

.badge-group-hint {
    font-size: 0.7rem;
    color: var(--white-70p);
}
.badge-group[open] .badge-group-hint[data-hint="collapsed"],
.badge-group:not([open]) .badge-group-hint[data-hint="expanded"] {
    display: none;
}

.badge-group-items {
    padding-top: 0.35rem;
}

.badges {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
}

.badge {
    height: 20px;
    vertical-align: middle;
}

@media (max-width: 768px) {
    .badges {
        gap: 0.3rem;
    }
    .badge {
        height: 18px;
    }
}
</style>
