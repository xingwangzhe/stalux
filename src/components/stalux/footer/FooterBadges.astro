---
import { getCollection } from "astro:content";
import type { BadgeItem, BadgeOptions } from "@utils/badge-generator";
import {
    badgeAssetId,
    createBadgeAssets,
    generateBadge,
    isBadgeGroup,
    svgToDataUrl,
} from "@utils/badge-generator";
import { getFooterData, getSiteData } from "@utils/config-utils";
import { createTranslator } from "@utils/i18n";
import { sitePath } from "@utils/site-path";

interface Props {
    badges?: BadgeItem[];
}

const { badges } = Astro.props;
const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const badgeAssets = createBadgeAssets(getFooterData(configEntries)?.badges);
const { t } = createTranslator(siteConfig.lang || "zh-CN");

function badgeImg(opts: BadgeOptions) {
    const svg = generateBadge(opts, Astro.logger);
    const id = badgeAssetId(svg);
    const src = badgeAssets.has(id)
        ? sitePath(`stalux-assets/badges/${id}.svg`)
        : svgToDataUrl(svg);
    const alt = opts.alt || `${opts.label}: ${opts.message}`;
    const width = svg.match(/<svg\b[^>]*\bwidth="(\d+)"/u)?.[1];
    const height = svg.match(/<svg\b[^>]*\bheight="(\d+)"/u)?.[1];
    const dimensions = width && height ? ` width="${width}" height="${height}"` : "";
    // Closed badge groups should not initialize every SVG document during first paint.
    const img = `<img src="${src}" alt="${alt}" class="stalux-badge" loading="lazy" decoding="async"${dimensions} />`;
    if (opts.href) {
        return `<a href="${opts.href}" target="_blank" rel="${opts.rel ?? "noopener"}">${img}</a>`;
    }
    return img;
}
---

{badges && badges.length > 0 && (
    /* Modern Web Guidance (html): 徽章集合是一组条目 => <ul>/<li>；分组用原生的
       <details>/<summary> 折叠，无需 ARIA 模拟。 */
    <ul class="stalux-badges-wrapper stalux-u-flex stalux-u-items-center stalux-u-justify-center stalux-u-flex-wrap">
        {badges.map((item: BadgeItem, idx: number) => {
            if (isBadgeGroup(item)) {
                const groupId = `badge-group-${idx}`;
                return (
                    <li class="stalux-badge-group-item stalux-u-w-full">
                        <details
                            data-stalux-module="badge-group"
                            class="stalux-badge-group stalux-u-w-full badge-group"
                            id={groupId}
                        >
                            <summary class="stalux-badge-group-summary stalux-u-flex stalux-u-items-center stalux-u-justify-center">
                                <span class="stalux-badge-group-arrow">&#9654;</span>
                                <span class="stalux-badge-group-title">{item.title}</span>
                                <span class="stalux-badge-group-hint" data-hint="expanded">
                                    {t("footer.collapse")}
                                </span>
                                <span class="stalux-badge-group-hint" data-hint="collapsed">
                                    {t("footer.expand")}
                                </span>
                            </summary>
                            <ul class="stalux-badge-group-items stalux-badges stalux-u-flex stalux-u-items-center stalux-u-justify-center stalux-u-flex-wrap">
                                {item.items.map((b) => (
                                    <li>
                                        <Fragment set:html={badgeImg(b)} />
                                    </li>
                                ))}
                            </ul>
                        </details>
                    </li>
                );
            }
            return (
                <li>
                    <Fragment set:html={badgeImg(item)} />
                </li>
            );
        })}
    </ul>
)}
