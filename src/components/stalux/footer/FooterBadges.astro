---
import { getCollection } from "astro:content";
import type { BadgeItem, BadgeOptions } from "@utils/badge-generator";
import { generateBadge, isBadgeGroup, svgToDataUrl } from "@utils/badge-generator";
import { getSiteData } from "@utils/config-utils";
import { createTranslator } from "@utils/i18n";

interface Props {
    badges?: BadgeItem[];
}

const { badges } = Astro.props;
const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const { t } = createTranslator(siteConfig.lang || "zh-CN");

function badgeImg(opts: BadgeOptions) {
    const svg = generateBadge(opts, Astro.logger);
    const src = svgToDataUrl(svg);
    const alt = opts.alt || `${opts.label}: ${opts.message}`;
    const width = svg.match(/<svg\b[^>]*\bwidth="(\d+)"/)?.[1];
    const height = svg.match(/<svg\b[^>]*\bheight="(\d+)"/)?.[1];
    const dimensions = width && height ? ` width="${width}" height="${height}"` : "";
    // Closed badge groups should not initialize every SVG document during first paint.
    const img = `<img src="${src}" alt="${alt}" class="stalux-badge" loading="lazy" decoding="async"${dimensions} />`;
    if (opts.href) {
        return `<a href="${opts.href}" target="_blank" rel="${opts.rel ?? "noopener"}">${img}</a>`;
    }
    return img;
}
---

{badges && badges.length > 0 && (
    <div class="stalux-badges-wrapper">
        {badges.map((item: BadgeItem, idx: number) => {
            if (isBadgeGroup(item)) {
                const groupId = `badge-group-${idx}`;
                return (
                    <details class="stalux-badge-group badge-group" id={groupId}>
                        <summary class="stalux-badge-group-summary">
                            <span class="stalux-badge-group-arrow">&#9654;</span>
                            <span class="stalux-badge-group-title">{item.title}</span>
                            <span class="stalux-badge-group-hint" data-hint="expanded">
                                {t("footer.collapse")}
                            </span>
                            <span class="stalux-badge-group-hint" data-hint="collapsed">
                                {t("footer.expand")}
                            </span>
                        </summary>
                        <div class="stalux-badge-group-items stalux-badges">
                            {item.items.map((b) => (
                                <Fragment set:html={badgeImg(b)} />
                            ))}
                        </div>
                    </details>
                );
            }
            return <Fragment set:html={badgeImg(item)} />;
        })}
    </div>
)}
