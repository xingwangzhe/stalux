---
import { getCollection } from "astro:content";
import { createTranslator } from "@utils/i18n";

interface Props {
    showStats?: boolean;
    wordCount?: string;
    buildtime?: string;
}

const stalux = (await getCollection("config"))[0]?.data ?? {};
const { t } = createTranslator(stalux.lang || "zh-CN");
const { showStats = true, wordCount, buildtime } = Astro.props;
---

{
    showStats && (
        <div class="site-stats">
            <span id="vercount_container_site_uv">
                {t("footer.visitors")}<span id="vercount_value_site_uv">Loading...</span>{" "}
                {t("footer.visits")}
            </span>
            <span class="stats-separator">|</span>
            <span id="vercount_container_site_pv">
                {t("footer.totalVisits")}
                <span id="vercount_value_site_pv">Loading...</span> {t("footer.times")}
            </span>
            <span class="stats-separator">|</span>
            <span id="word-count-container">
                {t("footer.totalWords")}
                <span id="word-count-value">
                    {wordCount ?? "Loading..."}
                </span>{" "}
                {t("footer.chars")}
            </span>
        </div>
    )
}

{
    buildtime && (
        <div class="site-build-time">
            <span>
                {t("footer.runningTime")}
                <span id="runtime-counter" />
            </span>
        </div>
    )
}

<script define:vars={{ buildtime, runtimeFormat: t("footer.runtimeFormat") }}>
    document.addEventListener("astro:page-load", () => {
        if (!buildtime) return;
        const runtimeCounter = document.getElementById("runtime-counter");
        if (!runtimeCounter) return;

        const updateRuntime = () => {
            const now = new Date();
            const start = new Date(buildtime);
            const diffMs = now.getTime() - start.getTime();
            if (Number.isNaN(diffMs) || diffMs < 0) return;

            const totalSeconds = Math.floor(diffMs / 1000);
            const days = Math.floor(totalSeconds / 86400);
            const hours = Math.floor((totalSeconds % 86400) / 3600);
            const minutes = Math.floor((totalSeconds % 3600) / 60);
            const seconds = totalSeconds % 60;

            runtimeCounter.textContent = runtimeFormat
                .replace("{days}", String(days))
                .replace("{hours}", String(hours))
                .replace("{minutes}", String(minutes))
                .replace("{seconds}", String(seconds));
        };

        updateRuntime();
        // define:vars 内联脚本会在每次视图切换时重新执行，
        // 因此用 window 句柄记录定时器，创建新定时器前先清掉旧的，避免累加 1Hz 定时器。
        const w = window as unknown as { __staluxRuntimeTimer?: ReturnType<typeof setInterval> };
        if (w.__staluxRuntimeTimer != null) {
            clearInterval(w.__staluxRuntimeTimer);
        }
        w.__staluxRuntimeTimer = setInterval(updateRuntime, 1000);
    });
</script>

<style>
    .site-stats {
        display: flex;
        justify-content: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        font-size: 0.9rem;
    }

    .stats-separator {
        color: rgba(255, 255, 255, 0.5);
    }

    .site-build-time {
        margin-top: 0.5rem;
        font-size: 0.9rem;
        color: rgba(255, 255, 255, 0.8);
        text-align: center;
    }
</style>
