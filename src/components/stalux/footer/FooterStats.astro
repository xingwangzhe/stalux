---
import { getCollection } from "astro:content";
import { getSiteData } from "@utils/config-utils";
import { createTranslator } from "@utils/i18n";

interface Props {
    showStats?: boolean;
    wordCount?: string;
    buildtime?: string;
}

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const { t } = createTranslator(siteConfig.lang || "zh-CN");
const { showStats = true, wordCount, buildtime } = Astro.props;
---

{showStats && (
    <p class="stalux-stats-site-stats stalux-u-flex stalux-u-justify-center stalux-u-flex-wrap">
        <span id="vercount_container_site_uv">
            {t("footer.visitors")}
            <span id="vercount_value_site_uv">Loading...</span> {t("footer.visits")}
        </span>
        <span class="stalux-stats-stats-separator">|</span>
        <span id="vercount_container_site_pv">
            {t("footer.totalVisits")}
            <span id="vercount_value_site_pv">Loading...</span> {t("footer.times")}
        </span>
        <span class="stalux-stats-stats-separator">|</span>
        <span id="word-count-container">
            {t("footer.totalWords")}
            <span id="word-count-value">{wordCount ?? "Loading..."}</span> {t("footer.chars")}
        </span>
    </p>
)}

{buildtime && (
    <div
        class="stalux-stats-site-build-time stalux-u-text-center"
        data-stalux-buildtime={buildtime}
        data-stalux-runtime-format={t("footer.runtimeFormat")}
    >
        <span>
            {t("footer.runningTime")}
            <span id="runtime-counter" />
        </span>
    </div>
)}
