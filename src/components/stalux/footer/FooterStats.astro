---
import { getCollection } from "astro:content";
import { getSiteData } from "@utils/config-utils";
import { createTranslator } from "@utils/i18n";

interface Props {
    showStats?: boolean;
    wordCount?: string;
    buildtime?: string;
}

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const { t } = createTranslator(siteConfig.lang || "zh-CN");
const { showStats = true, wordCount, buildtime } = Astro.props;
---

{showStats && (
        <p class="site-stats">
            <span id="vercount_container_site_uv">
                {t("footer.visitors")}<span id="vercount_value_site_uv">Loading...</span>{" "}
                {t("footer.visits")}
            </span>
            <span class="stats-separator">|</span>
            <span id="vercount_container_site_pv">
                {t("footer.totalVisits")}
                <span id="vercount_value_site_pv">Loading...</span> {t("footer.times")}
            </span>
            <span class="stats-separator">|</span>
            <span id="word-count-container">
                {t("footer.totalWords")}
                <span id="word-count-value">
                    {wordCount ?? "Loading..."}
                </span>{" "}
                {t("footer.chars")}
            </span>
        </p>
    )}

{buildtime && (
        <div class="site-build-time" data-stalux-buildtime={buildtime} data-stalux-runtime-format={t("footer.runtimeFormat")}>
            <span>
                {t("footer.runningTime")}
                <span id="runtime-counter" />
            </span>
        </div>
    )}

<style>
.site-stats {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: 0.9rem;
}

.stats-separator {
    color: rgba(255, 255, 255, 0.5);
}

.site-build-time {
    margin-top: 0.5rem;
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.8);
    text-align: center;
}
</style>
