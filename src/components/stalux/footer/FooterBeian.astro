---
import { getCollection } from "astro:content";
import { getSiteData } from "@utils/config-utils";
import { createTranslator } from "@utils/i18n";

interface Props {
    icp?: string;
    pubsec?: string;
    pubsecNumber?: string;
}

const { icp, pubsec, pubsecNumber } = Astro.props;

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const { t } = createTranslator(siteConfig.lang || "zh-CN");

const showBeian = !!(icp || pubsec);
---

{showBeian && (
    <div class="stalux-beian-beian-info stalux-u-flex stalux-u-justify-center stalux-u-flex-wrap">
        {icp && (
            <a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer">
                {icp}
            </a>
        )}
        {pubsec && pubsecNumber && (
            <a
                href={`http://www.beian.gov.cn/portal/registerSystemInfo?recordcode=${pubsecNumber}`}
                target="_blank"
                rel="noopener noreferrer"
                class="stalux-beian-public-security-beian stalux-u-items-center"
            >
                <img
                    src="https://beian.mps.gov.cn/img/logo01.dd7ff50e.png"
                    alt={t("footer.securityIcon")}
                />
                {pubsec}
            </a>
        )}
    </div>
)}
