---
import { getCollection } from "astro:content";
import { createTranslator } from "@utils/i18n";
import { getSiteData, getAuthorData, getHeadData, getNavsData, getLinksData, getCommentData, getFooterData, getPromoteData, getTypetextsData, getMediaLinksData } from "@utils/config-utils";

interface Props {
    author?: string;
    startYear?: number;
}

const props = Astro.props as Props;

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const { t } = createTranslator(siteConfig.lang || "zh-CN");

const currentYear = new Date().getFullYear();
const copyrightYear =
    props.startYear && props.startYear < currentYear
        ? `${props.startYear}-${currentYear}`
        : currentYear;
---

<small class="copyright">
    <span>&copy; {copyrightYear} {props.author || ""}. {t("footer.rightsReserved")}</span>
</small>

<style>
    .copyright {
        font-weight: 500;
        display: flex;
        gap: 0.3em;
        justify-content: center;
        flex-wrap: wrap;
    }

    .copyright span {
        margin: 0;
    }
</style>
