---
import { getCollection } from "astro:content";
import { createTranslator } from "@utils/i18n";

interface Props {
    author?: string;
    startYear?: number;
}

const props = Astro.props as Props;

const stalux = (await getCollection("config"))[0]?.data ?? {};
const { t } = createTranslator(stalux.lang || "zh-CN");

const currentYear = new Date().getFullYear();
const copyrightYear =
    props.startYear && props.startYear < currentYear
        ? `${props.startYear}-${currentYear}`
        : currentYear;
---

<div class="copyright">
    <span>&copy; {copyrightYear} {props.author || ""}. {t("footer.rightsReserved")}</span>
</div>

<style>
    .copyright {
        font-weight: 500;
        display: flex;
        gap: 0.3em;
        justify-content: center;
        flex-wrap: wrap;
    }

    .copyright span {
        margin: 0;
    }
</style>
