---
import "../../../styles/generated-prose.css";
import "../../../styles/generated-words.css";
import type { CollectionEntry } from "astro:content";
import { render } from "astro:content";

import { Quote } from "@lucide/astro";
import { toMachineDateTime } from "@utils/semantic-time";

interface Props {
    entry: CollectionEntry<"words">;
    timezone?: string;
}

const { entry, timezone } = Astro.props;
const { Content } = await render(entry);
const { source, link, sourceDate, date, abbrlink } = entry.data;

const machineDate = date && timezone ? toMachineDateTime(date, timezone) : date;
---

<article
    data-stalux-module="word"
    class="stalux-word-card"
    id={abbrlink ? `word-${abbrlink}` : undefined}
>
    <Quote class="stalux-word-mark" size={28} stroke-width={1.4} aria-hidden="true" />
    <div class="stalux-word-body stalux-prose" data-pagefind-body>
        <Content />
    </div>
    {(date || source || sourceDate || abbrlink) && (
        <footer class="stalux-word-footer">
            {abbrlink ? (
                <a
                    href={`#word-${abbrlink}`}
                    class="stalux-word-permalink a-none"
                    data-word-hash={`#word-${abbrlink}`}
                    aria-label={`Jump to ${abbrlink}`}
                >
                    {date ? <time datetime={machineDate}>{date}</time> : "#"}
                </a>
            ) : date ? (
                <time class="stalux-word-date" datetime={machineDate}>
                    {date}
                </time>
            ) : (
                <span />
            )}
            {(source || sourceDate) && (
                <div class="stalux-word-source-meta">
                    {sourceDate && <span class="stalux-word-source-date">{sourceDate}</span>}
                    {source &&
                        (link ? (
                            <a
                                href={link}
                                target="_blank"
                                rel="noopener noreferrer"
                                class="stalux-word-source-link"
                            >
                                — {source}
                            </a>
                        ) : (
                            <span class="stalux-word-source-text">— {source}</span>
                        ))}
                </div>
            )}
        </footer>
    )}
</article>
