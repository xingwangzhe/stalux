---
import type { CollectionEntry } from "astro:content";
import WordCard from "@components/stalux/words/wordCard.astro";
import styles from "@styles/components/words/wordList.module.css";
import { toTimestamp } from "@utils/dayjs";

interface Props {
    entries: CollectionEntry<"words">[];
    timezone?: string;
}

const { entries, timezone } = Astro.props;

const sorted = [...entries].sort((a, b) => {
    const ta = toTimestamp(a.data.date || a.id);
    const tb = toTimestamp(b.data.date || b.id);
    return tb - ta;
});
---

<ul class={`${styles.list} stagger-children`}>
    {sorted.map((entry) => {
            const hash = entry.data.abbrlink ? `#word-${entry.data.abbrlink}` : undefined;
            return (
                <li class={styles.item}>
                    {hash ? (
                        <a
                            href={hash}
                            class="a-none"
                            data-word-hash={hash}
                            aria-label={`Jump to ${entry.data.abbrlink}`}
                        >
                            <WordCard entry={entry} timezone={timezone} />
                        </a>
                    ) : (
                        <WordCard entry={entry} timezone={timezone} />
                    )}
                </li>
            );
        })}
</ul>

<script src="../../../scripts/word-list.ts"></script>
