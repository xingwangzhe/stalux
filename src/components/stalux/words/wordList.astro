---
import "../../../styles/generated-words.css";
import type { CollectionEntry } from "astro:content";
import WordCard from "@components/stalux/words/wordCard.astro";

import { toTimestamp } from "@utils/dayjs";

interface Props {
    entries: CollectionEntry<"words">[];
    timezone?: string;
}

const { entries, timezone } = Astro.props;

const sorted = [...entries].sort((a, b) => {
    const ta = toTimestamp(a.data.date || a.id, timezone);
    const tb = toTimestamp(b.data.date || b.id, timezone);
    return tb - ta;
});
---

<ul
    class="stalux-word-list-list"
    data-stalux-motion-content
    data-stalux-motion-stage
    data-stalux-reveal
>
    {sorted.map((entry) => {
        return (
            <li class="stalux-word-list-item" data-stalux-reveal-item>
                <WordCard entry={entry} timezone={timezone} />
            </li>
        );
    })}
</ul>

<script src="../../../scripts/word-list.ts"></script>
