---
import WordCard from "@components/stalux/words/wordCard.astro";
import styles from "@styles/components/words/wordList.module.css";
import type { CollectionEntry } from "astro:content";
import { toTimestamp } from "@utils/dayjs";

interface Props {
    entries: CollectionEntry<"words">[];
    timezone?: string;
}

const { entries, timezone } = Astro.props;

const sorted = [...entries].sort((a, b) => {
    const ta = toTimestamp(a.data.date || a.id);
    const tb = toTimestamp(b.data.date || b.id);
    return tb - ta;
});
---

<ul class={`${styles.list} stagger-children`}>
    {
        sorted.map((entry) => {
            const hash = entry.data.abbrlink ? `#word-${entry.data.abbrlink}` : undefined;
            return (
                <li class={styles.item}>
                    {hash ? (
                        <a href={hash} class="a-none" data-word-hash={hash}>
                            <WordCard entry={entry} timezone={timezone} />
                        </a>
                    ) : (
                        <WordCard entry={entry} timezone={timezone} />
                    )}
                </li>
            );
        })
    }
</ul>

<script>
    function scrollToWord(hash) {
        const el = document.getElementById(hash.slice(1));
        if (el) {
            el.scrollIntoView({ behavior: "smooth", block: "center" });
            history.replaceState(null, "", hash);
        }
    }

    // 页面加载时：覆盖浏览器默认的瞬间跳转
    if (location.hash.startsWith("#word-")) {
        // 先让浏览器稳住位置，再执行居中滚动
        requestAnimationFrame(() => {
            requestAnimationFrame(() => {
                scrollToWord(location.hash);
            });
        });
    }

    // 点击卡片时：阻止默认跳转，改为居中平滑滚动
    document.addEventListener("click", (e) => {
        const link = e.target.closest("a[data-word-hash]");
        if (!link) return;
        e.preventDefault();
        scrollToWord(link.getAttribute("data-word-hash"));
    });
</script>
