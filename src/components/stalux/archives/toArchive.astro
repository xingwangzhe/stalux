---
import { getCollection } from "astro:content";

import { getSiteData } from "@utils/config-utils";
import { createTranslator } from "@utils/i18n";

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const { t } = createTranslator(siteConfig.lang || "zh-CN");
---

<!-- Modern Web Guidance (html): 一行“查看全部归档”文字 + 链接 => <p>。 -->
<p id={"stalux-to-archive-archs"}>
    <a data-stalux-control="button" href="/archives" data-astro-prefetch>{t("archives.viewAll")}</a>
</p>
