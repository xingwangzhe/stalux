---
import "../../../styles/generated-archives.css";
import { type CollectionEntry, getCollection } from "astro:content";

import { getSiteData } from "@utils/config-utils";
import { format, parseDate, toTimestamp } from "@utils/dayjs";
import { createTranslator } from "@utils/i18n";

interface Props {
    posts?: CollectionEntry<"posts">[];
}

const props = Astro.props as Props;
const posts = props.posts ?? (await getCollection("posts", ({ data }) => !data.draft));

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const { t } = createTranslator(siteConfig.lang || "zh-CN");
const archivesByYearMonth = new Map<number, Map<number, CollectionEntry<"posts">[]>>();

posts.forEach((post) => {
    if (!post.data.date) return;
    const date = parseDate(post.data.date);
    const year = date.getUTCFullYear();
    const month = date.getUTCMonth() + 1;
    const months = archivesByYearMonth.get(year) ?? new Map();
    const monthPosts = months.get(month) ?? [];
    monthPosts.push(post);
    months.set(month, monthPosts);
    archivesByYearMonth.set(year, months);
});

// 每个 post 只解析一次时间，供排序比较器复用，避免比较器里反复 new Date()
const tsCache = new Map<CollectionEntry<"posts">, number>(
    posts.map((p) => [p, toTimestamp(p.data.date || 0)]),
);

// 对每个月内的文章按 date 字段降序排序（用缓存时间戳做纯数字比较）
for (const months of archivesByYearMonth.values()) {
    for (const monthPosts of months.values()) {
        monthPosts.sort((a, b) => (tsCache.get(b) ?? 0) - (tsCache.get(a) ?? 0));
    }
}

const archiveYears = [...archivesByYearMonth.entries()]
    .sort(([left], [right]) => right - left)
    .map(([year, months]) => ({
        year,
        count: [...months.values()].reduce((total, monthPosts) => total + monthPosts.length, 0),
        months: [...months.entries()]
            .sort(([left], [right]) => right - left)
            .map(([month, monthPosts]) => ({ month, posts: monthPosts })),
    }));
---

<section class="stalux-archive-container">
    <div class="stalux-archive-page-header">
        <div class="stalux-archive-timeline-container">
            {archiveYears.length > 0 ? (
    archiveYears.map((archiveYear) => (
        <div class="stalux-archive-year-section" data-year={String(archiveYear.year)}>
            <div class="stalux-archive-year-header">
                <h2 class="stalux-archive-year-title">{archiveYear.year}</h2>
                <div class="stalux-archive-year-count">
                    {t("archives.postCount", { n: archiveYear.count })}
                </div>
            </div>
            {archiveYear.months.map(({ month, posts: monthPosts }) => (
                <div
                    class="stalux-archive-month-section"
                    style={{
                        "--archive-estimate": `${Math.ceil(monthPosts.length / 12) * 12 * 48 + 40}px`,
                    }}
                >
                    <h3 class="stalux-archive-month-title">{t("archives.month", { n: month })}</h3>
                    {Array.from({ length: Math.ceil(monthPosts.length / 12) }, (_, index) =>
                        monthPosts.slice(index * 12, (index + 1) * 12),
                    ).map((group) => (
                        <ul
                            class="stalux-archive-post-list"
                            style={{ "--archive-group-estimate": `${group.length * 48}px` }}
                        >
                            {group.map((post) => (
                                <li class="stalux-archive-post-item">
                                    <time
                                        class="stalux-archive-post-date"
                                        datetime={post.data.date}
                                    >
                                        {format(parseDate(post.data.date), "yyyy-MM-dd")}
                                    </time>
                                    <a
                                        href={`/posts/${post.data.abbrlink}/`}
                                        class="stalux-archive-post-link"
                                        data-astro-prefetch="viewport"
                                    >
                                        {post.data.title}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    ))}
                </div>
            ))}
        </div>
    ))
) : (
    <div class="stalux-archive-no-posts">{t("archives.noPosts")}</div>
)}
        </div>

        <slot name="main" />
    </div>
</section>
