---
import "../../../styles/generated-archives.css";
import { type CollectionEntry, getCollection } from "astro:content";

import { getSiteData } from "@utils/config-utils";
import { formatInTimeZone, parseDate, zonedCalendarParts } from "@utils/dayjs";
import { createTranslator } from "@utils/i18n";

interface Props {
    posts?: CollectionEntry<"posts">[];
}

const props = Astro.props as Props;
const posts = props.posts ?? (await getCollection("posts", ({ data }) => !data.draft));

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const { t } = createTranslator(siteConfig.lang || "zh-CN");
// 归档按“站点时区的日历”分组：无时区的 date 串按站点时区解析，
// 分组也按站点时区取年月，构建机器时区（UTC CI）不再影响归档归属。
const timezone = siteConfig.timezone || "Asia/Shanghai";
type ArchivePost = { post: CollectionEntry<"posts">; date: Date };
const archivesByYearMonth = new Map<number, Map<number, ArchivePost[]>>();

for (const post of posts) {
    if (!post.data.date) continue;
    const date = parseDate(post.data.date, timezone);
    const { year, month } = zonedCalendarParts(date, timezone);
    const months = archivesByYearMonth.get(year) ?? new Map();
    const monthPosts = months.get(month) ?? [];
    monthPosts.push({ post, date });
    months.set(month, monthPosts);
    archivesByYearMonth.set(year, months);
}

for (const months of archivesByYearMonth.values()) {
    for (const monthPosts of months.values()) {
        monthPosts.sort((a, b) => b.date.getTime() - a.date.getTime());
    }
}

const archiveYears = [...archivesByYearMonth.entries()]
    .sort(([left], [right]) => right - left)
    .map(([year, months]) => ({
        year,
        count: [...months.values()].reduce((total, monthPosts) => total + monthPosts.length, 0),
        months: [...months.entries()]
            .sort(([left], [right]) => right - left)
            .map(([month, monthPosts]) => ({ month, posts: monthPosts })),
    }));
---

<section class="stalux-archive-container" data-stalux-motion-content data-stalux-motion-stage>
    <!-- Modern Web Guidance (html): 年份/月份是带标题的内容分组 => <section> + <header>；
         文章条目用 <ul>/<li>；计数与空态是纯文字 => <p>。
         仅剩的 <div> 是时间轴装饰容器（::before 画线 + --tl-* 变量），没有语义对等元素。 -->
    <div class="stalux-archive-timeline-container stalux-archive-page-header">
        {archiveYears.length > 0 ? (
            archiveYears.map((archiveYear) => (
                <section class="stalux-archive-year-section" data-year={String(archiveYear.year)}>
                    <header class="stalux-archive-year-header">
                        <h2 class="stalux-archive-year-title">{archiveYear.year}</h2>
                        <p class="stalux-archive-year-count">
                            {t("archives.postCount", { n: archiveYear.count })}
                        </p>
                    </header>
                    {archiveYear.months.map(({ month, posts: monthPosts }) => (
                        <section class="stalux-archive-month-section" data-archive-month>
                            <h3 class="stalux-archive-month-title">
                                {t("archives.month", { n: month })}
                            </h3>
                            {Array.from({ length: Math.ceil(monthPosts.length / 12) }, (_, index) =>
                                monthPosts.slice(index * 12, (index + 1) * 12),
                            ).map((group) => (
                                <ul class="stalux-archive-post-list" data-stalux-reveal>
                                    {group.map(({ post, date }) => (
                                        <li
                                            class="stalux-archive-post-item"
                                            data-stalux-reveal-item
                                        >
                                            <time
                                                class="stalux-archive-post-date"
                                                datetime={formatInTimeZone(
                                                    date,
                                                    timezone,
                                                    "yyyy-MM-dd'T'HH:mm:ssXXX",
                                                )}
                                            >
                                                {formatInTimeZone(date, timezone, "yyyy-MM-dd")}
                                            </time>
                                            <a
                                                href={`/posts/${post.data.abbrlink}`}
                                                class="stalux-archive-post-link"
                                                data-archive-description={post.data.desc || ""}
                                            >
                                                {post.data.title}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            ))}
                        </section>
                    ))}
                </section>
            ))
        ) : (
            <p class="stalux-archive-no-posts">{t("archives.noPosts")}</p>
        )}

        <slot name="main" />
    </div>
</section>
<p
    id="stalux-archive-description"
    class="stalux-archive-description"
    data-archive-tooltip
    role="tooltip"
    hidden
></p>

<script>
import { mountArchiveDescriptions } from "../../../scripts/archive-descriptions";
import { mountListReveal } from "../../../scripts/list-reveal";
import { registerPageLifecycle } from "../../../scripts/page-runtime";

registerPageLifecycle("archive-descriptions", mountArchiveDescriptions);
// The archive cascade ships only with the archive markup it animates.
registerPageLifecycle("list-reveal", mountListReveal);
</script>
