---
import { getCollection, type CollectionEntry } from "astro:content";
import { createTranslator } from "@utils/i18n";
import styles from "@styles/components/archives/archivesList.module.css";
import { toTimestamp, parseDate, format } from "@utils/dayjs";

interface Props {
    posts?: CollectionEntry<"posts">[];
}

const props = Astro.props as Props;
const posts = props.posts ?? (await getCollection("posts", ({ data }) => !data.draft));

const stalux = (await getCollection("config"))[0].data;
const { t } = createTranslator(stalux.lang || "zh-CN");
const archivesByYearMonth: Record<
    number,
    Record<number, CollectionEntry<"posts">[]>
> = {};
const yearCounts: Record<number, number> = {};

posts.forEach((post) => {
    if (!post.data.date) return;
    const date = parseDate(post.data.date);
    const year = date.getUTCFullYear();
    const month = date.getUTCMonth() + 1;
    if (!archivesByYearMonth[year]) {
        archivesByYearMonth[year] = {};
        yearCounts[year] = 0;
    }
    if (!archivesByYearMonth[year][month]) {
        archivesByYearMonth[year][month] = [];
    }
    archivesByYearMonth[year][month].push(post);
    yearCounts[year] += 1;
});

// 对每个月内的文章按 date 字段降序排序
Object.keys(archivesByYearMonth).forEach((year) => {
    Object.keys(archivesByYearMonth[Number(year)]).forEach((month) => {
        archivesByYearMonth[Number(year)][Number(month)].sort((a, b) => {
            const da = toTimestamp(a.data.date || 0);
            const db = toTimestamp(b.data.date || 0);
            return db - da;
        });
    });
});

// 按年份降序排序 -
const sortedYears = Object.keys(archivesByYearMonth)
    .map(Number)
    .sort((a: number, b: number) => b - a);
---

<div class={styles.archivesContainer}>
    <div class={styles.pageHeader}>
        <div class={styles.timelineContainer}>
            {
                sortedYears.length > 0 ? (
                    sortedYears.map((year, yi) => (
                        <div
                            class={styles.yearSection}
                            data-year={String(year)}
                            style={yi >= 2 ? "display:none" : ""}
                        >
                            <div class={styles.yearHeader} data-year-header style="opacity:0">
                                <h2 class={styles.yearTitle}>{year}</h2>
                                <div class={styles.yearCount}>
                                    {t("archives.postCount", { n: yearCounts[year] ?? 0 })}
                                </div>
                            </div>
                            {Object.keys(archivesByYearMonth[year])
                                .map(Number)
                                .sort((a, b) => b - a)
                                .map((month) => (
                                    <div class={styles.monthSection} data-month-section style="opacity:0">
                                        <h3 class={styles.monthTitle}>
                                            {t("archives.month", { n: month })}
                                        </h3>
                                        <ul class={styles.postList}>
                                            {archivesByYearMonth[year][
                                                month
                                            ].map((post) => (
                                                <li class={styles.postItem} data-post-item style="opacity:0">
                                                    <time
                                                        class={styles.postDate}
                                                        datetime={post.data.date}
                                                    >
                                                        {format(parseDate(post.data.date), 'yyyy-MM-dd')}
                                                    </time>
                                                    <a
                                                        href={`/posts/${post.data.abbrlink}/`}
                                                        class={styles.postLink}
                                                    >
                                                        {post.data.title}
                                                    </a>
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                ))}
                        </div>
                    ))
                ) : (
                    <div class={styles.noPosts}>{t("archives.noPosts")}</div>
                )
            }
        </div>

        <!-- 懒加载指示器 -->
        <div
            id="lazyload-observer"
            class={styles.lazyloadObserver}
            style="display:none"
        >
            <div class={styles.loadingSpinner} data-loading-spinner>
                <span class="dot"></span>
                <span class="dot"></span>
                <span class="dot"></span>
            </div>
            <div class={styles.loadingText} data-loading-text>{t("archives.loadMore")}</div>
        </div>
        <slot name="main" />
    </div>

    <script define:vars={{ allLoadedText: t("archives.allLoaded") }}>
        document.addEventListener("astro:page-load", () => {
            const archivesRoot = document.querySelector<HTMLElement>("[data-year]")?.parentElement;
            if (archivesRoot && (archivesRoot as HTMLElement).dataset.archivesInited === "1") return;
            if (archivesRoot) (archivesRoot as HTMLElement).dataset.archivesInited = "1";

            let visibleYears = 2;
            const yearSections = document.querySelectorAll<HTMLElement>("[data-year]");
            const totalYears = yearSections.length;
            const lazyloadObserver = document.getElementById("lazyload-observer");

            if (lazyloadObserver) {
                lazyloadObserver.style.display = totalYears > visibleYears ? "flex" : "none";
            }

            const updateLoadingIndicator = (isComplete: boolean) => {
                if (!lazyloadObserver) return;
                const lt = lazyloadObserver.querySelector("[data-loading-text]") as HTMLElement;
                const ls = lazyloadObserver.querySelector("[data-loading-spinner]") as HTMLElement;
                if (isComplete) {
                    if (lt) lt.textContent = allLoadedText;
                    if (ls) ls.style.display = "none";
                    setTimeout(() => {
                        lazyloadObserver!.style.opacity = "0";
                        setTimeout(() => { lazyloadObserver!.style.display = "none"; }, 500);
                    }, 3000);
                }
            };

            // 初始显示前 2 年，其余隐藏（CSS 动画自动处理入场）
            for (let i = 0; i < totalYears; i++) {
                if (i < visibleYears) {
                    yearSections[i].style.display = "block";
                } else {
                    yearSections[i].style.display = "none";
                }
            }
            if (totalYears <= visibleYears) updateLoadingIndicator(true);

            const observer = new IntersectionObserver(
                (entries) => {
                    entries.forEach(e => {
                        if (e.isIntersecting && visibleYears < totalYears) {
                            setTimeout(() => {
                                yearSections[visibleYears].style.display = "block";
                                visibleYears++;
                                if (visibleYears >= totalYears) updateLoadingIndicator(true);
                            }, 450);
                        }
                    });
                },
                { rootMargin: "300px", threshold: 0.1 },
            );
            if (lazyloadObserver) observer.observe(lazyloadObserver);
        });
    </script>
</div>
