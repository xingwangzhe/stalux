---
import ListPage from "@components/stalux/layout/listPage.astro";
import WordList from "@components/stalux/words/wordList.astro";
import { getCollection } from "astro:content";

const entries = await getCollection("words", ({ data }) => !data.draft);
---

<ListPage
    title="一言"
    description="收集的语录与短句"
    heading="一言"
    subheading={`只言片语，皆为心声（共 ${entries.length} 条）`}
>
    <WordList entries={entries} />
</ListPage>
