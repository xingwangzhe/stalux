---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Navs from "@components/stalux/layout/navs.astro";
import { getRuntimeCacheKey } from "@internal/runtime-cache-key";
import PostLayout from "@layouts/PostLayout.astro";
import Stalux from "@layouts/Stalux.astro";
import { analyzeFeatureFlags } from "@plugins/feature-flags";
import { getAuthorData, getSiteData } from "@utils/config-utils";
import { getPostContentIndex } from "@utils/content-index";

interface Props {
    post: CollectionEntry<"posts">;
    prev?: { url: string; title: string };
    next?: { url: string; title: string };
}
const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const authorConfig = getAuthorData(configEntries);
const props = Astro.props as Props;
const { Content, headings } = await render(props.post);

// 文章统计完全由 Sätteri AST 分析，不读取 render metadata。
const flags = await analyzeFeatureFlags(props.post.body);
const autoDesc = props.post.data.desc || "";

export async function getStaticPaths() {
    const index = await getPostContentIndex();
    return index.posts.map((post) => {
        const { previous: prevPost, next: nextPost } =
            index.neighbors.get(String(post.data.abbrlink)) ?? {};
        // 增量构建 cacheKey：含自身与 prev/next 的更新时间，
        // 任一邻居变化（文章新增/编辑导致前后链接变化）时本页也会失效重渲染
        const cacheKey = [
            post.data.updated ?? post.data.date,
            prevPost ? (prevPost.data.updated ?? prevPost.data.date) : "",
            nextPost ? (nextPost.data.updated ?? nextPost.data.date) : "",
            getRuntimeCacheKey(),
        ].join("|");
        return {
            params: { post: post.data.abbrlink },
            cacheKey,
            props: {
                post,
                prev: prevPost
                    ? { url: `/posts/${prevPost.data.abbrlink}`, title: prevPost.data.title }
                    : undefined,
                next: nextPost
                    ? { url: `/posts/${nextPost.data.abbrlink}`, title: nextPost.data.title }
                    : undefined,
            },
        };
    });
}
---

<Stalux
    title={`${props.post.data.title} | ${siteConfig.title}`}
    description={autoDesc}
    cover={props.post.data.cover}
    isArticle={true}
    date={props.post.data.date}
    updated={props.post.data.updated}
    tags={props.post.data.tags}
    categories={props.post.data.categories}
    author={authorConfig.name}
>
    <div style="height:3em"></div>
    <Navs />
    <div style="height:3em"></div>
    <PostLayout
        title={props.post.data.title}
        date={props.post.data.date}
        updated={props.post.data.updated}
        readingMinutes={flags.readingMinutes}
        tags={props.post.data.tags||[]}
        categories={props.post.data.categories||[]}
        headings={headings}
        author={authorConfig.name}
        authorAvatar={authorConfig.avatar}
        prev={props.prev}
        next={props.next}
        cc={props.post.data.cc}
        wordCount={flags.wordCount}
        hasImage={flags.hasImage}
    >
        <Content />
    </PostLayout>
</Stalux>
