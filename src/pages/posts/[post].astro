---
import Stalux from "@layouts/Stalux.astro";
import PostLayout from "@layouts/PostLayout.astro";
import { getCollection, type CollectionEntry, render } from "astro:content";
import { toTimestamp } from "@utils/dayjs";
import Navs from "@components/stalux/layout/navs.astro";
import { getSiteData, getAuthorData, getHeadData, getNavsData, getLinksData, getCommentData, getFooterData, getPromoteData, getTypetextsData, getMediaLinksData } from "@utils/config-utils";
interface Props {
    post: CollectionEntry<"posts">;
    prev?: { url: string; title: string };
    next?: { url: string; title: string };
}
const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const authorConfig = getAuthorData(configEntries);
const props = Astro.props as Props;
const { Content, headings, remarkPluginFrontmatter } = await render(props.post);

// 从 remarkPluginFrontmatter 读取 feature flags 和字数统计（由 satteri 插件在构建时写入）
const flags = {
    hasImage: remarkPluginFrontmatter?.hasImage ?? false,
};

// 字数统计直接从 frontmatter 读取
const minutesRead = (remarkPluginFrontmatter?.minutesRead as string) ?? "";
const readingMinutes = (remarkPluginFrontmatter?.readingMinutes as number) ?? 0;
const wordCount = (remarkPluginFrontmatter?.wordCount as number) ?? 0;
// desc 可能为空字符串，需用 || 做“空串回退”，不能用 ??（?? 会把 "" 当作有效值）
const autoDesc = props.post.data.desc || (remarkPluginFrontmatter?.desc as string) || "";

export async function getStaticPaths() {
    const posts = await getCollection("posts", ({ data }) => !data.draft);
    const sorted = posts.sort((a,b) => toTimestamp(b.data.date) - toTimestamp(a.data.date));
    return sorted.map((post, i) => {
        // sorted 按日期降序：sorted[i-1] 比当前新（next），sorted[i+1] 比当前旧（prev）
        const nextPost = i > 0 ? sorted[i - 1] : undefined;
        const prevPost = i < sorted.length - 1 ? sorted[i + 1] : undefined;
        return {
            params: { post: post.data.abbrlink },
            props: {
                post,
                prev: prevPost
                    ? { url: "/posts/" + prevPost.data.abbrlink, title: prevPost.data.title }
                    : undefined,
                next: nextPost
                    ? { url: "/posts/" + nextPost.data.abbrlink, title: nextPost.data.title }
                    : undefined,
            },
        };
    });
}
---
<Stalux
    title={props.post.data.title + " | " + siteConfig.title}
    description={autoDesc}
    cover={props.post.data.cover}
    isArticle={true}
    date={props.post.data.date}
    updated={props.post.data.updated}
    tags={props.post.data.tags}
    categories={props.post.data.categories}
    author={authorConfig.name}
    fontSubsetId={`posts-${props.post.data.abbrlink}`}
>
    <div style="height:3em"></div>
    <Navs /><div style="height:3em"></div>
        <PostLayout title={props.post.data.title} date={props.post.data.date} updated={props.post.data.updated} readingTime={minutesRead} readingMinutes={readingMinutes} tags={props.post.data.tags||[]} categories={props.post.data.categories||[]} headings={headings} author={authorConfig.name} authorAvatar={authorConfig.avatar} prev={props.prev} next={props.next} cc={props.post.data.cc} wordCount={wordCount} hasImage={flags.hasImage}>
        <Content/>
    </PostLayout>
</Stalux>
