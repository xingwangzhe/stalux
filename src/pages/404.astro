---
import Stalux from "@layouts/Stalux.astro";
import Navs from "@components/stalux/layout/navs.astro";
import { getCollection } from "astro:content";
import { createTranslator } from "@utils/i18n";
import { getSiteData, getAuthorData, getHeadData, getNavsData, getLinksData, getCommentData, getFooterData, getPromoteData, getTypetextsData, getMediaLinksData } from "@utils/config-utils";

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const { t } = createTranslator(siteConfig.lang || "zh-CN");
---

<Stalux
  title={t("page404.title") + " | " + siteConfig.title}
  description={t("page404.description")}
>
  <div style="height: 3em;"></div>
  <Navs />
  <div class="error-container" data-pagefind-ignore>
    <div class="error-content">
      <h1>404</h1>
      <p>{t("page404.pageNotFound")}</p>
      <p id="countdown" class="countdown-text">{t("page404.countdown", { n: 5 })}</p>
      <a href="/" class="home-btn" data-astro-prefetch>{t("page404.backHome")}</a>
    </div>
  </div>

  <script define:vars={{ countdownText: t("page404.countdown", { n: "{n}" }) }}>
    let seconds = 5;
    const el = document.getElementById("countdown");
    const timer = setInterval(() => {
      seconds--;
      if (seconds <= 0) {
        clearInterval(timer);
        window.location.href = "/";
      } else {
        el.textContent = countdownText.replace("{n}", String(seconds));
      }
    }, 1000);
  </script>
</Stalux>

<style>
  .error-container {
    text-align: center;
    padding: 2rem;
    min-height: 60vh;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .error-content h1 {
    font-size: 6rem;
    font-weight: bold;
    margin: 0;
    color: var(--white-90p);
    text-shadow: 0 2px 10px var(--shadow-medium);
  }

  .error-content p {
    font-size: 1.5rem;
    margin: 1rem 0 2rem 0;
    color: var(--white-70p);
  }

  .countdown-text {
    font-size: 0.95rem !important;
    color: var(--white-50p) !important;
    margin: -0.5rem 0 1.5rem 0 !important;
  }

  .home-btn {
    display: inline-block;
    padding: var(--space-md) var(--space-lg);
    background: var(--black-20p);
    color: var(--white-90p);
    text-decoration: none;
    border-radius: var(--radius-md);
    border: var(--border-thin) solid var(--white-20p);
    transition:
      background-color var(--transition-normal),
      transform var(--transition-normal),
      box-shadow var(--transition-normal);
    font-size: var(--font-size-base);
  }

  .home-btn:hover {
    background: var(--accent-20p);
    transform: translateY(-2px);
    box-shadow: 0 4px 12px var(--shadow-dark);
  }

  @media (max-width: 768px) {
    .error-content h1 {
      font-size: 4rem;
    }

    .error-content p {
      font-size: 1.2rem;
    }
  }
</style>
