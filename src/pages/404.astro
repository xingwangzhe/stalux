---
import { getCollection } from "astro:content";
import Navs from "@components/stalux/layout/navs.astro";
import Stalux from "@layouts/Stalux.astro";
import { getSiteData } from "@utils/config-utils";
import { createTranslator } from "@utils/i18n";

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const { t } = createTranslator(siteConfig.lang || "zh-CN");
---

<Stalux
    title={`${t("page404.title")} | ${siteConfig.title}`}
    description={t("page404.description")}
>
    <div style="height: 3em;"></div>
    <Navs />
    <div
        class="stalux-404-error-container stalux-u-flex stalux-u-items-center stalux-u-justify-center stalux-u-text-center"
        data-pagefind-ignore
    >
        <div class="stalux-404-error-content">
            <h1>404</h1>
            <p>{t("page404.pageNotFound")}</p>
            <p class="agent-recovery">
                This URL does not exist. Continue at the <a href="/">home page</a>, browse the
                <a href="/archives/">archive</a>, read <a href="/llms.txt">llms.txt</a>, or inspect
                the
                <a href="/sitemap-index.xml">sitemap</a>
                to find published content.
            </p>
            <p
                id="countdown"
                class="stalux-404-countdown-text"
                data-countdown-template={t("page404.countdown", { n: "{n}" })}
            >
                {t("page404.countdown", { n: 5 })}
            </p>
            <a href="/" class="stalux-404-home-btn home-btn" data-astro-prefetch
                >{t("page404.backHome")}</a
            >
        </div>
    </div>

    <script src="../scripts/countdown.ts"></script>
</Stalux>
