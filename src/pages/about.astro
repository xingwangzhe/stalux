---
import Stalux from "@layouts/Stalux.astro";
import PostContent from "@components/stalux/posts/postContent.astro";
import PostCC from "@components/stalux/posts/postCC.astro";
import WalineComment from "@components/stalux/posts/WalineComment.astro";
import { buildWalineProps } from "@utils/waline";
import { getCollection, render } from "astro:content";
import Navs from "@components/stalux/layout/navs.astro";
import { getSiteData, getAuthorData, getHeadData, getNavsData, getLinksData, getCommentData, getFooterData, getPromoteData, getTypetextsData, getMediaLinksData } from "@utils/config-utils";

// 获取关于页面内容
const aboutPages = await getCollection("about");
const aboutPage = aboutPages[0];
const { Content } = await render(aboutPage);

// 获取配置
const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const commentConfig = getCommentData(configEntries);
const walineSection = commentConfig?.waline;
const commentEnabled = commentConfig?.enabled ?? false;
const walineConfig = walineSection && walineSection.serverURL ? walineSection : undefined;
const authorConfig = getAuthorData(configEntries);
const author = authorConfig.name;
---

<Stalux
    title={aboutPage.data.title + " | " + siteConfig.title}
    description={aboutPage.data.description}
    fontSubsetId="about"
>
    <div style="height: 3em;"></div>
    <Navs />
    <div style="height: 3em;"></div>
    <div style="max-width: 900px; margin: 2rem auto; padding: 0 1rem;">
        <PostContent
            title={aboutPage.data.title}
            transitionName="about-content"
            date={undefined}
            updated={undefined}
            readingTime={undefined}
        >
            <Content />
            <PostCC
                title={aboutPage.data.title}
                author={author}
                url={Astro.url.href}
                cc="CC-BY-NC-SA-4.0"
            />
            {
                commentEnabled && walineConfig?.serverURL && (
                    <WalineComment
                        {...buildWalineProps(walineConfig)}
                        path={Astro.url.pathname}
                        title={aboutPage.data.title}
                    />
                )
            }
        </PostContent>
    </div>
</Stalux>
