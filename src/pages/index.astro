---
import { getCollection } from "astro:content";
const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const siteTitle = siteConfig.title;
const siteDescription = siteConfig.description;
import Stalux from "@layouts/Stalux.astro";
import styles from "@styles/pages/home.module.css";
import Navs from "@components/stalux/layout/navs.astro";
import Author from "@components/stalux/common/author.astro";
import TextType from "@components/stalux/common/textType.astro";
import DateTime from "@components/stalux/common/date.astro";
import SocialMedia from "@components/stalux/links/socialMedia.astro";
import ToArchive from "@components/stalux/archives/toArchive.astro";
import { getSiteData, getAuthorData, getHeadData, getNavsData, getLinksData, getCommentData, getFooterData, getPromoteData, getTypetextsData, getMediaLinksData } from "@utils/config-utils";
---

<Stalux title={siteTitle} description={siteDescription}>
  <div class={styles.homeBody}>
    <h1 class={styles.homeTitle}>{siteTitle}</h1>
    <div class={styles.homeNavs}>
      <Navs />
    </div>
    <Author />
    <TextType />
    <DateTime />
    <SocialMedia />
    <ToArchive />
  </div>
</Stalux>
