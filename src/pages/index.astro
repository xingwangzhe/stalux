---
import { getCollection } from "astro:content";
import { createTranslator } from "@utils/i18n";

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const siteTitle = siteConfig.title;
const siteDescription = siteConfig.description;
const { t } = createTranslator(siteConfig.lang || "zh-CN");

import ToArchive from "@components/stalux/archives/toArchive.astro";
import Author from "@components/stalux/common/author.astro";
import DateTime from "@components/stalux/common/date.astro";
import TextType from "@components/stalux/common/textType.astro";
import Navs from "@components/stalux/layout/navs.astro";
import SocialMedia from "@components/stalux/links/socialMedia.astro";
import Stalux from "@layouts/Stalux.astro";
import styles from "@styles/pages/home.module.css";
import { getSiteData } from "@utils/config-utils";
---

<Stalux title={siteTitle} description={siteDescription}>
    <div class={styles.homeBody}>
        <div class={styles.homeNavs}>
            <Navs />
        </div>
        <h1 class={styles.homeTitle}>{siteTitle}</h1>
        <h2
            class="sr-only"
            style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;"
        >
            {t("ai.about")}
        </h2>
        <section class="agent-home-summary" aria-label="About this site">
            <h2>About this technical blog</h2>
            <p>
                {siteDescription}
                This is a personal, public, read-only knowledge base for developers and AI agents
                looking for published technical articles, practical notes, project investigations,
                and reproducible web engineering details. Start with the
                <a href="/index.md">Markdown home page</a>,
                <a href="/api/posts.json">published post index</a>,
                <a href="/openapi.json">read API description</a>, or
                <a href="/llms.txt">agent guidance</a>. Individual posts are available as HTML and
                Markdown, and the <a href="/rss.xml">RSS feed</a> provides a machine-readable update
                stream. The site does not require an account and these discovery endpoints do not
                mutate data.
            </p>
        </section>
        <Author />
        <TextType />
        <DateTime />
        <SocialMedia />
        <ToArchive />
    </div>
</Stalux>

<style>
.agent-home-summary {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: normal;
    border: 0;
}
</style>
