---
import ListPage from "@components/stalux/layout/listPage.astro";
import LinkList from "@components/stalux/links/linkList.astro";
import { getCollection } from "astro:content";

const stalux = (await getCollection("config"))[0].data;
---

<ListPage
    title={stalux.title}
    description={stalux.description}
    heading={stalux.links.title}
    subheading={stalux.links.description}
>
    <LinkList />
</ListPage>
