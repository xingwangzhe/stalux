---
import ListPage from "@components/stalux/layout/listPage.astro";
import LinkList from "@components/stalux/links/linkList.astro";
import { getCollection } from "astro:content";
import { getSiteData, getLinksData } from "@utils/config-utils";

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const linksConfig = getLinksData(configEntries)!;
const siteDescription = siteConfig.description;
const linksTitle = linksConfig.title;
const linksDescription = linksConfig.description;
---

<ListPage
    title={linksTitle}
    description={linksDescription || siteDescription}
    heading={linksTitle}
    subheading={linksDescription}
>
    <LinkList />
</ListPage>
