---
import { type CollectionEntry, getCollection } from "astro:content";
import Navs from "@components/stalux/layout/navs.astro";
import PostList from "@components/stalux/posts/postList.astro";
import TagHeader from "@components/stalux/tags/tagHeader.astro";
import Stalux from "@layouts/Stalux.astro";
import { getSiteData } from "@utils/config-utils";
import { createTranslator } from "@utils/i18n";
import { buildTaxonomyStaticPaths } from "@utils/taxonomy";

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const { t } = createTranslator(siteConfig.lang || "zh-CN");
export async function getStaticPaths() {
    return buildTaxonomyStaticPaths("categories");
}

interface Props {
    category: string;
    count: number;
    posts: CollectionEntry<"posts">[];
    lastUpdateDate: string;
}

const props = Astro.props as Props;
---

<Stalux
    title={`${t("taxonomy.category")}: ${props.category} | ${siteConfig.title}`}
    description={t("taxonomy.browseCategory", { title: siteConfig.title, category: props.category, count: props.count })}
>
    <div style="height: 3em;"></div>
    <Navs />
    <TagHeader type={t("taxonomy.category")} name={props.category} count={props.count} />
    <PostList posts={props.posts} />
</Stalux>
