---
import { getCollection } from "astro:content";
import CategoriesList from "@components/stalux/categories/categoriesList.astro";
import Navs from "@components/stalux/layout/navs.astro";
import Stalux from "@layouts/Stalux.astro";

import { getSiteData } from "@utils/config-utils";
import { createTranslator } from "@utils/i18n";

const configEntries2 = await getCollection("config");
const siteConfig = getSiteData(configEntries2);
const { t } = createTranslator(siteConfig.lang || "zh-CN");
---

<Stalux
    title={`${t("categories.title")} | ${siteConfig.title}`}
    description={t("categories.description", { title: siteConfig.title })}
>
    <div style="height: 3em;"></div>
    <Navs />
    <h1 class="stalux-page-title">{t("categories.heading")}</h1>
    <div class="stalux-page-description">{t("categories.browseByTopic")}</div>
    <CategoriesList />
</Stalux>
