---
import ListPage from "@components/stalux/layout/listPage.astro";
import ArchivesList from "@components/stalux/archives/archivesList.astro";
import { getCollection } from "astro:content";

const posts = await getCollection("posts", ({ data }) => !data.draft);
---

<ListPage
    title="文章归档"
    description="本站文章归档页面"
    heading="文章归档"
    subheading={`时间轴上的所有文章（共 ${posts.length} 篇）`}
>
    <ArchivesList posts={posts} />
</ListPage>
