---
import Navs from "@components/stalux/layout/navs.astro";
import Stalux from "@layouts/Stalux.astro";
import ArchivesList from "@components/stalux/archives/archivesList.astro";
import { getCollection } from "astro:content";
import { createTranslator } from "@utils/i18n";
import styles from "@styles/pages/archives.module.css";
const stalux = (await getCollection("config"))[0]?.data ?? {};
const { t } = createTranslator(stalux.lang || "zh-CN");
const posts = await getCollection("posts", ({ data }) => !data.draft);
---

<Stalux title={t("archives.title") + " | " + stalux.title} description={t("archives.description", { title: stalux.title })}>
    <div style="height: 3em;"></div>
    <Navs />
    <h1 class={styles.h1}>{t("archives.heading")}</h1>
    <div class={styles.description}>
        {t("archives.desc", { n: posts.length })}
    </div>
    <ArchivesList posts={posts} />
</Stalux>
