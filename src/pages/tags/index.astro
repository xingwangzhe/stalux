---
import Stalux from "@layouts/Stalux.astro";
import { getCollection } from "astro:content";
import { createTranslator } from "@utils/i18n";
import Navs from "@components/stalux/layout/navs.astro";
import styles from "@styles/pages/tags.module.css";
import TagsCloud from "@components/stalux/tags/tagsCloud.astro";
import { getSiteData, getAuthorData, getHeadData, getNavsData, getLinksData, getCommentData, getFooterData, getPromoteData, getTypetextsData, getMediaLinksData } from "@utils/config-utils";
const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const { t } = createTranslator(siteConfig.lang || "zh-CN");
const posts = await getCollection("posts", ({ data }) => !data.draft);
const hasContent = posts.length > 0;
---

<Stalux
    title={t("tags.title") + " | " + siteConfig.title}
    description={t("tags.description", { title: siteConfig.title })}
    fontSubsetId={hasContent ? "tags" : undefined}
>
    <div style="height: 3em;"></div>
    <Navs />
    <h1 class={styles.title}>{t("tags.heading")}</h1>
    <div class={styles.description}>{t("tags.explore")}</div>
    <TagsCloud />
</Stalux>
