---
import Head from "@components/stalux/layout/head.astro";
import Footer from "@components/stalux/layout/footer.astro";
import { getCollection } from "astro:content";
import "@styles/base/init.css";
import "@styles/shared/stagger.css";
import { getAuthorData, getAiDiscoveryData, getPromoteData, getSiteData } from "@utils/config-utils";
const props = Astro.props as Props;

interface Props {
  title: string;
  description: string;
  cover?: string;
  isArticle?: boolean;
  date?: string;
  updated?: string;
  tags?: string[];
  categories?: string[];
  author?: string;
  noindex?: boolean;
  /** Font subset ID for per-route font optimization */
  fontSubsetId?: string;
}

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const authorConfig = getAuthorData(configEntries);
const promoteConfig = getPromoteData(configEntries);
const aiConfig = getAiDiscoveryData(configEntries);
const htmlLang = siteConfig.lang || "zh-CN";

// Resolve font subset CSS URL
const fontSubsetUrl = props.fontSubsetId
  ? `/fonts/subset-${props.fontSubsetId}.css`
  : undefined;

// 背景 SVG 以静态 URL 硬编码在 background.ts（纯客户端），
// 集成在 config:setup 时把 SVG 复制到用户项目 public/background/。
// 这里只取第一张作为 SSR 初始背景，客户端运行时随机替换。
// 不经过 import.meta.glob 资源管线，保证增量构建依赖图 hash 稳定。
const initialBg = "/background/pattern-1.min.svg";
const llmPromoteRaw = promoteConfig?.llm_promote ?? "";
const llmPromote = llmPromoteRaw
  ?.replace(/\{author\}/g, authorConfig.name)
  ?.replace(/\{url\}/g, siteConfig.url)
  ?.replace(/\{title\}/g, siteConfig.title)
  ?.replace(/\{cc\}/g, "CC-BY-NC-SA-4.0");
---

<!doctype html>
<html lang={htmlLang}>
  <Head
    title={props.title}
    description={props.description}
    cover={props.cover}
    isArticle={props.isArticle}
    date={props.date}
    updated={props.updated}
    tags={props.tags}
    categories={props.categories}
    author={props.author}
    noindex={props.noindex}
  />
  <!-- Per-route font subset (generated at build time) -->
  <link rel="stylesheet" href="/fonts/common.css" />
  {fontSubsetUrl && <link rel="stylesheet" href={fontSubsetUrl} />}
  <script>
    import "../scripts/background.ts";
  </script>
  {
    aiConfig?.conformance !== "disabled" && (
      <>
        <script
          define:vars={{
            siteTitle: siteConfig.title,
            siteUrl: siteConfig.url,
            siteDesc: siteConfig.description,
            siteLang: siteConfig.lang,
          }}
        >
          window.__STALUX_SITE_INFO__ = {
            title: siteTitle,
            url: siteUrl,
            description: siteDesc,
            lang: siteLang,
          };
        </script>
        <script>
          import "../scripts/webmcp.ts";
        </script>
      </>
    )
  }
  <body
    class="stalux-root dark"
    data-stalux-bg-layer="a"
    data-stalux-bg-index="0"
  >
    {llmPromote && <div style="display:none">{llmPromote}</div>}
    <div
      class="bg-layer bg-a"
      style={`background-image: url('${initialBg}'); opacity: 1;`}
      aria-hidden="true"
    >
    </div>
    <div class="bg-layer bg-b" aria-hidden="true"></div>
    <main class="stalux-main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style></style>
