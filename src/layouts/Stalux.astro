---
import Head from "@components/stalux/layout/head.astro";
import Footer from "@components/stalux/layout/footer.astro";
import { getCollection } from "astro:content";
import "@styles/base/init.css";
import "@styles/shared/stagger.css";
import "@styles/shared/view-transitions.css";
import { getAuthorData, getAiDiscoveryData, getPromoteData, getSiteData } from "@utils/config-utils";
import { getRouteAnimation, getRouteKind } from "@utils/view-transitions";
// font-subset.ts 构建期生成的 manifest 副本（进入 Astro 依赖图，
// manifest 变化 → 页面重建 → 增量构建 restored 的页面不会引用旧字体资源）
import fontsManifest from "../internal/generated/fonts-manifest.json";
const props = Astro.props as Props;

interface Props {
  title: string;
  description: string;
  cover?: string;
  isArticle?: boolean;
  date?: string;
  updated?: string;
  tags?: string[];
  categories?: string[];
  author?: string;
  noindex?: boolean;
  /** Font subset ID for per-route font optimization */
  fontSubsetId?: string;
}

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const authorConfig = getAuthorData(configEntries);
const promoteConfig = getPromoteData(configEntries);
const aiConfig = getAiDiscoveryData(configEntries);
const htmlLang = siteConfig.lang || "zh-CN";

// Resolve font subset CSS URLs（内容寻址，避免浏览器缓存旧 CSS 引用已删除 TTF → 404）
// 生产构建：font-subset.ts 生成带 hash 的 CSS 文件名并写入 manifest（副本 import 至此），
// 这里从 manifest 取文件名，内容变化必然换名、浏览器自动拉新。
// dev 模式：manifest 的 routes 为空（skipPerRoute），回退固定名 /fonts/common.css 与
// /fonts/subset-<id>.css，由 dev 按需中间件生成。
const fontManifest = fontsManifest as
    | {
          commonCss?: string;
          routes?: Record<string, string>;
      }
    | null
    | undefined;

let commonFontCssUrl = "/fonts/common.css";
let fontSubsetUrl: string | undefined;
if (props.fontSubsetId) {
    fontSubsetUrl = `/fonts/subset-${props.fontSubsetId}.css`;
}
if (fontManifest?.commonCss) {
    commonFontCssUrl = `/fonts/${fontManifest.commonCss}`;
}
if (props.fontSubsetId && fontManifest?.routes) {
    // route 键可能是 posts/xxx（页面对应 posts-xxx）或含原始 unicode（tag/category），
    // 统一归一化比较：route.replace("/", "-") === decodeURIComponent(fontSubsetId)
    const want = decodeURIComponent(props.fontSubsetId);
    for (const [route, cssFile] of Object.entries(fontManifest.routes)) {
        if (route.replace("/", "-") === want) {
            fontSubsetUrl = `/fonts/${encodeURIComponent(cssFile)}`;
            break;
        }
    }
}

// 背景 SVG 以静态 URL 硬编码在 background.ts（纯客户端），
// 集成在 config:setup 时把 SVG 复制到用户项目 public/background/。
// SSR 不渲染背景图，默认露出 .bg-layer 的灰墙底色（--stalux-bg-color），
// 客户端运行时随机选图；不经过 import.meta.glob 资源管线，
// 保证增量构建依赖图 hash 稳定。
const llmPromoteRaw = promoteConfig?.llm_promote ?? "";
const llmPromote = llmPromoteRaw
  ?.replace(/\{author\}/g, authorConfig.name)
  ?.replace(/\{url\}/g, siteConfig.url)
  ?.replace(/\{title\}/g, siteConfig.title)
  ?.replace(/\{cc\}/g, "CC-BY-NC-SA-4.0");
const routeKind = getRouteKind(Astro.url.pathname);
const routeAnimation = getRouteAnimation(routeKind);
---

<!doctype html>
<html lang={htmlLang}>
  <Head
    title={props.title}
    description={props.description}
    cover={props.cover}
    isArticle={props.isArticle}
    date={props.date}
    updated={props.updated}
    tags={props.tags}
    categories={props.categories}
    author={props.author}
    noindex={props.noindex}
  />
  <!-- Per-route font subset (generated at build time) -->
  <link rel="stylesheet" href={commonFontCssUrl} />
  {fontSubsetUrl && <link rel="stylesheet" href={fontSubsetUrl} />}
  <script>
    import "../scripts/background.ts";
    import "../scripts/view-transitions.ts";
  </script>
  {
    aiConfig?.conformance !== "disabled" && (
      <>
        <script
          define:vars={{
            siteTitle: siteConfig.title,
            siteUrl: siteConfig.url,
            siteDesc: siteConfig.description,
            siteLang: siteConfig.lang,
          }}
        >
          window.__STALUX_SITE_INFO__ = {
            title: siteTitle,
            url: siteUrl,
            description: siteDesc,
            lang: siteLang,
          };
        </script>
        <script>
          import "../scripts/webmcp.ts";
        </script>
      </>
    )
  }
  <body
    class="stalux-root dark"
    data-stalux-bg-layer="a"
    data-stalux-bg-index="0"
  >
    {llmPromote && <div style="display:none">{llmPromote}</div>}
    <div
      class="bg-layer bg-a"
      style="opacity: 1;"
      transition:persist="stalux-bg-a"
      aria-hidden="true"
    ></div>
    <div
      class="bg-layer bg-b"
      transition:persist="stalux-bg-b"
      aria-hidden="true"
    ></div>
    <main
      class="stalux-main"
      data-stalux-route={routeKind}
      transition:name="stalux-page"
      transition:animate={routeAnimation}
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style></style>
