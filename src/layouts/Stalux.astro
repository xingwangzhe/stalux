---
import "../styles/module-motion.css";
import { getCollection } from "astro:content";
import Footer from "@components/stalux/layout/footer.astro";
import Head from "@components/stalux/layout/head.astro";
import Navs from "@components/stalux/layout/navs.astro";
import { getAccentColorStyle } from "@utils/accent-color";
import {
    getAiDiscoveryData,
    getAuthorData,
    getHeadData,
    getPromoteData,
    getSiteData,
} from "@utils/config-utils";
import type { SocialImage } from "@utils/social-image";
import { getRouteKind } from "@utils/view-transitions";

const props = Astro.props as Props;

interface Props {
    title: string;
    description: string;
    cover?: string | undefined;
    socialImage?: SocialImage | undefined;
    isArticle?: boolean;
    date?: string | undefined;
    updated?: string | undefined;
    tags?: string[] | undefined;
    categories?: string[] | undefined;
    author?: string | undefined;
    noindex?: boolean;
}

const configEntries = await getCollection("config");
const siteConfig = getSiteData(configEntries);
const authorConfig = getAuthorData(configEntries);
const headConfig = getHeadData(configEntries);
const promoteConfig = getPromoteData(configEntries);
const aiConfig = getAiDiscoveryData(configEntries);
const htmlLang = siteConfig.lang || "zh-CN";

const llmPromoteRaw = promoteConfig?.llm_promote ?? "";
const llmPromote = llmPromoteRaw
    ?.replace(/\{author\}/gu, authorConfig.name)
    ?.replace(/\{url\}/gu, siteConfig.url)
    ?.replace(/\{title\}/gu, siteConfig.title)
    ?.replace(/\{cc\}/gu, "CC-BY-NC-SA-4.0");
const routeKind = getRouteKind(Astro.url.pathname);
---

<!doctype html>
<html
    lang={htmlLang}
    style={getAccentColorStyle(siteConfig.accentColor)}
    data-stalux-route={routeKind}
>
    <Head
        title={props.title}
        description={props.description}
        cover={props.cover}
        socialImage={props.socialImage}
        isArticle={props.isArticle}
        date={props.date}
        updated={props.updated}
        tags={props.tags}
        categories={props.categories}
        author={props.author}
        noindex={props.noindex}
    />
    <script>
    import "../scripts/view-transitions.ts";
    // Every page type has at least one list, so the unroll cue is registered
    // once in the shared layout instead of per page. Page-runtime dedupes it
    // against the article and archive components that also request it.
    import { mountListReveal } from "../scripts/list-reveal";
    import { registerPageLifecycle } from "../scripts/page-runtime";
    import "../scripts/route-prefetch";

    registerPageLifecycle("list-reveal", mountListReveal);
    </script>
    {aiConfig?.conformance !== "disabled" && <script>import "../scripts/webmcp.ts";</script>}
    <body
        class={`stalux-root dark page-${routeKind}`}
        data-stalux-site-title={siteConfig.title}
        data-stalux-site-url={siteConfig.url}
        data-stalux-site-description={siteConfig.description}
        data-stalux-site-lang={siteConfig.lang}
        data-stalux-markdown-export={String(promoteConfig?.export_md === true)}
        data-stalux-webmcp-enabled={String(aiConfig?.conformance !== "disabled")}
        data-stalux-ga-id={headConfig?.googleAnalyticsId}
        data-stalux-clarity-id={headConfig?.bingClarityId}
        data-stalux-umami-id={headConfig?.umami?.id}
        data-stalux-umami-url={headConfig?.umami?.url}
    >
        <header class="stalux-site-header" data-stalux-font-group="header">
            <Navs />
        </header>
        <div data-stalux-nav-sentinel aria-hidden="true"></div>
        <div data-stalux-scroll-sentinel aria-hidden="true"></div>
        {llmPromote && (
            <section class="stalux-ai-prompt" data-stalux-ai-prompt aria-label="AI site context">
                <p>{llmPromote}</p>
            </section>
        )}
        <div class="bg-layer" data-stalux-background aria-hidden="true"></div>
        <main id="swup-main" class="stalux-main" data-stalux-route={routeKind}>
            <slot />
        </main>
        <Footer />
    </body>
</html>
