#!/bin/sh
# pre-push hook: require Biome's unified quality check before allowing a push.

# Always run from the repository root so package.json is found regardless of cwd
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT" || exit 1

echo "▶ Running Biome check..."
if ! bun run check; then
    echo ""
    echo "✗ Biome check failed, push aborted."
    echo "  Run 'bun run check:fix' before pushing."
    exit 1
fi

echo "▶ Running Astro type check..."
if ! bun run astro:check; then
    echo ""
    echo "✗ Astro type check failed, push aborted."
    exit 1
fi

echo "✓ Biome and Astro checks passed, push allowed."
