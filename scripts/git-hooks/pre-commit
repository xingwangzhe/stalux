#!/bin/sh
# pre-commit hook: require both lint and fmt to pass before allowing a commit.
# - lint: oxlint, fails on any error or warning
# - fmt:  oxfmt --check (dry-run), fails if any file needs formatting
# If either check fails, the commit is aborted with the corresponding fix hint.

# Always run from the repository root so package.json is found regardless of cwd
REPO_ROOT=$(git rev-parse --show-toplevel)
cd "$REPO_ROOT" || exit 1

echo "▶ Running lint (oxlint)..."
if ! bun run lint; then
    echo ""
    echo "✗ lint failed, commit aborted."
    echo "  Run 'bun run lint:fix' to fix the issues before committing."
    exit 1
fi

echo "▶ Running fmt check (oxfmt --check)..."
if ! bun run fmt:check; then
    echo ""
    echo "✗ Code is not properly formatted (dry-run reports changes needed), commit aborted."
    echo "  Run 'bun run fmt' to format the whole repository before committing."
    exit 1
fi

echo "✓ lint and fmt checks passed, commit allowed."
