{
    "name": "@xingwangzhe/stalux",
    "version": "1.77.5",
    "description": "Astro blog theme with CJK search and font subsetting. Use from source or as an Astro integration.",
    "keywords": [
        "astro",
        "astro-integration",
        "astro-theme",
        "blog-theme",
        "cjk",
        "orama",
        "static-site"
    ],
    "homepage": "https://stalux.needhelp.icu",
    "bugs": "https://github.com/xingwangzhe/stalux/issues",
    "license": "MIT",
    "author": "xingwangzhe",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/xingwangzhe/stalux.git"
    },
    "engines": {
        "bun": ">=1.4.0"
    },
    "// browserslist": "现代基线，与 src/internal/modern-css.ts 的 lightningcss targets 保持一致；当前构建不使用 autoprefixer/postcss，此字段用于声明目标并约束后续工具链。",
    "browserslist": ["chrome >= 154", "firefox >= 157", "safari >= 26.6"],
    "bin": {
        "stalux": ".release/cli.mjs"
    },
    "files": [
        "src/env.d.ts",
        "src/index.ts",
        "src/config.ts",
        "src/expressive-code.ts",
        "src/components/**/*.astro",
        "src/components/**/*.ts",
        "src/layouts/**/*.astro",
        "src/pages/**/*.astro",
        "src/pages/**/*.ts",
        "src/styles/**/*.css",
        "src/utils/**/*.ts",
        "src/i18n/**/*.json",
        "src/schemas/**/*.ts",
        "src/plugins/**/*.ts",
        "src/internal/**/*.ts",
        "src/scripts/**/*.ts",
        "public/background/*.webp",
        "src/assets/cc-icon.svg",
        "src/assets/fonts/*",
        ".release/cli.mjs",
        "!src/content.config.ts",
        "public/fonts/**",
        "LICENSES"
    ],
    "type": "module",
    "packageManager": "bun@1.4.4",
    "exports": {
        ".": "./src/index.ts",
        "./config": "./src/config.ts",
        "./expressive-code": "./src/expressive-code.ts",
        "./schemas": "./src/schemas/config.ts",
        "./schemas/collections": "./src/schemas/collections.ts",
        "./components/*": "./src/components/*",
        "./layouts/*": "./src/layouts/*",
        "./pages/*": "./src/pages/*",
        "./styles/*": "./src/styles/*",
        "./utils/*": "./src/utils/*",
        "./i18n/*": "./src/i18n/*",
        "./plugins/*": "./src/plugins/*",
        "./internal/*": "./src/internal/*",
        "./scripts/*": "./src/scripts/*",
        "./assets/*": "./src/assets/*",
        "./package.json": "./package.json"
    },
    "scripts": {
        "dev": "bun run styles:build && bun scripts/dev.ts",
        "build": "bun run styles:build && bunx --bun astro build --timings && bun scripts/verify-build.ts",
        "preview": "bunx --bun astro preview",
        "astro": "bunx --bun astro",
        "init": "bun scripts/cli.ts init",
        "node:check": "tsc --project tsconfig.node.json",
        "build:cli": "bun build scripts/cli.ts --target=bun --outfile .release/cli.mjs",
        "prepack": "bun run styles:build && bun run build:cli",
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "astro:check": "bun run astro sync && tsc --project tsconfig.astro-ts7.json --noEmit --runExternalCode",
        "test": "bun --bun vitest",
        "test:run": "bun --bun vitest run",
        "test:coverage": "bun --bun vitest run --coverage",
        "knip": "bunx --bun knip",
        "verify:build": "bun scripts/verify-build.ts",
        "validate": "bun run styles:build && bun run check && bun run node:check && bun run astro:check && bun run knip && bun run test:coverage && bun run build && bun run build:cli",
        "prepare": "sh -c 'if [ -d scripts/git-hooks ] && git rev-parse --git-dir >/dev/null 2>&1; then git config core.hooksPath scripts/git-hooks; fi'",
        "dev:debug": "STALUX_DEBUG=1 bunx --bun astro dev --verbose",
        "build:debug": "STALUX_DEBUG=1 bunx --bun astro build --timings --verbose && bun scripts/verify-build.ts",
        "styles:build": "bun scripts/build-styles.ts && bun scripts/build-style-names.ts",
        "styles:watch": "bun scripts/build-styles.ts --watch",
        "benchmark:performance": "bun scripts/benchmark-performance.ts",
        "benchmark:builds": "python3 scripts/benchmark-builds.py",
        "analyze": "SONDA=1 bun run build",
        "backgrounds:build": "bun scripts/build-backgrounds.ts"
    },
    "dependencies": {
        "@astrojs/compiler": "^4.0.0",
        "@astrojs/markdown-satteri": "^0.4.10",
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.6",
        "@expressive-code/plugin-line-numbers": "^0.44.4",
        "@lucide/astro": "^1.76.0",
        "@microsoft/clarity": "^1.0.2",
        "@orama/orama": "3.1.18",
        "@orama/plugin-data-persistence": "3.1.18",
        "@orama/plugin-pt15": "3.1.18",
        "@orama/tokenizers": "3.1.18",
        "@orama/wc-components": "0.8.1",
        "@swup/a11y-plugin": "^5.2.1",
        "@swup/body-class-plugin": "^3.3.0",
        "@swup/fragment-plugin": "^1.3.1",
        "@swup/head-plugin": "^2.3.1",
        "@swup/js-plugin": "^3.2.0",
        "@swup/parallel-plugin": "^0.4.0",
        "@swup/preload-plugin": "^3.2.12",
        "@swup/progress-plugin": "^3.2.0",
        "@swup/route-name-plugin": "^4.1.0",
        "@swup/scripts-plugin": "^2.1.0",
        "@swup/scroll-plugin": "^4.0.0",
        "@w3c/webmcp-polyfill": "^0.1.1",
        "@waline/client": "^3.16.2",
        "@xingwangzhe/cjk-font-split-native": "^0.4.12",
        "@xingwangzhe/satteri-mermaid": "^0.8.5",
        "@xingwangzhe/satteri-photoswipe": "^0.2.7",
        "@xingwangzhe/tags-cloud": "^1.2.10",
        "astro-expressive-code": "^0.44.4",
        "astro-seo-kit": "0.1.3",
        "badge-maker": "^6.0.0",
        "css-tree": "^3.2.1",
        "html-escaper": "^3.0.3",
        "image-size": "^2.1.0",
        "magic-string": "^1.4.5",
        "parse5": "^8.1.1",
        "photoswipe": "^5.4.4",
        "satteri": "^0.11.7",
        "simple-icons": "^16.38.0",
        "swup": "^4.10.0",
        "temml": "^0.14.0",
        "webmcp-types": "^0.1.11",
        "yaml": "^2.9.1"
    },
    "devDependencies": {
        "@astrojs/ts-content-mapper": "0.2.0",
        "@biomejs/biome": "^2.6.8",
        "@swup/debug-plugin": "^4.1.0",
        "@types/bun": "^1.4.4",
        "@types/css-tree": "^3.2.0",
        "@types/html-escaper": "^3.0.4",
        "@unocss/astro": "^66.13.0",
        "@vitest/coverage-v8": "^5.1.1",
        "astro": "^7.4.13",
        "happy-dom": "^21.0.4",
        "knip": "^6.46.1",
        "sharp": "^0.35.5",
        "sonda": "^0.14.0",
        "typescript": "7.1.0-beta",
        "unocss": "^66.13.0",
        "vite": "^8.3.8",
        "vitest": "^5.1.1"
    },
    "peerDependencies": {
        "astro": "^7.4.12"
    },
    "patchedDependencies": {
        "astro-seo-kit@0.1.3": "patches/astro-seo-kit@0.1.3.patch",
        "@xingwangzhe/tags-cloud@1.2.10": "patches/@xingwangzhe%2Ftags-cloud@1.2.10.patch"
    }
}
