{
    "name": "@xingwangzhe/stalux",
    "version": "1.47.1",
    "description": "A powerful, modern Astro blog theme — use as template or install as plugin",
    "keywords": [
        "astro",
        "astro-integration",
        "astro-theme",
        "blog",
        "blog-theme",
        "stalux",
        "static-site"
    ],
    "homepage": "https://stalux.needhelp.icu",
    "bugs": "https://github.com/xingwangzhe/stalux/issues",
    "license": "MIT",
    "author": "xingwangzhe",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/xingwangzhe/stalux.git"
    },
    "engines": {
        "node": ">=26"
    },
    "bin": {
        "stalux": ".release/cli.mjs"
    },
    "files": [
        "src/env.d.ts",
        "src/index.ts",
        "src/config.ts",
        "src/expressive-code.ts",
        "src/components/**/*.astro",
        "src/components/**/*.ts",
        "src/layouts/**/*.astro",
        "src/pages/**/*.astro",
        "src/pages/**/*.ts",
        "src/styles/**/*.css",
        "src/utils/**/*.ts",
        "src/i18n/**/*.json",
        "src/schemas/**/*.ts",
        "src/plugins/**/*.ts",
        "src/internal/**/*.ts",
        "src/scripts/**/*.ts",
        "public/background/**",
        "src/assets/**/*",
        ".release/cli.mjs",
        "!src/content.config.ts",
        "public/fonts/**",
        "LICENSES"
    ],
    "type": "module",
    "packageManager": "bun@1.4.4",
    "exports": {
        ".": "./src/index.ts",
        "./config": "./src/config.ts",
        "./expressive-code": "./src/expressive-code.ts",
        "./schemas": "./src/schemas/config.ts",
        "./schemas/collections": "./src/schemas/collections.ts",
        "./components/*": "./src/components/*",
        "./layouts/*": "./src/layouts/*",
        "./pages/*": "./src/pages/*",
        "./styles/*": "./src/styles/*",
        "./utils/*": "./src/utils/*",
        "./i18n/*": "./src/i18n/*",
        "./plugins/*": "./src/plugins/*",
        "./internal/*": "./src/internal/*",
        "./scripts/*": "./src/scripts/*",
        "./assets/*": "./src/assets/*",
        "./package.json": "./package.json"
    },
    "scripts": {
        "dev": "bun run styles:build && node scripts/dev.ts",
        "build": "bun run styles:build && astro build --timings && node scripts/verify-build.ts",
        "preview": "astro preview",
        "astro": "astro",
        "init": "node scripts/cli.ts init",
        "node:check": "tsc6 --project tsconfig.node.json",
        "build:cli": "bun build scripts/cli.ts --target=node --outfile .release/cli.mjs",
        "prepack": "bun run styles:build && bun run build:cli",
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "astro:check": "astro check --minimumFailingSeverity warning",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "knip": "knip",
        "verify:build": "node scripts/verify-build.ts",
        "validate": "bun run styles:build && bun run check && bun run node:check && bun run astro:check && bun run knip && bun run test:coverage && bun run build && bun run build:cli",
        "prepare": "sh -c 'if [ -d scripts/git-hooks ] && git rev-parse --git-dir >/dev/null 2>&1; then git config core.hooksPath scripts/git-hooks; fi'",
        "dev:debug": "STALUX_DEBUG=1 astro dev --verbose",
        "build:debug": "STALUX_DEBUG=1 astro build --timings --verbose && node scripts/verify-build.ts",
        "styles:build": "node scripts/build-styles.ts && node scripts/build-style-names.ts",
        "styles:watch": "node scripts/build-styles.ts --watch",
        "benchmark:performance": "node scripts/benchmark-performance.ts",
        "benchmark:builds": "python3 scripts/benchmark-builds.py",
        "analyze": "SONDA=1 bun run build",
        "backgrounds:build": "bun run scripts/build-backgrounds.ts"
    },
    "dependencies": {
        "@astrojs/compiler": "^4.0.0",
        "@astrojs/markdown-satteri": "^0.4.3",
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.4",
        "@expressive-code/plugin-line-numbers": "^0.44.2",
        "@lucide/astro": "^1.56.0",
        "@mcp-b/webmcp-polyfill": "^5.1.0",
        "@microsoft/clarity": "1.0.2",
        "@pagefind/component-ui": "^1.5.2",
        "@swup/a11y-plugin": "^5.2.1",
        "@swup/head-plugin": "^2.3.1",
        "@swup/js-plugin": "^3.2.0",
        "@swup/preload-plugin": "^3.2.12",
        "@swup/scroll-plugin": "^4.0.0",
        "@takumi-rs/core": "2.17.1",
        "@waline/client": "^3.16.1",
        "@xingwangzhe/cjk-font-split-native": "^0.4.10",
        "@xingwangzhe/satteri-mermaid": "^0.8.2",
        "@xingwangzhe/satteri-photoswipe": "^0.2.6",
        "@xingwangzhe/tags-cloud": "^1.2.9",
        "astro-expressive-code": "^0.44.2",
        "astro-seo": "^1.2.0",
        "badge-maker": "^6.0.0",
        "css-tree": "^3.2.1",
        "image-size": "^2.0.4",
        "magic-string": "^1.4.3",
        "pagefind": "^1.5.2",
        "parse5": "^8.0.1",
        "photoswipe": "^5.4.4",
        "satteri": "^0.10.5",
        "simple-icons": "^16.35.0",
        "swup": "4.10.0",
        "temml": "^0.14.0",
        "yaml": "^2.9.1"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@biomejs/biome": "^2.5.15",
        "@types/css-tree": "^3.2.0",
        "@types/node": "^26.6.5",
        "@unocss/astro": "^66.11.0",
        "@vitest/coverage-v8": "^5.0.4",
        "astro": "^7.4.4",
        "happy-dom": "^21.0.4",
        "knip": "^6.41.0",
        "sharp": "0.35.5",
        "sonda": "^0.14.0",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "unocss": "^66.11.0",
        "vite": "^8.3.5",
        "vitest": "^5.0.4"
    },
    "peerDependencies": {
        "astro": "^7.4.4"
    }
}
