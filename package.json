{
    "name": "@xingwangzhe/stalux",
    "version": "1.20.3",
    "description": "A powerful, modern Astro blog theme — use as template or install as plugin",
    "keywords": [
        "astro",
        "astro-integration",
        "astro-theme",
        "blog",
        "blog-theme",
        "stalux",
        "static-site"
    ],
    "homepage": "https://stalux.needhelp.icu",
    "bugs": "https://github.com/xingwangzhe/stalux/issues",
    "license": "MIT",
    "author": "xingwangzhe",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/xingwangzhe/stalux.git"
    },
    "bin": {
        "stalux": "scripts/cli.mjs"
    },
    "files": [
        "src/index.ts",
        "src/config.ts",
        "src/expressive-code.ts",
        "src/components/**/*.astro",
        "src/components/**/*.ts",
        "src/layouts/**/*.astro",
        "src/pages/**/*.astro",
        "src/pages/**/*.ts",
        "src/styles/**/*.css",
        "src/utils/**/*.ts",
        "src/i18n/**/*.json",
        "src/schemas/**/*.ts",
        "src/plugins/**/*.ts",
        "src/internal/**/*.ts",
        "src/scripts/**/*.ts",
        "public/background/**",
        "src/assets/**/*",
        "scripts/cli.mjs",
        "!src/content.config.ts"
    ],
    "type": "module",
    "exports": {
        ".": "./src/index.ts",
        "./config": "./src/config.ts",
        "./expressive-code": "./src/expressive-code.ts",
        "./schemas": "./src/schemas/config.ts",
        "./schemas/collections": "./src/schemas/collections.ts",
        "./components/*": "./src/components/*",
        "./layouts/*": "./src/layouts/*",
        "./pages/*": "./src/pages/*",
        "./styles/*": "./src/styles/*",
        "./utils/*": "./src/utils/*",
        "./i18n/*": "./src/i18n/*",
        "./plugins/*": "./src/plugins/*",
        "./internal/*": "./src/internal/*",
        "./scripts/*": "./src/scripts/*",
        "./assets/*": "./src/assets/*",
        "./package.json": "./package.json"
    },
    "scripts": {
        "dev": "astro dev ",
        "build": "astro build ",
        "preview": "astro preview ",
        "astro": "astro",
        "init": "node scripts/cli.mjs init",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "prepare": "git config core.hooksPath scripts/git-hooks"
    },
    "dependencies": {
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.3",
        "@expressive-code/plugin-line-numbers": "^0.44.1",
        "@lucide/astro": "^1.31.0",
        "@mcp-b/webmcp-polyfill": "^4.0.0",
        "@pagefind/component-ui": "^1.5.2",
        "@waline/client": "^3.15.2",
        "@xingwangzhe/satteri-mermaid": "0.7.3",
        "@xingwangzhe/satteri-photoswipe": "^0.2.2",
        "@xingwangzhe/tags-cloud": "^1.2.5",
        "animejs": "^4.5.0",
        "astro-expressive-code": "^0.44.1",
        "astro-seo": "^1.1.0",
        "astro-typewriter": "^1.2.0",
        "badge-maker": "^6.0.0",
        "js-yaml": "^5.2.3",
        "pagefind": "^1.5.2",
        "photoswipe": "^5.4.4",
        "satteri": "^0.9.5",
        "simple-icons": "^16.28.0",
        "subset-font": "^2.5.0",
        "temml": "^0.13.4"
    },
    "devDependencies": {
        "astro": "^7.2.0",
        "knip": "^6.32.0",
        "license-checker-rseidelsohn": "5.0.1",
        "oxfmt": "^0.62.0",
        "oxlint": "^1.77.0",
        "typescript": "^7.0.2"
    },
    "peerDependencies": {
        "astro": "7.2.0"
    }
}
