{
    "name": "stalux",
    "version": "1.1.0",
    "type": "module",
    "scripts": {
        "detect": "echo '---OS---' && cat /etc/os-release 2>/dev/null || echo 'No os-release' && echo '---ARCH---' && uname -m && uname -a && echo '---LIBC---' && ldd --version 2>/dev/null || echo 'No ldd' && echo '---NODE---' && node -p 'process.arch' && node -p 'process.platform' && node -p 'process.versions'",
        "dev": "astro dev ",
        "build": "astro build ",
        "preview": "astro preview ",
        "astro": "astro",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "license-checker": "bun license-checker.ts"
    },
    "dependencies": {
        "@astrojs/compiler-rs": "^0.1.5",
        "@astrojs/rss": "4.0.17",
        "@astrojs/sitemap": "3.7.1",
        "@expressive-code/plugin-line-numbers": "^0.41.7",
        "@waline/client": "^3.13.0",
        "animejs": "^4.3.6",
        "astro": "^6.0.6",
        "astro-expressive-code": "^0.41.7",
        "astro-pagefind": "^1.8.5",
        "astro-seo": "^1.1.0",
        "astro-typewriter": "^1.2.0",
        "badge-maker": "^5.0.2",
        "dayjs": "^1.11.20",
        "feather-icons": "^4.29.2",
        "katex": "^0.16.38",
        "lightningcss": "^1.32.0",
        "mermaid": "^11.13.0",
        "photoswipe": "^5.4.4",
        "reading-time": "^1.5.0",
        "rehype-katex": "^7.0.1",
        "remark-math": "^6.0.0",
        "simple-icons": "^16.12.0"
    },
    "devDependencies": {
        "@types/node": "^25.5.0",
        "license-checker-rseidelsohn": "^4.4.2",
        "oxfmt": "^0.41.0",
        "oxlint": "^1.56.0"
    }
}
