{
    "name": "@xingwangzhe/stalux",
    "version": "1.27.1",
    "description": "A powerful, modern Astro blog theme — use as template or install as plugin",
    "keywords": [
        "astro",
        "astro-integration",
        "astro-theme",
        "blog",
        "blog-theme",
        "stalux",
        "static-site"
    ],
    "homepage": "https://stalux.needhelp.icu",
    "bugs": "https://github.com/xingwangzhe/stalux/issues",
    "license": "MIT",
    "author": "xingwangzhe",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/xingwangzhe/stalux.git"
    },
    "engines": {
        "node": ">=26"
    },
    "bin": {
        "stalux": ".release/cli.mjs"
    },
    "files": [
        "src/index.ts",
        "src/config.ts",
        "src/expressive-code.ts",
        "src/components/**/*.astro",
        "src/components/**/*.ts",
        "src/layouts/**/*.astro",
        "src/pages/**/*.astro",
        "src/pages/**/*.ts",
        "src/styles/**/*.css",
        "src/utils/**/*.ts",
        "src/i18n/**/*.json",
        "src/schemas/**/*.ts",
        "src/plugins/**/*.ts",
        "src/internal/**/*.ts",
        "src/scripts/**/*.ts",
        "public/background/**",
        "src/assets/**/*",
        ".release/cli.mjs",
        "!src/content.config.ts"
    ],
    "type": "module",
    "packageManager": "bun@1.4.0",
    "exports": {
        ".": "./src/index.ts",
        "./config": "./src/config.ts",
        "./expressive-code": "./src/expressive-code.ts",
        "./schemas": "./src/schemas/config.ts",
        "./schemas/collections": "./src/schemas/collections.ts",
        "./components/*": "./src/components/*",
        "./layouts/*": "./src/layouts/*",
        "./pages/*": "./src/pages/*",
        "./styles/*": "./src/styles/*",
        "./utils/*": "./src/utils/*",
        "./i18n/*": "./src/i18n/*",
        "./plugins/*": "./src/plugins/*",
        "./internal/*": "./src/internal/*",
        "./scripts/*": "./src/scripts/*",
        "./assets/*": "./src/assets/*",
        "./package.json": "./package.json"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build && node scripts/verify-build.ts",
        "preview": "astro preview",
        "astro": "astro",
        "init": "node scripts/cli.ts init",
        "node:check": "tsc6 --project tsconfig.node.json",
        "build:cli": "bun build scripts/cli.ts --target=node --outfile .release/cli.mjs",
        "prepack": "bun run build:cli",
        "check": "biome check .",
        "check:fix": "biome check --write .",
        "format": "biome format --write .",
        "format:check": "biome format .",
        "lint": "biome lint .",
        "lint:fix": "biome lint --write .",
        "astro:check": "astro check --minimumFailingSeverity warning",
        "test": "vitest",
        "test:run": "vitest run",
        "test:coverage": "vitest run --coverage",
        "knip": "knip",
        "verify:build": "node scripts/verify-build.ts",
        "validate": "bun run check && bun run node:check && bun run astro:check && bun run knip && bun run test:coverage && bun run build && bun run build:cli",
        "prepare": "git config core.hooksPath scripts/git-hooks",
        "dev:debug": "STALUX_DEBUG=1 astro dev --verbose",
        "build:debug": "STALUX_DEBUG=1 astro build --verbose && node scripts/verify-build.ts"
    },
    "dependencies": {
        "@astrojs/markdown-satteri": "0.4.2",
        "@astrojs/rss": "^4.0.19",
        "@astrojs/sitemap": "^3.7.4",
        "@expressive-code/plugin-line-numbers": "^0.44.2",
        "@lucide/astro": "^1.47.0",
        "@mcp-b/webmcp-polyfill": "^5.1.0",
        "@pagefind/component-ui": "^1.5.2",
        "@waline/client": "^3.15.2",
        "@xingwangzhe/satteri-mermaid": "0.7.8",
        "@xingwangzhe/satteri-photoswipe": "^0.2.5",
        "@xingwangzhe/tags-cloud": "^1.2.8",
        "astro-expressive-code": "^0.44.2",
        "astro-seo": "^1.2.0",
        "astro-typewriter": "^1.2.0",
        "badge-maker": "^6.0.0",
        "pagefind": "^1.5.2",
        "photoswipe": "^5.4.4",
        "satteri": "^0.10.5",
        "simple-icons": "^16.32.0",
        "subset-font": "^2.9.0",
        "temml": "^0.13.5"
    },
    "devDependencies": {
        "@astrojs/check": "0.9.10",
        "@biomejs/biome": "2.5.14",
        "@types/node": "^26.6.2",
        "@vitest/coverage-v8": "5.0.1",
        "astro": "^7.3.4",
        "knip": "^6.37.0",
        "typescript": "npm:@typescript/typescript6@6.0.2",
        "vite": "8.3.0",
        "vitest": "5.0.1"
    },
    "peerDependencies": {
        "astro": "7.3.4"
    }
}
