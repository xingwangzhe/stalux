{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "vcs": {
        "enabled": true,
        "clientKind": "git",
        "useIgnoreFile": true
    },
    "files": {
        "includes": [
            "**",
            "!**/node_modules",
            "!**/dist",
            "!**/coverage",
            "!**/licenses",
            "!**/licenses.txt",
            "!**/.astro",
            "!public/background",
            "!src/internal/style-names.generated.ts"
        ]
    },
    "formatter": {
        "enabled": true,
        "formatWithErrors": false,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineEnding": "lf",
        "lineWidth": 100,
        "attributePosition": "auto",
        "bracketSpacing": true,
        "expand": "auto",
        "useEditorconfig": true
    },
    "linter": {
        "enabled": true,
        "rules": {
            "preset": "all",
            "complexity": {
                "noImportantStyles": "off",
                "useSimplifiedLogicExpression": "error",
                "noExcessiveCognitiveComplexity": "info",
                "noExcessiveLinesPerFunction": "info",
                "useMaxParams": "info",
                "noVoid": "off"
            },
            "correctness": {
                "useImportExtensions": "off",
                "noUndeclaredDependencies": "off",
                "noNodejsModules": "off",
                "useQwikValidLexicalScope": "off",
                "noUnresolvedImports": "off",
                "noProcessGlobal": "off"
            },
            "performance": {
                "useTopLevelRegex": "off",
                "noAwaitInLoops": "info",
                "noBarrelFile": "off",
                "noSyncScripts": "off",
                "noImgElement": "off"
            },
            "security": {
                "noSecrets": "off"
            },
            "style": {
                "noDescendingSpecificity": "off",
                "useConst": "error",
                "useBlockStatements": "off",
                "noMagicNumbers": "off",
                "noTernary": "off",
                "useNamingConvention": "off",
                "useFilenamingConvention": "off",
                "useExportsLast": "off",
                "noIncrementDecrement": "off",
                "noContinue": "off",
                "noImplicitBoolean": "off",
                "useNumericSeparators": "off",
                "useGlobalThis": "off",
                "noHexColors": "off",
                "noJsxLiterals": "off",
                "noDefaultExport": "off",
                "noParameterProperties": "off"
            },
            "suspicious": {
                "noVar": "error",
                "noUnknownAttribute": "off",
                "noConsole": "off",
                "noReactSpecificProps": "off",
                "noLeakedRender": "off",
                "noEmptySource": "off"
            }
        }
    },
    "assist": {
        "enabled": true,
        "actions": {
            "source": {
                "organizeImports": "on"
            }
        }
    },
    "javascript": {
        "globals": ["Fragment"],
        "formatter": {
            "quoteStyle": "double",
            "jsxQuoteStyle": "double",
            "quoteProperties": "asNeeded",
            "trailingCommas": "all",
            "semicolons": "always",
            "arrowParentheses": "always",
            "bracketSpacing": true,
            "bracketSameLine": false
        }
    },
    "overrides": [
        {
            "includes": ["**/*.astro"],
            "linter": {
                "rules": {
                    "correctness": {
                        "useUniqueElementIds": "off",
                        "noUndeclaredVariables": "off"
                    }
                }
            }
        },
        {
            "includes": ["tests/**"],
            "linter": {
                "rules": {
                    "suspicious": {
                        "noEmptyBlockStatements": "off",
                        "noMisplacedAssertion": "off",
                        "noShadow": "off",
                        "noUnnecessaryConditions": "off",
                        "useAwait": "off",
                        "useArraySortCompare": "off"
                    }
                }
            }
        }
    ],
    "html": {
        "experimentalFullSupportEnabled": true,
        "formatter": {
            "enabled": true,
            "indentStyle": "space",
            "indentWidth": 4,
            "lineWidth": 100
        }
    },
    "css": {
        "formatter": {
            "enabled": true
        },
        "linter": {
            "enabled": true
        },
        "parser": {
            "cssModules": true
        }
    }
}
