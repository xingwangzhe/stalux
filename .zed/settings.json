{
    "json_schemas": [
        {
            "file_match": ["stalux/posts/*.md"],
            "schema": ".zed/schemas/post-frontmatter.schema.json"
        }
    ],
    "lsp": {
        "oxlint": {
            "initialization_options": {}
        },
        "oxfmt": {
            "initialization_options": {}
        }
    },
    "languages": {
        "JavaScript": {
            "format_on_save": "on",
            "prettier": {
                "allowed": false
            },
            "formatter": [
                {
                    "language_server": {
                        "name": "oxfmt"
                    }
                }
            ]
        },
        "TypeScript": {
            "format_on_save": "on",
            "prettier": {
                "allowed": false
            },
            "formatter": [
                {
                    "language_server": {
                        "name": "oxfmt"
                    }
                }
            ]
        },
